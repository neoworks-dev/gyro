import { println } from "stdlib"
import { alloc, free, heap } from "mem"

struct Node {
    value: i32
    next: *Node?
}

fn main() {
    let head = alloc<Node>(heap())
    head.value = 1
    head.next = null

    let second = alloc<Node>(heap())
    second.value = 2
    second.next = null
    head.next = second

    let current: *Node? = head
    let total: i32 = 0
    while current != null {
        total += current.value
        let next = current.next
        free(heap(), current)
        current = next
    }
    println(total)

    let local: i32 = 5
    let address = &local
    println(*address)
    *address = 7
    println(local)
}
