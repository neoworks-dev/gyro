// A type is an error because it implements Error. A caller that needs the
// data matches on the concrete type; `?` passes an error on untouched.

import { println, Error } from "stdlib"
import { to_i32 } from "convert"
import { format, heap } from "mem"

struct RangeError {
    value: i32
}

impl Error for RangeError {
    fn message(self): string {
        return format(heap(), "value #{self.value} is out of range")
    }
}

fn parse_port(text: string): i32 | Error {
    let value = to_i32(text)?
    if value < 1 || value > 65535 {
        return RangeError{ value: value }
    }
    return value
}

fn describe(text: string) {
    match parse_port(text) {
        i32(port): println("ok: #{port}")
        Error(err): match err {
            RangeError(e): println("range: #{e.value}")
            _: println("bad: #{err.message()}")
        }
    }
}

fn main() {
    describe("8080")
    describe("70000")
    describe("nonsense")
}
