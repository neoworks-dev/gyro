// sleep parks only its own thread. While main sleeps the spawned
// producer keeps running, and while the producer sleeps main's receive
// just waits — neither side can deadlock the other.

import { println } from "stdlib"
import { heap, spawn } from "mem"
import { sleep } from "time"

fn main() {
    var done = chan<i32>(1)
    spawn(heap(), fn() {
        sleep(5)
        done <- 41
    })

    sleep(1)
    var value = <-done
    println(value + 1)
}
