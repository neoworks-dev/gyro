// env returns the variable's value, or null when it is unset. The
// harness pins GYRO_TEST_ENV=corpus for every tier.

import { println } from "stdlib"
import { env } from "os"

fn main() {
  var set = env("GYRO_TEST_ENV")
  if set != null {
    println(set)
  } else {
    println("unset")
  }

  var missing = env("GYRO_TEST_ENV_NEVER_SET")
  println(missing == null)
}
