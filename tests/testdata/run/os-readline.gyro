// readline takes standard input one line at a time. The terminator is
// not part of the line, an empty line is "" rather than the end, and end
// of file is null.
//
// The last two lines are read by read_stdin instead: both read the same
// stream, so what readline has not taken is what is left.
//gyro:stdin first
//gyro:stdin
//gyro:stdin two  words
//gyro:stdin fourth
//gyro:stdin fifth

import { println } from "stdlib"
import { readline, read_stdin } from "os"
import { heap } from "mem"

fn main() {
  var taken = 0
  while taken < 3 {
    var line = readline(heap())
    if line == null {
      break
    }
    taken += 1
    println("#{taken}: [#{line}]")
  }

  println("rest: [#{read_stdin(heap())}]")

  // The stream is drained now, so the next line is the end of it.
  println(readline(heap()) == null)
}
