// `xs[lo..hi]` is a window onto the storage xs already views: the same
// elements, seen through a shorter view. Nothing is copied and nothing
// is allocated, which is what makes it the answer for a C API shaped
// `(pointer, size)` — the shape every port of one has had to thread a
// `(base, beg, end)` triple through instead.
//
// Either end may be left off: `xs[lo..]` runs to the length and
// `xs[..hi]` starts at zero.

import { println } from "stdlib"
import { Array } from "stdlib"

fn total(xs: i32[]): i32 {
  var sum = 0
  var i: usize = 0
  while i < xs.len() {
    sum += xs[i]
    i += 1
  }
  return sum
}

// A recursive walk over a shrinking window, which is what a parser does
// with a cursor and what a pointer walk does in C.
fn count_zeros(xs: i32[]): i32 {
  if xs.len() == 0 {
    return 0
  }
  var here = 0
  if xs[0] == 0 {
    here = 1
  }
  return here + count_zeros(xs[1..])
}

fn main() {
  var xs = [10, 20, 30, 40, 50]

  // Both ends, half-open: 20 + 30 + 40.
  println(total(xs[1..4]))
  println(xs[1..4].len())

  // One end left off.
  println(total(xs[2..]))
  println(total(xs[..2]))

  // The whole length is in range, and an empty window is legal.
  println(total(xs[0..5]))
  println(xs[2..2].len())
  println(total(xs[5..]))

  // A window of a window: the bounds are the window's, not the
  // original's, so this is elements 2 and 3 of the array.
  var middle = xs[1..4]
  println(total(middle[1..3]))

  // It borrows. A write through the window is what the array holds.
  middle[0] = 7
  println(xs[1])

  // And a write to the array is what the window reads back.
  xs[2] = 90
  println(middle[1])

  // An Array<T> narrows through the view it already hands out, so the
  // window borrows its buffer rather than copying it: a write through
  // the window is what the array holds.
  var grown = Array<i32>::new()
  defer grown.free()
  grown.push(1)
  grown.push(2)
  grown.push(3)
  grown.push(4)
  println(total(grown.slice()[1..3]))
  println(total(grown[1..3]))
  println(total(grown[2..]))

  var owned = grown[0..2]
  owned[0] = 100
  println(grown[0])

  // Bounds are ordinary values, computed where they are written.
  var at: usize = 1
  println(total(xs[at..at + 2]))

  println(count_zeros([0, 1, 0, 0, 2]))
}
