// Closures capture by copy, and the copy is the closure's own: mutations
// accumulate across calls and the original never notices.

import { println } from "stdlib"

fn apply(v: i32, f: fn(i32): i32): i32 {
    return f(v)
}

fn main() {
    println(apply(21, fn(x) x * 2))
    let add = fn(a: i32, b: i32): i32 { return a + b }
    println(add(2, 3))

    let count = 1
    let show = fn() { println(count) }
    count = 99
    show()
    println(count)

    let total: i32 = 0
    let bump = fn(): i32 {
        total += 1
        return total
    }
    println(bump())
    println(bump())
    println(total)
}
