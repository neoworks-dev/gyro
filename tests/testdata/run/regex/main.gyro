// tiny-regex-c's tests/test1.c, run against the Gyro port.
//
// The C driver prints only what failed, which says nothing about the
// cases that passed. This one prints the match offset and length for
// every case, so the output is comparable line by line against the C
// original (see reference.c, the same table with the same print loop).

import { println, Array } from "stdlib"
import { match_text } from "./regex"
import { heap } from "mem"

// (should match, pattern, text, expected match length)
fn vectors(): Array<(bool, string, string, i64)> {
  var cases = Array<(bool, string, string, i64)>::new(heap())
  cases.push((true,  "\\d", "5", 1))
  cases.push((true,  "\\w+", "hej", 3))
  cases.push((true,  "\\s", "\t \n", 1))
  cases.push((false, "\\S", "\t \n", 0))
  cases.push((true,  "[\\s]", "\t \n", 1))
  cases.push((false, "[\\S]", "\t \n", 0))
  cases.push((false, "\\D", "5", 0))
  cases.push((false, "\\W+", "hej", 0))
  cases.push((true,  "[0-9]+", "12345", 5))
  cases.push((true,  "\\D", "hej", 1))
  cases.push((false, "\\d", "hej", 0))
  cases.push((true,  "[^\\w]", "\\", 1))
  cases.push((true,  "[\\W]", "\\", 1))
  cases.push((false, "[\\w]", "\\", 0))
  cases.push((true,  "[^\\d]", "d", 1))
  cases.push((false, "[\\d]", "d", 0))
  cases.push((false, "[^\\D]", "d", 0))
  cases.push((true,  "[\\D]", "d", 1))
  cases.push((true,  "^.*\\\\.*$", "c:\\Tools", 8))
  cases.push((true,  "^.*\\\\.*$", "c:\\Tools", 8))
  cases.push((true,  ".?\\w+jsj$", "%JxLLcVx8wxrjsj", 15))
  cases.push((true,  ".?\\w+jsj$", "=KbvUQjsj", 9))
  cases.push((true,  ".?\\w+jsj$", "^uDnoZjsj", 9))
  cases.push((true,  ".?\\w+jsj$", "UzZbjsj", 7))
  cases.push((true,  ".?\\w+jsj$", "\"wjsj", 5))
  cases.push((true,  ".?\\w+jsj$", "zLa_FTEjsj", 10))
  cases.push((true,  ".?\\w+jsj$", "\"mw3p8_Ojsj", 11))
  cases.push((true,  "^[\\+-]*[\\d]+$", "+27", 3))
  cases.push((true,  "[abc]", "1c2", 1))
  cases.push((false, "[abc]", "1C2", 0))
  cases.push((true,  "[1-5]+", "0123456789", 5))
  cases.push((true,  "[.2]", "1C2", 1))
  cases.push((true,  "a*$", "Xaa", 2))
  cases.push((true,  "a*$", "Xaa", 2))
  cases.push((true,  "[a-h]+", "abcdefghxxx", 8))
  cases.push((false, "[a-h]+", "ABCDEFGH", 0))
  cases.push((true,  "[A-H]+", "ABCDEFGH", 8))
  cases.push((false, "[A-H]+", "abcdefgh", 0))
  cases.push((true,  "[^\\s]+", "abc def", 3))
  cases.push((true,  "[^fc]+", "abc def", 2))
  cases.push((true,  "[^d\\sf]+", "abc def", 3))
  cases.push((true,  "\n", "abc\ndef", 1))
  cases.push((true,  "b.\\s*\n", "aa\r\nbb\r\ncc\r\n\r\n", 4))
  cases.push((true,  ".*c", "abcabc", 6))
  cases.push((true,  ".+c", "abcabc", 6))
  cases.push((true,  "[b-z].*", "ab", 1))
  cases.push((true,  "b[k-z]*", "ab", 1))
  cases.push((false, "[0-9]", "  - ", 0))
  cases.push((true,  "[^0-9]", "  - ", 1))
  cases.push((true,  "0|", "0|", 2))
  cases.push((false, "\\d\\d:\\d\\d:\\d\\d", "0s:00:00", 0))
  cases.push((false, "\\d\\d:\\d\\d:\\d\\d", "000:00", 0))
  cases.push((false, "\\d\\d:\\d\\d:\\d\\d", "00:0000", 0))
  cases.push((false, "\\d\\d:\\d\\d:\\d\\d", "100:0:00", 0))
  cases.push((false, "\\d\\d:\\d\\d:\\d\\d", "00:100:00", 0))
  cases.push((false, "\\d\\d:\\d\\d:\\d\\d", "0:00:100", 0))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "0:0:0", 5))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "0:00:0", 6))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "0:0:00", 5))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "00:0:0", 6))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "00:00:0", 7))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "00:0:00", 6))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "0:00:00", 6))
  cases.push((true,  "\\d\\d?:\\d\\d?:\\d\\d?", "00:00:00", 7))
  cases.push((true,  "[Hh]ello [Ww]orld\\s*[!]?", "Hello world !", 12))
  cases.push((true,  "[Hh]ello [Ww]orld\\s*[!]?", "hello world !", 12))
  cases.push((true,  "[Hh]ello [Ww]orld\\s*[!]?", "Hello World !", 12))
  cases.push((true,  "[Hh]ello [Ww]orld\\s*[!]?", "Hello world!   ", 11))
  cases.push((true,  "[Hh]ello [Ww]orld\\s*[!]?", "Hello world  !", 13))
  cases.push((true,  "[Hh]ello [Ww]orld\\s*[!]?", "hello World    !", 15))
  cases.push((false, "\\d\\d?:\\d\\d?:\\d\\d?", "a:0", 0))
  cases.push((true,  ".?bar", "real_bar", 4))
  cases.push((false, ".?bar", "real_foo", 0))
  cases.push((false, "X?Y", "Z", 0))
  cases.push((true,  "[a-z]+\nbreak", "blahblah\nbreak", 14))
  cases.push((true,  "[a-z\\s]+\nbreak", "bla bla \nbreak", 14))
  return cases
}

fn main() {
  var cases = vectors()
  defer cases.free()

  var failed: usize = 0
  for var i: usize = 0; i < cases.len(); i += 1 {
    var expect_match, pattern, text, expect_length = cases.get(i)
    var at, length = match_text(pattern, text)
    println("#{i} #{at} #{length}")

    var ok = true
    if expect_match {
      if at < 0 || length != expect_length {
        ok = false
      }
    } elif at >= 0 {
      ok = false
    }
    if !ok {
      println("case #{i} disagrees: matched #{at} length #{length}")
      failed += 1
    }
  }

  println("#{cases.len() - failed} of #{cases.len()} cases behave as the C tests expect")
}
