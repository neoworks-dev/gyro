// A Gyro program deciding what a C library does.
//
// `code(A, B): C` is the address of a function and nothing beside it,
// which is what C's function pointer is and what a Gyro `fn` is not: a
// `fn` is two words because it may have captured something, and a C
// signature has nowhere to put the second one. `&f` on a declared
// function is the one word.
//
// The direction that matters more is not the one that looks harder. C
// calling into Gyro is the loop the library owns running the decision
// the caller made, which is what a callback is for; Gyro calling a
// pointer C handed back is the same address read the other way.

import { println } from "stdlib"
import safe {
  Rule, count_kept, fold, fold_or, rule_size, apply_rule, adder,
  round_trip,
} from "./filter.c"

fn big(v: i32): i32 {
  if v > 5 { return 1 }
  return 0
}

fn small(v: i32): i32 {
  return 1 - big(v)
}

fn sum(acc: i32, v: i32): i32 {
  return acc + v
}

fn largest(acc: i32, v: i32): i32 {
  if v > acc { return v }
  return acc
}

fn main() {
  // The library's loop, this program's decision.
  println(count_kept(&big))
  println(count_kept(&small))

  println(fold(&sum, 0))
  println(fold(&largest, 0))

  // A callback that is absent, which is a check and not a jump to
  // address zero.
  println(fold_or(&sum, 100, -1))
  println(fold_or(null, 100, -1))

  // A struct holding one is the struct C lays out: a padded int beside
  // a single word.
  println(rule_size())
  println(apply_rule(Rule{ code: 7, keep: &big }, 9))
  println(apply_rule(Rule{ code: 7, keep: &big }, 2))

  // One of the library's own, called from here.
  var add = adder()
  if add == null {
    println("no adder")
    return
  }
  println(add(20, 22))

  // And handed straight back, which is the same address a third time.
  println(round_trip(add))

  // Two names for one function are one address; two functions are two.
  println(&sum == &sum)
  println(&sum == &largest)

  // What is at the far end is instructions, so what it prints is the
  // word.
  println(&sum)
}
