// spawn takes an allocator because the thread outlives the function that
// started it: the closure's environment is kept in the allocator, and the
// thread gives it back when the closure returns. Two blocks come from it
// (the closure's record and the thread's job) and both go back.

import { println } from "stdlib"
import { Allocator, Mode, heap, spawn } from "mem"
import { sleep } from "time"

struct Counter {
  allocs: i32
  frees: i32
}

fn counting(data: anyptr?, mode: Mode, size: usize, align: usize,
            old: anyptr?, old_size: usize): anyptr? {
  if data == null {
    return null
  }
  var counter = data as *Counter
  if mode == Mode::Alloc {
    counter.allocs += 1
  }
  if mode == Mode::Free {
    counter.frees += 1
  }
  var h = heap()
  return h.proc(h.data, mode, size, align, old, old_size)
}

fn start(a: Allocator, done: chan<i32>, base: i32) {
  spawn(a, fn() {
    done <- base + 2
  })
}

fn main() {
  var counter = Counter{ allocs: 0, frees: 0 }
  var counted = Allocator{ proc: &counting, data: &counter as anyptr }
  var done = chan<i32>(1)

  // start has returned, so the frame the closure was written in is gone
  // and the thread is running from the copy.
  start(counted, done, 40)
  println(counter.allocs)
  println(<-done)

  // The thread releases after it has sent; give it a moment.
  sleep(100)
  println(counter.frees)
}
