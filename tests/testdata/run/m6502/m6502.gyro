// A port of Fake6502 — Mike Chambers' MOS 6502 emulation core, in the
// public-domain revision by David MHS Webster
// (github.com/patricksurry/mylittle6502, `fake6502.h`), with the
// undocumented opcodes compiled in.
//
// Three fixes were made to the C before it was ported, because the
// SingleStepTests suite the port is checked against says the hardware
// disagrees with it:
//
//   * `PLP` and `RTI` pull the status register off the stack. Bit 5 does
//     not exist in the register and reads as set, and bit 4 is not a bit
//     at all — it only exists in the byte a push writes. Upstream keeps
//     whatever was pushed, so a pulled break flag survives into the
//     register.
//   * `ADC` in decimal mode took the overflow flag from the decimal
//     result (`A & 0xff80`). On an NMOS 6502 V comes from the binary sum,
//     the same one the zero flag is already taken from here.
//
// What the port changes, and why:
//
//   * C dispatches through `addrtable[256]` and `optable[256]`, two
//     arrays of function pointers, and `getvalue` asks whether
//     `addrtable[opcode] == acc` — pointer identity standing in for a
//     name. Here the tables hold `Mode` and `Op` values and the two
//     dispatchers are a `match`, so the accumulator test compares the
//     mode to `Mode::Acc` and the exhaustiveness check covers the arms.
//   * The registers are a `Cpu` value rather than file-scope globals, and
//     the 64K the host is expected to supply through `read6502` and
//     `write6502` is a field of it. A test harness needs to know which
//     addresses an instruction wrote, so the writes are recorded in
//     `touched` as they happen — 64 of them, the fixed array C's driver
//     keeps for the same reason.
//   * Every `+` in C that relies on `ushort` or `uint8` wrapping is `+%`
//     or `-%` here: `pc++` at 0xFFFF, `sp -= 2` under the stack, `ea +=
//     y` across a page, `result = value - 1` in DEC, and the decimal
//     adjustments that borrow through 0.
//   * C's `status |= FLAG_CONSTANT` and friends are macros over the
//     global; here they are `set_flag(flag, on)`, one function taking the
//     condition, because that is what every use of them was spelling out
//     with an `if` and an `else`.

import { Array, Eq } from "stdlib"
import { heap } from "mem"

// ---------------------------------------------------------------------------
// The status register
// ---------------------------------------------------------------------------

export const FLAG_CARRY: u8 = 0x01
export const FLAG_ZERO: u8 = 0x02
export const FLAG_INTERRUPT: u8 = 0x04
export const FLAG_DECIMAL: u8 = 0x08
export const FLAG_BREAK: u8 = 0x10
export const FLAG_CONSTANT: u8 = 0x20
export const FLAG_OVERFLOW: u8 = 0x40
export const FLAG_SIGN: u8 = 0x80

// The stack lives in page one, addressed by the 8-bit stack pointer.
const BASE_STACK: u16 = 0x100

// How many written addresses a step remembers. A 6502 instruction writes
// at most three bytes, so this is only ever a bound.
const TOUCHED_LIMIT: usize = 64

// ---------------------------------------------------------------------------
// Addressing modes and instructions
// ---------------------------------------------------------------------------

export enum Mode {
  Imp,
  Acc,
  Imm,
  Zp,
  Zpx,
  Zpy,
  Rel,
  Abso,
  Absx,
  Absy,
  Ind,
  Indx,
  Indy,
}

impl Eq for Mode

export enum Op {
  Adc,
  And,
  Asl,
  Bcc,
  Bcs,
  Beq,
  Bit,
  Bmi,
  Bne,
  Bpl,
  Brk,
  Bvc,
  Bvs,
  Clc,
  Cld,
  Cli,
  Clv,
  Cmp,
  Cpx,
  Cpy,
  Dec,
  Dex,
  Dey,
  Eor,
  Inc,
  Inx,
  Iny,
  Jmp,
  Jsr,
  Lda,
  Ldx,
  Ldy,
  Lsr,
  Nop,
  Ora,
  Pha,
  Php,
  Pla,
  Plp,
  Rol,
  Ror,
  Rti,
  Rts,
  Sbc,
  Sec,
  Sed,
  Sei,
  Sta,
  Stx,
  Sty,
  Tax,
  Tay,
  Tsx,
  Txa,
  Txs,
  Tya,
  // The undocumented opcodes that behave predictably: each one is a
  // documented pair run back to back.
  Dcp,
  Isb,
  Lax,
  Rla,
  Rra,
  Sax,
  Slo,
  Sre,
}

