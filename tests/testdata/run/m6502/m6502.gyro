// The base cycle count of each opcode, before the penalties a page
// crossing or a taken branch adds.
const TICKS: u32[256] = [
  7, 6, 2, 8, 3, 3, 5, 5, 3, 2, 2, 2, 4, 4, 6, 6,
  2, 5, 2, 8, 4, 4, 6, 6, 2, 4, 2, 7, 4, 4, 7, 7,
