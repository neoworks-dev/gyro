import { println } from "stdlib"

struct Pair<T> {
  first: T
  second: T
}

fn Pair<T>::sum(self): T {
  return self.first
}

// The row is vacuous at T=i32 and load-bearing at T=string, which is a
// view; a generic signature states it once for every instantiation.
fn pick<T>(a: T, b: T, takeFirst: bool): T !{ &a, &b } {
  if takeFirst {
    return a
  }
  return b
}

fn main() {
  println(pick(1, 2, true))
  println(pick(1.5, 2.5, false))
  println(pick("yes", "no", false))

  var ints = Pair<i32>{ 3, 4 }
  var floats = Pair<f64>{ 1.25, 2.5 }
  println(ints.sum())
  println(floats.sum())
}
