// `for..in` accepts anything with next(*self): (T, bool), or an iter()
// that produces something that has it. Nothing is declared.

import { println } from "stdlib"

struct Counter {
  n: i32
  limit: i32
}

fn Counter::next(*self): (i32, bool) {
  if self.n >= self.limit {
    return 0, false
  }
  self.n += 1
  return self.n, true
}

struct Bag {
  size: i32
}

fn Bag::iter(self): Counter {
  return Counter{ n: 0, limit: self.size }
}

fn main() {
  for x in (Counter{ n: 0, limit: 3 }) {
    println(x)
  }
  var total: i32 = 0
  for x in (Bag{ size: 4 }) {
    total += x
  }
  println(total)
}
