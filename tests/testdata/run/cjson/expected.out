  {\x0a    "glossary": {\x0a        "title": "example glossary",\x0a\x09\x09"GlossDiv": {\x0a            "title": "S",\x0a\x09\x09\x09"GlossList": {\x0a                "GlossEntry": {\x0a                    "ID": "SGML",\x0a\x09\x09\x09\x09\x09"SortAs": "SGML",\x0a\x09\x09\x09\x09\x09"GlossTerm": "Standard Generalized Markup Language",\x0a\x09\x09\x09\x09\x09"Acronym": "SGML",\x0a\x09\x09\x09\x09\x09"Abbrev": "ISO 8879:1986",\x0a\x09\x09\x09\x09\x09"GlossDef": {\x0a                        "para": "A meta-markup language, used to create markup languages such as DocBook.",\x0a\x09\x09\x09\x09\x09\x09"GlossSeeAlso": ["GML", "XML"]\x0a                    },\x0a\x09\x09\x09\x09\x09"GlossSee": "markup"\x0a                }\x0a            }\x0a        }\x0a    }\x0a}\x0a -> {"glossary":{"title":"example glossary","GlossDiv":{"title":"S","GlossList":{"GlossEntry":{"ID":"SGML","SortAs":"SGML","GlossTerm":"Standard Generalized Markup Language","Acronym":"SGML","Abbrev":"ISO 8879:1986","GlossDef":{"para":"A meta-markup language, used to create markup languages such as DocBook.","GlossSeeAlso":["GML","XML"]},"GlossSee":"markup"}}}}}
