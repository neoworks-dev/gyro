== detach, replace, insert
  start                  [0,1,2,3,4]
  detach index 2 -> number(2, int=2) [0,1,3,4]
  detach index 0 -> number(0, int=0) [1,3,4]
  detach the end -> number(4, int=4) [1,3]
  detach out of range -> none
  insert at 0: yes          ["first",1,3]
  insert at 2: yes          ["first",1,"middle",3]
  insert past the end: yes   ["first",1,"middle",3,"last"]
  replace index 0: yes      [100,1,"middle",3,"last"]
  replace the end: yes      [100,1,"middle",3,400]
  replace out of range: no    [100,1,"middle",3,400]
  delete index 1         [100,"middle",3,400]
  object                 {"a":1,"b":2,"c":3}
  replace "b": yes        {"a":1,"b":"two","c":3}
  delete "a"             {"b":"two","c":3}
  detach "c" -> number(3, int=3) {"b":"two"}
  one element            {"rd":[{"a":"123"}]}
  two elements           {"rd":[{"a":"123"},{"b":"456"}]}
  first one deleted      {"rd":[{"b":"456"}]}
