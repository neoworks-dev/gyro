import { println, eprintln, Error } from "stdlib"
import { format, heap } from "mem"

struct TooBig {
    limit: i32
}

impl Error for TooBig {
    fn message(self): string {
        return format(heap(), "value above #{self.limit}")
    }
}

fn check(v: i32): i32 | Error {
    if v > 10 {
        return TooBig{ limit: 10 }
    }
    return v
}

// An Error? holds an error or nothing, so it is checked like any nullable.
fn verify(v: i32): Error? {
    if v > 10 {
        return TooBig{ limit: 10 }
    }
}

fn main() {
    match check(7) {
        i32(n): println(n)
        Error(e): println(e.message())
    }
    println(verify(7) == null)

    let bad = verify(99)
    if bad != null {
        println(bad.message())
        match bad {
            TooBig(e): println(e.limit)
            _: eprintln("unexpected")
        }
    }
}
