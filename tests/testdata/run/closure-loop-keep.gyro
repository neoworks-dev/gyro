// A closure written in a loop body keeps its captures in one record in the
// frame, so pushing it as it is would give every element that record, and
// the borrow analysis refuses it. keep copies the record out into an
// allocator, one per element, and each closure then sees its own i.

import { println, Array } from "stdlib"
import { heap, keep, release, Allocator } from "mem"

fn build(a: Allocator): Array<fn(): i32> {
  var fns = Array<fn(): i32>::new(a)
  for i in 0..3 {
    fns.push(keep(a, fn(): i32 { return i }))
  }
  return fns
}

fn main() {
  var a = heap()
  var fns = build(a)
  println(fns.get(0)())
  println(fns.get(1)())
  println(fns.get(2)())
  for i in 0..fns.len() {
    release(a, fns.get(i))
  }
  fns.free()
}
