// jsmn's test/tests.c, run against the Gyro port, for the default build
// (no JSMN_STRICT, no JSMN_PARENT_LINKS) — the one `make test_default`
// exercises.
//
// The C driver prints two numbers, PASSED and FAILED, which say nothing
// about which case broke. This one prints the parse result and the whole
// token table for every case, so the output is comparable line by line
// against the C original (see ../c-ports/jsmn/gyro/reference.c, the same
// table with the same print loop).
//
// The cases that only exist under JSMN_STRICT are left out, since the
// port is of the default build. Everything else from tests.c is here:
// the token tables, the count-only mode, the prefix sweep of
// test_partial_string, the small-pool sweep of test_array_nomem, and
// test_input_length's parse of a prefix with garbage after it.

import { println, Array, String, from_utf8 } from "stdlib"
import { printf } from "fmt"
import * as jsmn from "./jsmn"

const POOL: i64 = 128

fn kind_name(kind: jsmn::Kind): string {
  return match kind {
    jsmn::Kind::Undefined: "undefined"
    jsmn::Kind::Object: "object"
    jsmn::Kind::Array: "array"
    jsmn::Kind::String: "string"
    jsmn::Kind::Primitive: "primitive"
  }
}

// visible renders the input on one line, so a case with a newline in it
// does not break the table.
fn visible(text: string): string {
  var out = String::new()
  for byte in text.bytes() {
    if byte == '\n' as u8 {
      out.push("\\n")
    } elif byte == '\t' as u8 {
      out.push("\\t")
    } elif byte == '\r' as u8 {
      out.push("\\r")
    } else {
      out.push_rune(byte as rune)
    }
  }
  return out.to_string()
}

// span is the text a token covers, which is what the C test compares
// against for strings and primitives.
fn span(js: u8[], token: jsmn::Token): string {
  var bytes = Array<u8>::new()
  var i = token.start
  while i < token.end && i < js.len() as i64 {
    if i >= 0 {
      bytes.push(js[i as usize])
    }
    i += 1
  }
  var text = from_utf8(bytes.slice())
  bytes.free()
  return text
}

fn show(js: u8[], tokens: Array<jsmn::Token>, count: i64) {
  for var i: i64 = 0; i < count; i += 1 {
    var token = tokens.get(i as usize)
    printf("    %-9s start=%3d end=%3d size=%d  %s\n",
      kind_name(token.kind), token.start, token.end, token.size,
      visible(span(js, token)))
  }
}

fn parse(label: string) {
  var js = label.bytes()
  var tokens = Array<jsmn::Token>::new()
  var parser = jsmn::init()
  var result = parser.parse(js, tokens, POOL, false)
  printf("%-46s -> %d\n", visible(label), result)
  if result >= 0 {
    show(js, tokens, result)
  }
  tokens.free()
}

fn count(label: string) {
  var js = label.bytes()
  var tokens = Array<jsmn::Token>::new()
  var parser = jsmn::init()
  var result = parser.parse(js, tokens, 0, true)
  printf("%-46s -> %d\n", visible(label), result)
  tokens.free()
}

fn prefix(text: string, length: i64): u8[] {
  var bytes = Array<u8>::new()
  var all = text.bytes()
  var i: i64 = 0
  while i < length && i < all.len() as i64 {
    bytes.push(all[i as usize])
    i += 1
  }
  return bytes.slice()
}

fn main() {
  println("-- empty")
  parse("{}")
  parse("[]")
  parse("[{},{}]")

  println("-- object")
  parse("{\"a\":0}")
  parse("{\"a\":[]}")
  parse("{\"a\":{},\"b\":{}}")
  parse("{\n \"Day\": 26,\n \"Month\": 9,\n \"Year\": 12\n }")
  parse("{\"a\": 0, \"b\": \"c\"}")

  println("-- array")
  parse("[10]")
  parse("{\"a\": 1]")

  println("-- primitive")
  parse("{\"boolVar\" : true }")
  parse("{\"boolVar\" : false }")
  parse("{\"nullVar\" : null }")
  parse("{\"intVar\" : 12}")
  parse("{\"floatVar\" : 12.345}")

  println("-- string")
  parse("{\"strVar\" : \"hello world\"}")
  parse("{\"strVar\" : \"escapes: \\/\\r\\n\\t\\b\\f\\\"\\\\\"}")
  parse("{\"strVar\": \"\"}")
  parse("{\"a\":\"\\uAbcD\"}")
  parse("{\"a\":\"str\\u0000\"}")
  parse("{\"a\":\"\\uFFFFstr\"}")
  parse("{\"a\":[\"\\u0280\"]}")
  parse("{\"a\":\"str\\uFFGFstr\"}")
  parse("{\"a\":\"str\\u@FfF\"}")
  parse("{{\"a\":[\"\\u028\"]}")

  println("-- partial string")
  var partial = "{\"x\": \"va\\\\ue\", \"y\": \"value y\"}"
  var total = partial.bytes().len() as i64
  for var i: i64 = 1; i <= total; i += 1 {
    var tokens = Array<jsmn::Token>::new()
    var parser = jsmn::init()
    var result = parser.parse(prefix(partial, i), tokens, 5, false)
    printf("  length %2d -> %d\n", i, result)
    if result >= 0 {
      show(partial.bytes(), tokens, result)
    }
    tokens.free()
  }

  println("-- small pools")
  var nomem = "  [ 1, true, [123, \"hello\"]]"
  for var pool: i64 = 0; pool < 6; pool += 1 {
    var tokens = Array<jsmn::Token>::new()
    var parser = jsmn::init()
    var result = parser.parse(nomem.bytes(), tokens, pool, false)
    printf("  pool %d -> %d\n", pool, result)
    tokens.free()
  }
  parse(nomem)

  println("-- unquoted keys")
  parse("key1: \"value\"\nkey2 : 123")

  println("-- input length")
  var truncated = "{\"a\": 0}garbage"
  var tokens = Array<jsmn::Token>::new()
  var parser = jsmn::init()
  var result = parser.parse(prefix(truncated, 8), tokens, 10, false)
  printf("  first 8 bytes -> %d\n", result)
  show(prefix(truncated, 8), tokens, result)
  tokens.free()

  println("-- issue 27")
  parse("{ \"name\" : \"Jack\", \"age\" : 27 } { \"name\" : \"Anna\", ")

  println("-- count only")
  count("{}")
  count("[]")
  count("[[]]")
  count("[[], []]")
  count("[[], [[]], [[], []]]")
  count("[\"a\", [[], []]]")
  count("[[], \"[], [[]]\", [[]]]")
  count("[1, 2, 3]")
  count("[1, 2, [3, \"a\"], null]")

  println("-- non-strict")
  parse("a: 0garbage")
  parse("Day : 26\nMonth : Sep\n\nYear: 12")
  parse("\"key {1\": 1234")

  println("-- unmatched brackets")
  parse("\"key 1\": 1234}")
  parse("{\"key 1\": 1234")
  parse("{\"key 1\": 1234}}")
  parse("\"key 1\"}: 1234")
  parse("{\"key {1\": 1234}")
  parse("{\"key 1\":{\"key 2\": 1234}")

  println("-- object key")
  parse("{\"key\": 1}")
}
