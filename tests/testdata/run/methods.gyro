// An `inout self` receiver changes the value the method was called on; a
// plain `self` only reads it.

import { println } from "stdlib"

struct Counter {
    n: i32
}

fn Counter::bump(inout self) {
    self.n += 1
}

fn Counter::peek(self): i32 {
    return self.n
}

fn Counter::at(n: i32): Counter {
    return Counter{ n: n }
}

fn main() {
    let c = Counter{ n: 0 }
    c.bump()
    c.bump()
    println(c.peek())

    println(Counter::at(5).peek())
}
