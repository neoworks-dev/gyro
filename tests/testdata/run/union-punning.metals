; Reading a union member that shares no initial sequence with the one
; that was written. C leaves this undefined, and the three tiers do
; three things about it — which is why this case is here and why it runs
; on one of them.
;
; The natives have C's own union under them, so they read whatever the
; bytes were: an i64 -1 read as an f64 is a quiet NaN, and no tier can
; call that wrong because C does not say what it should be. The
; evaluator has no bytes to reinterpret; what it has is the member that
; was written, and it says so.
;
; That is the same asymmetry `ptr.cast` already has. The tiers agree on
; every defined program, and the evaluator is the tier that can see an
; undefined one — running this here would take a byte-addressable object
; model, and having it disagree quietly is the one thing three tiers
; exist to prevent.

;gyro:panic only a common initial sequence reads across
;gyro:skip native C's own union reinterprets the bytes, which is what C leaves undefined
;gyro:skip cnative C's own union reinterprets the bytes, which is what C leaves undefined

module "metals:union-punning"

import "gyro:rt" {
  fn @"println<f64>"(f64)
}

type %Bits = union { whole: i64, real: f64 }

export fn @main() {
  %b = slot %Bits
  %wp = field.ptr %b, 0
  %all = const.i64 -1
  store %wp, %all

  %rp = field.ptr %b, 1
  %r = load %rp
  call @"println<f64>"(%r)
  return
}
