//gyro:panic allocation of 16 bytes failed
// An arena does not grow: a request past its capacity answers null, and
// alloc<T>() panics with the size rather than hand back a pointer that
// is not one.

import { println } from "stdlib"
import { alloc, heap, Arena } from "mem"

struct Node {
    value: i32
    next: *Node?
}

fn main() {
    var arena = Arena::new(heap(), 40)
    defer arena.free()

    var a = alloc<Node>(arena.allocator())
    var b = alloc<Node>(arena.allocator())
    a.value = 1
    b.value = 2
    println(a.value + b.value)
    var c = alloc<Node>(arena.allocator())
    println(c.value)
}
