// The text helpers extend the built-in `string`, so they are spelled as
// methods. They are ordinary names all the same: importable, and an
// error to call without a receiver.

import { println, Array, join, from_utf8, bytes, runes } from "stdlib"
import { split, trim, contains, starts_with, ends_with } from "stdlib"
import { index_of, substring, repeat } from "stdlib"
import { heap } from "mem"

fn main() {
  println("[#{"  padded\t\n".trim(heap())}]")
  println("[#{"".trim(heap())}]")
  println("hello".starts_with("he"))
  println("he".starts_with("hello"))
  println("hello".ends_with("lo"))
  println("hello".contains("ell"))
  println("hello".contains("xyz"))
  println("hello".substring(heap(), 1, 4))
  println("ab".repeat(heap(), 3))
  println("[#{"ab".repeat(heap(), 0)}]")

  var at = "hello".index_of("ll")
  if at != null {
    println(at)
  }
  println("hello".index_of("zz") == null)

  // An empty field between two separators is a field.
  var parts = "a,b,,c".split(heap(), ",")
  defer parts.free()
  println(parts.len())
  for part in parts.slice() {
    println("[#{part}]")
  }
  println(join(heap(), parts.slice(), "-"))

  // A separator that does not occur leaves one field.
  var whole = "abc".split(heap(), ",")
  defer whole.free()
  println(whole.len())

  // Extensions chain like any other method.
  var fields = "  a, b ,c  ".trim(heap()).split(heap(), ",")
  defer fields.free()
  println(fields.len())
  println(fields.get(0).trim(heap()))

  // Bytes round-trip through a slice.
  println(from_utf8(heap(), "héllo".bytes(heap())))
  println("héllo".bytes(heap()).len())
  println("héllo".runes(heap()).len())
}
