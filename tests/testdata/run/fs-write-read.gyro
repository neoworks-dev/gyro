// The fs one-shots round-trip through a real file: write_file truncates,
// append_file extends, remove deletes, and exists reports each state.
import { print, println } from "stdlib"
import { open, read_all, write_file, append_file, remove, exists } from "fs"

fn read_back(path: string): string {
  var file, err = open(path)
  if err != null {
    return ""
  }
  defer file.close()
  var text, readErr = read_all(file)
  if readErr != null {
    return ""
  }
  return text
}

fn main() {
  const path = "/tmp/gyro-fs-write-read.txt"

  var created = write_file(path, "one\n")
  println(created == null)
  println(exists(path))
  print(read_back(path))

  var extended = append_file(path, "two\n")
  println(extended == null)
  print(read_back(path))

  var truncated = write_file(path, "three\n")
  println(truncated == null)
  print(read_back(path))

  var removed = remove(path)
  println(removed == null)
  println(exists(path))
}
