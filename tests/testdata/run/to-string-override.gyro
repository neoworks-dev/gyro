import { println } from "stdlib"
import { format, heap } from "mem"

struct Version {
  major: i32
  minor: i32
}

fn Version::to_string(self): string {
  return format(heap(), "v#{self.major}.#{self.minor}")
}

fn main() {
  println(Version{ major: 1, minor: 4 })
  println("inline: #{Version{ major: 2, minor: 0 }}")
}
