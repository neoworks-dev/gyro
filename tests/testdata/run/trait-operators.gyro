// On a type a program declares, an operator is the method of a trait: + is
// Add, - is Sub, * is Mul, / is Div, % is Rem, unary - is Neg, == and != are
// Eq, and < <= > >= are Ord. The numbers have all of these without an impl
// being written for them.

import { println, Eq, Ord, Print, Add, Sub, Mul, Div, Rem, Neg } from "stdlib"
import { format, heap } from "mem"

struct Vector2 {
    x: i32
    y: i32
}

impl Eq for Vector2
impl Print for Vector2

impl Add for Vector2 {
    fn add(self, other: Self): Self {
        return Vector2{ x: self.x + other.x, y: self.y + other.y }
    }
}

impl Sub for Vector2 {
    fn sub(self, other: Self): Self {
        return Vector2{ x: self.x - other.x, y: self.y - other.y }
    }
}

impl Neg for Vector2 {
    fn neg(self): Self {
        return Vector2{ x: -self.x, y: -self.y }
    }
}

// Fractions are compared by cross-multiplying, which is why their Eq is
// written out: 1/2 and 2/4 are the same number.
struct Fraction {
    num: i32
    den: i32
}

impl Eq for Fraction {
    fn eq(self, other: Self): bool {
        return self.num * other.den == other.num * self.den
    }
}

impl Ord for Fraction {
    fn compare(self, other: Self): i32 {
        var left = self.num * other.den
        var right = other.num * self.den
        if left < right {
            return -1
        }
        if left > right {
            return 1
        }
        return 0
    }
}

impl Mul for Fraction {
    fn mul(self, other: Self): Self {
        return Fraction{ num: self.num * other.num, den: self.den * other.den }
    }
}

impl Div for Fraction {
    fn div(self, other: Self): Self {
        return Fraction{ num: self.num * other.den, den: self.den * other.num }
    }
}

impl Print for Fraction {
    fn to_string(self): string {
        return format(heap(), "#{self.num}/#{self.den}")
    }
}

struct Clock {
    minutes: i32
}

impl Rem for Clock {
    fn rem(self, other: Self): Self {
        return Clock{ minutes: self.minutes % other.minutes }
    }
}

impl Print for Clock

// A generic uses the operators its bounds give it, and the same code runs
// for the numbers and for Vector2.
fn sum3<T: Add>(a: T, b: T, c: T): T {
    return a + b + c
}

fn flip<T: Neg>(value: T): T {
    return -value
}

fn main() {
    var a = Vector2{ x: 1, y: 2 }
    var b = Vector2{ x: 10, y: 20 }
    println(a + b)
    println(b - a)
    println(-a)
    println(a == Vector2{ x: 1, y: 2 })
    println(a != b)
    println(sum3(a, b, a))
    println(sum3(1, 2, 3))
    println(sum3(0.5, 0.25, 0.25))
    println(flip(b))
    println(flip(-7))

    var half = Fraction{ num: 1, den: 2 }
    var two_fourths = Fraction{ num: 2, den: 4 }
    var third = Fraction{ num: 1, den: 3 }
    println(half == two_fourths)
    println(half != third)
    println(third < half)
    println(half <= two_fourths)
    println(half > third)
    println(third >= half)
    println(half * third)
    println(half / third)

    var late = Clock{ minutes: 130 }
    println(late % Clock{ minutes: 60 })
}
