// Two threads incrementing the same counter 100 times each. The total is
// deterministic; the interleaving is not.

import { println, Mutex } from "stdlib"
import { heap, spawn } from "mem"

fn main() {
    let total = Mutex::new(0)
    let done = chan<bool>()

    spawn(heap(), fn() {
        for i in 0..100 {
            let guard = total.lock()
            defer guard.unlock()
            guard.set(guard.get() + 1)
        }
        done <- true
    })
    for i in 0..100 {
        let guard = total.lock()
        defer guard.unlock()
        guard.set(guard.get() + 1)
    }

    let _ = <-done
    let guard = total.lock()
    println(guard.get())
    guard.unlock()
}
