// A nullable is unusable until a check narrows it, including through an
// early return and through the left half of an &&.

import { println } from "stdlib"

fn describe(x: i32?): i32 {
    if x == null {
        return -1
    }
    return x + 1
}

fn main() {
    var present: i32? = 41
    var absent: i32? = null
    println(describe(present))
    println(describe(absent))
    if present != null && present > 40 {
        println("narrowed in a condition")
    }
}
