// What the kernel refuses is reported with the call, the path and its
// reason: a directory written to or read as a file, and a file listed as a
// directory.

import { println } from "stdlib"
import { open, read_all, write_file, read_dir, remove, exists } from "fs"
import { heap } from "mem"

fn main() {
    var err = write_file("/tmp", "x")
    if err != null {
        println(err.message())
    }

    var dir, openErr = open("/tmp")
    println(openErr == null)
    var text, readErr = read_all(heap(), dir)
    println(text.len())
    if readErr != null {
        println(readErr.message())
    }

    const file = "/tmp/gyro-fs-more-errors.txt"
    var wrote = write_file(file, "abc")
    println(wrote == null)
    var names, listErr = read_dir(heap(), file)
    println(names.len())
    if listErr != null {
        println(listErr.message())
    }
    names.free()

    var removed = remove(file)
    println(removed == null)
    println(exists(file))
    var again = remove(file)
    if again != null {
        println(again.message())
    }
}
