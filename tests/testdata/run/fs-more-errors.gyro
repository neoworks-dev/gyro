// What the kernel refuses is reported with the call, the path and its
// reason: a directory written to or read as a file, and a file listed as a
// directory.

import { println, Array, Error } from "stdlib"
import { File, open, read_all, write_file, read_dir, remove, exists } from "fs"
import { heap } from "mem"

fn main() {
    let err = write_file("/tmp", "x")
    if err != null {
        println(err.message())
    }

    // A directory is reachable, so it opens; reading it is what fails.
    match open("/tmp") {
        Error(e): println(e.message())
        File(dir): {
            println("opened")
            match read_all(heap(), dir) {
                string(text): println(text.len())
                Error(e): println(e.message())
            }
        }
    }

    const file = "/tmp/gyro-fs-more-errors.txt"
    let wrote = write_file(file, "abc")
    println(wrote == null)
    match read_dir(heap(), file) {
        Array<string>(names): {
            println(names.len())
            names.free()
        }
        Error(e): println(e.message())
    }

    let removed = remove(file)
    println(removed == null)
    println(exists(file))
    let again = remove(file)
    if again != null {
        println(again.message())
    }
}
