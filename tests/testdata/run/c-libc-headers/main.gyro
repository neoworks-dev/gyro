// A C file that includes <stdlib.h>, <string.h> and <math.h> and calls what
// they declare. Nothing is declared by hand on either side: the file's
// prototypes are the system's, and the Gyro side sees the file's exports.

import { println } from "stdlib"
import { heap } from "mem"
import { c_string, c_data } from "cstring"
import safe { is_square, make, release } from "./lib.c"
import { checksum } from "./lib.c"

// The sum of the upper-cased bytes: "abc" is 65 + 66 + 67.
safe fn sum_of(text: string): i64 {
  var bytes = c_string(heap(), text)
  defer bytes.free()
  return checksum(c_data(bytes))
}

fn main() {
  println(sum_of("abc"))
  println(is_square(49))
  println(is_square(50))
  var a = make(4)
  release(a)
}
