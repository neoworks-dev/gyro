//
// The named HTML entities md4c knows, kept sorted so the lookup can be
// a binary search the way upstream's bsearch() is. Names carry their
// '&' and ';' because that is what the parser hands over: it marks the
// whole entity, delimiters included.
//
// A second codepoint of 0 means the entity is a single code point.

export const COUNT: i64 = 2125

// lookup answers the two code points of a named entity and whether it
// is one at all. `name` is the whole entity text, "&amp;" and not
// "amp".
export fn lookup(name: string): (u32, u32, bool) {
  var low: i64 = 0
  var high: i64 = COUNT - 1
  while low <= high {
    var pivot = (low + high) / 2
    var order = name.compare(NAMES[pivot as usize])
    if order < 0 {
      high = pivot - 1
    } elif order > 0 {
      low = pivot + 1
    } else {
      return CODEPOINTS[(2 * pivot) as usize], CODEPOINTS[(2 * pivot + 1) as usize], true
    }
  }
  return 0, 0, false
}

