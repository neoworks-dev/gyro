// An untyped operand takes the type its context decides, and so do the
// operands *inside* it. A shift is the case that shows it: the count
// keeps its own type, so the untyped left operand has nothing next to it
// to adapt against, and only the surrounding context says how wide it is.
//
// `~` is the same shape with one operand. Neither folds to a constant
// when the other side is a variable, so both reach the backends as real
// instructions and every tier has to agree on their width.

import { println } from "stdlib"

fn main() {
  var word: u32 = 0x0f0f0f0f
  var four: u32 = 4
  // 0xffffffff is a u32 here; at the i32 default it would not fit.
  println(word & (0xffffffff >> four))
  println(word | (0xf << four))

  // ~0 is all ones at the width of the other operand.
  println(word & ~0)
  println(word | ~0)
  println(word & ~0x0f0f)

  var byte: u8 = 0xff
  var shift: u8 = 4
  println(byte & (0xff >> shift))
  println(byte & ~0xf0)

  var small: i8 = 100
  println(small & ~4)

  var half: u16 = 0xabcd
  println(half & ~0xff)

  // A shift of two literals folds, and the folded value is what has to
  // fit: 1 << 40 is an i64 here, not an i32 that overflowed.
  var wide: i64 = 1 << 40
  println(wide)
  var high: u32 = 1 << 31
  println(high)
}
