import { println } from "stdlib"

fn main() {
    var sum: i32 = 0
    for x in [1, 2, 3] {
        sum += x
    }
    for i in 0..3 {
        sum += i
    }
    println(sum)

    for i in 0..10 {
        if i == 2 {
            continue
        }
        if i == 5 {
            break
        }
        println(i)
    }
}
