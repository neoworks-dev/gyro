// The one error this program raises.
//
// A type is an error because it implements Error, and nothing else makes it
// one. The row says the result views the receiver, because it is the
// receiver's own field rather than new text.

import { Error } from "stdlib"

export struct CalcError {
    text: string
}

impl Error for CalcError {
    fn message(self): string !{ &self } {
        return self.text
    }
}
