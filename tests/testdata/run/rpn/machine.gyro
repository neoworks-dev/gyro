// The machine the words run on: a stack of f64, the variables, and the
// definitions.
//
// The names are kept in `var_names` and `word_names` beside the maps, in
// the order they were defined, so `words` and `vars` list them the way
// they were written rather than the way they hash.

import { println, Array, Map, String, join } from "stdlib"
import { CalcError } from "./error"
import { format, heap } from "mem"

export struct Calc {
  stack: Array<f64>

  vars: Map<string, f64>
  var_names: Array<string>

  words: Map<string, Array<string>>
  word_names: Array<string>

  export done: bool
}

export fn Calc::new(): Calc {
  return Calc{
    stack: Array<f64>::new(),
    vars: Map<string, f64>::new(),
    var_names: Array<string>::new(),
    words: Map<string, Array<string>>::new(),
    word_names: Array<string>::new(),
    done: false,
  }
}

export fn Calc::free(*self) {
  self.stack.free()
  self.vars.free()
  self.var_names.free()
  for name in self.word_names.slice() {
    var body = self.words.get(name)
    if body != null {
      body.free()
    }
  }
  self.word_names.free()
  self.words.free()
}

// ---------------------------------------------------------------------------
// The stack
// ---------------------------------------------------------------------------

export fn Calc::push(*self, value: f64) {
  self.stack.push(value)
}

export fn Calc::pop(*self, word: string): (f64, error?) {
  var value, ok = self.stack.pop()
  if !ok {
    return 0.0, CalcError{ text: format(heap(), "#{word} wants a value and the stack is empty") }
  }
  return value, null
}

// pop2 answers the operands in the order they were written: `a b -` is
// a - b, not b - a.
export fn Calc::pop2(*self, word: string): (f64, f64, error?) {
  if self.stack.len() < 2 {
    return 0.0, 0.0, CalcError{
      text: format(heap(), "#{word} wants two values and the stack has #{self.stack.len()}"),
    }
  }
  var b, _ = self.stack.pop()
  var a, _ = self.stack.pop()
  return a, b, null
}

// pop3 is what `rot` wants: the three values in written order.
export fn Calc::pop3(*self, word: string): (f64, f64, f64, error?) {
  if self.stack.len() < 3 {
    return 0.0, 0.0, 0.0, CalcError{
      text: format(heap(), "#{word} wants three values and the stack has #{self.stack.len()}"),
    }
  }
  var c, _ = self.stack.pop()
  var b, _ = self.stack.pop()
  var a, _ = self.stack.pop()
  return a, b, c, null
}

export fn Calc::depth(self): usize {
  return self.stack.len()
}

export fn Calc::clear(*self) {
  while !self.stack.is_empty() {
    var _, _ = self.stack.pop()
  }
}

// snapshot copies the stack so a failed line can be undone.
export fn Calc::snapshot(self): Array<f64> {
  var copy = Array<f64>::with_capacity(self.stack.len())
  for value in self.stack.slice() {
    copy.push(value)
  }
  return copy
}

export fn Calc::restore(*self, saved: Array<f64>) {
  self.stack.free()
  self.stack = saved
}

export fn Calc::show(self) {
  if self.stack.is_empty() {
    println("(empty)")
    return
  }
  var out = String::new()
  defer out.free()

  var i: usize = 0
  while i < self.stack.len() {
    if i > 0 {
      out.push(" ")
    }
    out.push(format(heap(), "#{self.stack.get(i)}"))
    i += 1
  }
  println(out.text())
}

// ---------------------------------------------------------------------------
// Variables
// ---------------------------------------------------------------------------

export fn Calc::store(*self, name: string, value: f64) {
  if !self.vars.contains(name) {
    self.var_names.push(name)
  }
  self.vars.insert(name, value)
}

export fn Calc::recall(self, name: string): f64? {
  return self.vars.get(name)
}

export fn Calc::var_list(self): string[] !{ &self } {
  return self.var_names.slice()
}

// ---------------------------------------------------------------------------
// Definitions
// ---------------------------------------------------------------------------

// define takes the body: the array is the machine's from here, and the
// body it replaces is freed rather than left behind.
export fn Calc::define(*self, name: string, body: Array<string>) {
  var existing = self.words.get(name)
  if existing != null {
    existing.free()
  } else {
    self.word_names.push(name)
  }
  self.words.insert(name, body)
}

export fn Calc::body_of(self, name: string): Array<string>? {
  return self.words.get(name)
}

export fn Calc::word_list(self): string[] !{ &self } {
  return self.word_names.slice()
}

// forget drops a definition. The name list has no remove, so it is built
// again without the name — there are as many names as a person typed.
export fn Calc::forget(*self, name: string): bool {
  var body = self.words.get(name)
  if body == null {
    return false
  }
  body.free()
  var _ = self.words.remove(name)

  var kept = Array<string>::new()
  for existing in self.word_names.slice() {
    if existing != name {
      kept.push(existing)
    }
  }
  self.word_names.free()
  self.word_names = kept
  return true
}

// ---------------------------------------------------------------------------
// The listings
// ---------------------------------------------------------------------------

export fn Calc::list_words(self) {
  if self.word_names.is_empty() {
    println("no words defined")
    return
  }
  for name in self.word_names.slice() {
    var body = self.words.get(name)
    if body != null {
      println(": #{name} #{join(body.slice(), " ")} ;")
    }
  }
}

export fn Calc::list_vars(self) {
  if self.var_names.is_empty() {
    println("no variables set")
    return
  }
  for name in self.var_names.slice() {
    var value = self.vars.get(name)
    if value != null {
      println("#{name} = #{value}")
    }
  }
}
