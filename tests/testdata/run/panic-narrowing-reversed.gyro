// The other way to be wrong: a window whose end is before its start.
// Both bounds are inside the length here, so this is the case a single
// "index out of range" would have had nothing to say about.

//gyro:panic slice 2..1 out of range for length 3

import { println } from "stdlib"

fn main() {
  var xs = [10, 20, 30]
  println("before")
  var lo: usize = 2
  var hi: usize = 1
  var window = xs[lo..hi]
  println(window.len())
}
