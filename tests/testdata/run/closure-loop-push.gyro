//gyro:skip a frame closure pushed into a container is not rejected (issue 58), so every element shares one record in a frame that is gone
// A closure written in a loop body keeps its captures in one record in the
// frame, and pushing it without keep stores a pointer to that record. The
// program below should be refused, or print what its source says; today it
// compiles and the three closures share one record. The fix is the same
// analysis a slice of an array literal stored in a container needs.

import { println, Array } from "stdlib"

fn build(): Array<fn(): i32> {
  var fns = Array<fn(): i32>::new()
  for i in 0..3 {
    fns.push(fn(): i32 { return i })
  }
  return fns
}

fn main() {
  var fns = build()
  println(fns.get(0)())
  println(fns.get(1)())
  println(fns.get(2)())
  fns.free()
}
