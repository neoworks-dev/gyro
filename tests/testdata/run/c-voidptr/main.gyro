// A Gyro program driving a C library built around `void *`.
//
// A `void *` is an address with the target's type erased, which in
// METALS is `anyptr` — one word, comparable, and with nothing that can
// be loaded through it until a `ptr.cast` puts a type back. That is
// exactly what C already says: `*p`, `p + 1` and `sizeof *p` are all
// errors on a `void *`, so the erasure costs the source language nothing
// it had, and `sizeof(void *)` still answers 8.
//
// None of that crosses into Gyro. The header this imports is all
// scalars, because the store hands out a slot number and an accessor —
// which is what a C library hands out anyway.

import { println } from "stdlib"
import {
  cell_kind, cell_int, cell_x, cell_y, cell_is_null, same_address,
  sum_via_callback, round_trip, void_pointer_size,
} from "./store.c"

fn main() {
  // Erasing a type does not change what a pointer costs.
  println(void_pointer_size())

  // Four slots, three kinds. The tag is the only thing that says what
  // an address means.
  println(cell_kind(0))
  println(cell_kind(2))
  println(cell_kind(3))

  // Each read at the type its tag names: two ints out of one array, and
  // a struct out of the same array of slots.
  println(cell_int(0))
  println(cell_int(1))
  println(cell_x(2))
  println(cell_y(2))

  // The absent address, and identity across the erasure.
  println(cell_is_null(3))
  println(cell_is_null(0))
  println(same_address(0, 0))
  println(same_address(0, 1))

  // 10 + 30 + (3 + 4), with the null slot skipped: a visitor that never
  // learns what it was handed until the tag tells it.
  println(sum_via_callback())

  // Out as an address, back as an int, written through, read back from
  // the object itself.
  println(round_trip(41))
}
