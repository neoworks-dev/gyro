// The Gyro side of the punning asymmetry: reading a union member that
// shares no initial sequence with the one that was written.
//
// C leaves it undefined and the natives do what C does — reinterpret the
// bytes, which no tier can be called wrong for. The evaluator has no
// bytes to reinterpret; what it has is the member that was written, and
// it says so. That is the whole reason a union is not a record with
// coincident offsets: the difference is a fact about reads.

//gyro:panic only a common initial sequence reads across
//gyro:skip native C's own union reinterprets the bytes, which is what C leaves undefined
//gyro:skip cnative C's own union reinterprets the bytes, which is what C leaves undefined

import { println } from "stdlib"

union Value {
  i: i64
  f: f64
}

fn main() {
  var v = Value{ i: 1 }
  println(v.i)
  println(v.f)
  println("unreachable")
}
