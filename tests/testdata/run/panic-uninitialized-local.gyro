// Definite assignment catches an unwritten local directly, so the runtime
// check is only reachable through a pointer: &x puts the local past what
// sema can follow.
//gyro:panic uninitialized
//gyro:skip native the C runtime does not poison uninitialized storage

import { println } from "stdlib"

fn main() {
  var x: i32
  var p = &x
  println(*p)
}
