// Elements of every storage shape cross a channel intact: a narrow
// integer, a float, a struct, and a result holding a string or an error. A
// channel moves the bytes of its element, so what is under test is that a
// narrow scalar goes in and comes out at its own width.

import { println, Error } from "stdlib"

struct Point {
    x: i16
    y: u8
}

fn main() {
    let bytes = chan<u8>(2)
    bytes <- 200
    bytes <- 7
    println(<-bytes)
    println(<-bytes)

    let floats = chan<f32>(1)
    floats <- 1.5
    println(<-floats)

    let points = chan<Point>(1)
    points <- Point{ x: -3, y: 250 }
    let p = <-points
    println(p.x)
    println(p.y)

    let texts = chan<string | Error>(2)
    texts <- "hello"
    texts <- Error::new("boom")
    for i in 0..2 {
        let got, ready = <-texts
        if ready {
            match got {
                string(text): println(text)
                Error(e): println(e.message())
            }
        }
    }

    let signed = chan<i32>(1)
    signed <- -1
    println(<-signed)
}
