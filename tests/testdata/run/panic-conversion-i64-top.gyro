// A float that does not fit the integer it is converted to aborts, rather
// than saturating or wrapping.

//gyro:panic conversion loses the value

import { println } from "stdlib"

fn main() {
    var zero = 0.0
    var value = 9223372036854775808.0
    println("before")
    println(value as i64)
    println("unreachable")
}
