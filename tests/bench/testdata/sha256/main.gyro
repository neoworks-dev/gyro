// SHA-256 over a fixed buffer, hashed round after round: the port the
// execution corpus already checks, measured against the C it came from.
//
// This is the case where Gyro should be closest to C. The inner loop is
// 32-bit arithmetic on a register-sized working set — no allocation, no
// calls, no strings — so what the ratio shows is the cost of a bounds
// check per element access and of spilling values a C compiler keeps in
// registers, and nothing else.
//
// The module is imported out of the corpus rather than copied, so there
// is exactly one SHA-256 port: the one whose digests the corpus compares
// against the C original's, byte for byte.

import { println, eprintln, Array } from "stdlib"
import { monotonic } from "time"
import * as sha256 from "../../../testdata/run/crypto/sha256"
import { heap } from "mem"

const SIZE: i64 = 4096
const ROUNDS: i64 = 1000

fn main() {
  var buffer = Array<u8>::with_capacity(heap(), SIZE as usize)
  for var i: i64 = 0; i < SIZE; i += 1 {
    buffer.push(((i * 31 + 7) & 0xff) as u8)
  }
  var data = buffer.slice()

  // Each round seeds the next one from the digest of the last, so no
  // compiler on either side can hoist the hash out of the loop.
  var start = monotonic()
  var acc: u64 = 0
  for var round: i64 = 0; round < ROUNDS; round += 1 {
    data[0] = (acc & 0xff) as u8
    var digest = sha256::sum(data)
    for byte in digest {
      acc = acc *% 31 +% (byte as u64)
    }
  }
  var stop = monotonic()

  println(acc)
  eprintln("gyro:bench #{stop - start}")
  buffer.free()
}
