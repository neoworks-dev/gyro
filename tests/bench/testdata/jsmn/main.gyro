// jsmn tokenizing the same JSON document round after round: the port the
// execution corpus already checks, measured against the C it came from.
//
// The document is tests.c's issue-22 case, a Tiled map export — nested
// objects, an array of objects, strings with escapes and a few dozen
// numbers, which is what a tokenizer actually meets.
//
// This is the byte-at-a-time shape: one read and a switch per input
// byte, plus a token table written through indexes. Against sha256
// (flat arithmetic over a fixed buffer) and regex (calls and
// backtracking), it is the case where the cost of a bounds check per
// byte read shows up on its own.
//
// The module is imported out of the corpus rather than copied, so there
// is exactly one jsmn port: the one whose token tables the corpus
// compares against the C original's.

import { println, eprintln, Array, bytes } from "stdlib"
import { monotonic } from "time"
import * as jsmn from "../../../testdata/run/jsmn/jsmn"
import { heap } from "mem"

const POOL: i64 = 128
const ROUNDS: i64 = 20000

const DOCUMENT: string = "{ \"height\":10, \"layers\":[ { \"data\":[6,6], \"height\":10, \"name\":\"Calque de Tile 1\", \"opacity\":1, \"type\":\"tilelayer\", \"visible\":true, \"width\":10, \"x\":0, \"y\":0 }], \"orientation\":\"orthogonal\", \"properties\": { }, \"tileheight\":32, \"tilesets\":[ { \"firstgid\":1, \"image\":\"..\\/images\\/tiles.png\", \"imageheight\":64, \"imagewidth\":160, \"margin\":0, \"name\":\"Tiles\", \"properties\":{}, \"spacing\":0, \"tileheight\":32, \"tilewidth\":32 }], \"tilewidth\":32, \"version\":1, \"width\":10 }"

// The C enum is a set of bit flags; the port's is an ordinary enum, so
// the checksum names the C numbers explicitly and both sides fold the
// same ones.
fn kind_code(kind: jsmn::Kind): u64 {
  return match kind {
    jsmn::Kind::Undefined: 0
    jsmn::Kind::Object: 1
    jsmn::Kind::Array: 2
    jsmn::Kind::String: 4
    jsmn::Kind::Primitive: 8
  }
}

fn main() {
  var js = DOCUMENT.bytes(heap())
  var tokens = Array<jsmn::Token>::new(heap())

  var start = monotonic()
  var acc: u64 = 0
  for var round: i64 = 0; round < ROUNDS; round += 1 {
    var parser = jsmn::init()
    var result = parser.parse(js, tokens, POOL, false)
    acc = acc *% 31 +% (result as u64)
    for var i: i64 = 0; i < result; i += 1 {
      var token = tokens.get(i as usize)
      acc = acc *% 31 +% kind_code(token.kind) *% 7
      acc = acc *% 31 +% (token.start as u64) *% 3 +% (token.end as u64)
      acc = acc *% 31 +% (token.size as u64)
    }
  }
  var stop = monotonic()

  println(acc)
  eprintln("gyro:bench #{stop - start}")
  tokens.free()
}
