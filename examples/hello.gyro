// The classic starting point.

import { println } from "stdlib"

// No effect row: what greet does is read out of its body, and out of the
// bodies that body calls, in whatever module they live. A row is how a
// function states an interface, not how the compiler finds out.
fn greet(name: string) {
  println("Hello, #{name}!")
}

fn main() {
  greet("World")
  println("Gyro compiler is alive.")

  var x: i32 = 6 * 7
  println(x)              // 42

  var flag = x > 40       // inferred bool
  println(flag)           // true

  const MAX: i32 = 100
  println("max is #{MAX}, half of that is #{MAX / 2}")
}
