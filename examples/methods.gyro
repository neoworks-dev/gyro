// A type's own methods are free-standing: fn Type::name(self, ...). What a
// type promises to other code is a trait, and is implemented in an impl
// block. A generic states what it needs of its type parameters, and a call
// with a type that does not provide it is an error at the call.

import { println, Eq, Ord, Print, Add } from "stdlib"
import { format, heap } from "mem"

export struct Version {
    export major: i32
    export minor: i32
}

export fn Version::new(major: i32, minor: i32): Version {
    return Version{ major: major, minor: minor }
}

// Eq with no block takes the implementation built from the fields.
impl Eq for Version

// Ord is written out. Explicit branches rather than subtraction, which
// would panic on overflow. The operators < <= > >= are this method
// against zero.
impl Ord for Version {
    fn compare(self, other: Version): i32 {
        if self.major != other.major {
            if self.major < other.major {
                return -1
            }
            return 1
        }
        if self.minor < other.minor {
            return -1
        }
        if self.minor > other.minor {
            return 1
        }
        return 0
    }
}

// println and #{} use the compiler-derived representation unless the
// type's Print impl supplies to_string, which then wins.
impl Print for Version {
    fn to_string(self): string {
        return format(heap(), "v#{self.major}.#{self.minor}")
    }
}

// The bound is part of the signature. The body may call compare, and
// nothing a bound does not provide.
export fn max<T: Ord>(a: T, b: T): T {
    if a.compare(b) > 0 {
        return a
    }
    return b
}

// Arithmetic on a user type is the trait's method behind the operator.
export struct Vector2 {
    export x: f64
    export y: f64
}

impl Add for Vector2 {
    fn add(self, other: Self): Self {
        return Vector2{ x: self.x + other.x, y: self.y + other.y }
    }
}

// A user-defined generic struct, instantiated like the built-in ones. It
// only stores its parameter, so it needs no bound.
export struct Pair<T> {
    export first: T
    export second: T
}

export fn Pair<T>::swap(*self) {
    var tmp = self.first
    self.first = self.second
    self.second = tmp
}

fn main() {
    var older = Version::new(1, 4)
    var newer = Version::new(1, 9)

    println(max(older, newer))
    println(max(3, 7))
    println(older < newer)

    var a = Vector2{ x: 1.0, y: 2.0 }
    var b = Vector2{ x: 3.0, y: 4.0 }
    var sum = a + b
    println(sum.x)

    var pair = Pair<i32>{ 1, 2 }
    pair.swap()
    println(pair.first)
}
