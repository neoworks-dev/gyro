// Errors are ordinary return values. A function that can fail returns a
// (value, error) pair, and the caller has to say what happens when it does:
// there is no implicit propagation and no unwinding.
//
// `error` is a built-in interface, so a library defines its own error type
// carrying its own data, and callers match on the concrete kind.

import { println, eprintln } from "@gyro/stdlib"
import { to_i32 } from "@gyro/convert"
import { open, read_all } from "@gyro/fs"

export struct RangeError {
  export value: i32
  export low: i32
  export high: i32
}

// Implementing `error` is what makes RangeError usable as one. It is small,
// so it travels inside the trait object's inline storage and costs no
// allocation on the error path.
impl error for RangeError {
  fn message(self): string {
    return "value #{self.value} is outside #{self.low}..#{self.high}"
  }
}

export fn parse_port(text: string): (i32, error?) {
  var value, err = to_i32(text)
  if err != null {
    return 0, err
  }

  if value < 1 || value > 65535 {
    return 0, RangeError{ value: value, low: 1, high: 65535 }
  }
  return value, null
}

fn load_config(path: string): (string, error?) {
  var handle, err = open(path)
  if err != null {
    return "", err
  }
  defer handle.close()

  var contents, read_err = read_all(handle)
  if read_err != null {
    return "", read_err
  }
  return contents, null
}

fn main() {
  var port, err = parse_port("8080")
  if err != null {
    // Matching on the concrete type recovers the payload the interface hides.
    match err {
      RangeError(e): eprintln("port #{e.value} not in #{e.low}..#{e.high}"),
      _: eprintln("bad port: #{err.message()}"),
    }
    return
  }
  println("listening on #{port}")

  // `_` explicitly discards a value. Dropping an error without it is a
  // compile error, so ignoring one is always visible in the source.
  var _, ignored = parse_port("not a number")

  var config, config_err = load_config("gyro.toml")
  if config_err != null {
    eprintln("could not read config: #{config_err.message()}")
    return
  }
  println(config)
}
