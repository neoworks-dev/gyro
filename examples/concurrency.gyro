// Threads, channels and async, which solve three different problems.
//
//   threads  - use every core                (spawn, Mutex)
//   channels - hand work between them safely  (chan<T>, select)
//   async    - hold many idle IO operations   (async fn / await)

import { println, Mutex, Array } from "stdlib"
import { heap, spawn, format } from "mem"
import { get } from "net"

// --- channels -------------------------------------------------------------

fn produce(out: chan<i32>, count: i32) {
    for let i = 0; i < count; i += 1 {
        out <- i * i
    }
    out.close()
}

fn consume(values: chan<i32>, done: chan<bool>) {
    let total: i32 = 0
    for value in values {
        total += value
    }
    println("total: #{total}")
    done <- true
}

// A channel element can be a tuple, so a worker reports a fallible result
// without a wrapper struct. Closing when there is nothing more to send is
// what lets the receiver tell "no value yet" from "no value ever".
fn fetch_into(url: string, results: chan<(string, error?)>) {
    results <- (format(heap(), "stub body for #{url}"), null)
    results.close()
}

// `select` waits on several operations and takes whichever is ready first.
// Arms end at the newline, and bindings are ordinary declarations: there is
// no separate `:=` form.
fn drain(values: chan<i32>, quit: chan<bool>) {
    while true {
        select {
            let value = <-values: println("got #{value}")
            quit <- true: return
            else: println("nothing ready")
        }
    }
}

// --- threads --------------------------------------------------------------

fn sum_shared(values: i32[]) {
    let total = Mutex::new(0)

    for value in values {
        // lock() returns the guard directly. There is no poisoning: a Gyro
        // panic aborts the whole process, so no thread ever observes a lock
        // its holder abandoned. Release is explicit, and a defer runs at the
        // exit of the enclosing block — here, every loop iteration.
        let guard = total.lock()
        defer guard.unlock()
        guard.set(guard.get() + value)
    }
}

// --- async ----------------------------------------------------------------

// Takes a borrowed view of the urls and returns an owning Array the caller
// is responsible for freeing.
export async fn fetch_all(urls: string[]): (Array<string>, error?) {
    let bodies = Array<string>::new(heap())

    for url in urls {
        let body, err = await get(url)
        if err != null {
            return bodies, err
        }
        bodies.push(body)
    }
    return bodies, null
}

// async main is allowed; the runtime drives it.
async fn main() {
    let values = chan<i32>(64)
    let done = chan<bool>()

    // `spawn` is an ordinary stdlib function, not grammar: it takes a closure,
    // which is what carries the arguments across to the new thread.
    //
    // The captures here are channels, which is why this is quiet. A closure
    // captures by copy, so capturing a `*T` or a `T[]` instead would leave
    // both threads reaching the same memory, and the compiler warns about it.
    // Hand a reference over with `fn[move x]()`, or share through a channel
    // or a Mutex as these do.
    spawn(heap(), fn() produce(values, 10))
    spawn(heap(), fn() consume(values, done))
    let _ = <-done

    // The tuple comes out whole; a two-name binding on a receive already
    // means (value, open), so the element is destructured afterwards.
    let results = chan<(string, error?)>()
    spawn(heap(), fn() fetch_into("https://example.com", results))
    let result = <-results
    println("first fetch: #{result.0}")

    // A two-name receive reports whether the channel was open. A closed
    // channel yields no value, so `body` is only readable where `more` is
    // true — reading it outside the check does not compile.
    let body, more = <-results
    if more {
        println("second fetch: #{body.0}")
    } else {
        println("no more results")
    }

    let bodies, err = await fetch_all(["https://example.com"])
    defer bodies.free()
    if err != null {
        println("fetch failed: #{err.message()}")
        return
    }
    println("fetched #{bodies.len()} pages")

    // The lexical hazard `<-` creates, and why it is not a problem: a send is
    // always a statement, so a comparison against a negative number still
    // parses as a comparison.
    let x: i32 = 3
    let negative = x < -1
    println(negative)
}
