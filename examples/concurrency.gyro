// Threads, channels and async, which solve three different problems.
//
//   threads  - use every core                (@concurrent)
//   channels - hand work between them safely  (chan<T>, select)
//   async    - hold many idle IO operations   (async fn / await)

import { println, spawn, Mutex, Array } from "@gyro/stdlib"
import { get } from "@gyro/net"

// --- channels -------------------------------------------------------------

fn produce(out: chan<i32>, count: i32) {
  for var i = 0; i < count; i += 1 {
    out <- i * i
  }
  out.close()
}

fn consume(values: chan<i32>, done: chan<bool>) {
  var total: i32 = 0
  for value in values {
    total += value
  }
  println("total: #{total}")
  done <- true
}

// A channel element can be a tuple, so a worker reports a fallible result
// without a wrapper struct.
fn fetch_into(url: string, results: chan<(string, error?)>) {
  results <- ("stub body for #{url}", null)
}

// `select` waits on several operations and takes whichever is ready first.
// Arms end at the newline, and bindings are ordinary declarations: there is
// no separate `:=` form.
fn drain(values: chan<i32>, quit: chan<bool>) {
  while true {
    select {
      var value = <-values: println("got #{value}")
      quit <- true: return
      else: println("nothing ready")
    }
  }
}

// --- threads --------------------------------------------------------------

@concurrent(threads = 8)
fn sum_shared(values: i32[]) {
  var total = Mutex::new(0)

  for value in values {
    // lock() returns the guard directly. There is no poisoning: a Gyro
    // panic aborts the whole process, so no thread ever observes a lock
    // its holder abandoned. Release is explicit, and a defer runs at the
    // exit of the enclosing block — here, every loop iteration.
    var guard = total.lock()
    defer guard.unlock()
    guard.set(guard.get() + value)
  }
}

// --- async ----------------------------------------------------------------

// Takes a borrowed view of the urls and returns an owning Array the caller
// is responsible for freeing.
export async fn fetch_all(urls: string[]): (Array<string>, error?) {
  var bodies = Array<string>::new()

  for url in urls {
    var body, err = await get(url)
    if err != null {
      return bodies, err
    }
    bodies.push(body)
  }
  return bodies, null
}

// async main is allowed; the runtime drives it.
async fn main() {
  var values = chan<i32>(64)
  var done = chan<bool>()

  // `spawn` is an ordinary stdlib function, not grammar: it takes a closure,
  // which is what carries the arguments across to the new thread.
  spawn(fn() produce(values, 10))
  spawn(fn() consume(values, done))
  var _ = <-done

  // The tuple comes out whole; a two-name binding on a receive already
  // means (value, open), so the element is destructured afterwards.
  var results = chan<(string, error?)>()
  spawn(fn() fetch_into("https://example.com", results))
  var result = <-results
  println("first fetch: #{result.0}")

  var bodies, err = await fetch_all(["https://example.com"])
  defer bodies.free()
  if err != null {
    println("fetch failed: #{err.message()}")
    return
  }
  println("fetched #{bodies.len()} pages")

  // The lexical hazard `<-` creates, and why it is not a problem: a send is
  // always a statement, so a comparison against a negative number still
  // parses as a comparison.
  var x: i32 = 3
  var negative = x < -1
  println(negative)
}
