// Recursion, loops and compile-time evaluation.

import { println } from "stdlib"

export fn fib(n: i32): i32 {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Iterative version, much faster for large n.
export fn fib_iter(n: i32): i32 {
    if n <= 1 {
        return n
    }

    let a: i32 = 0
    let b: i32 = 1
    for let i = 2; i <= n; i += 1 {
        let next = a + b
        a = b
        b = next
    }
    return b
}

fn factorial(n: i32): i32 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

const FIB_10: i32 = fib(10)

fn main() {
    println("--- fibonacci (recursive) ---")
    for let i = 0; i <= 10; i += 1 {
        println(fib(i))
    }

    println("--- fibonacci (iterative) ---")
    // Ranges are half-open: 0..15 visits 0 through 14.
    for i in 0..15 {
        println(fib_iter(i))
    }

    println("--- factorials ---")
    for let n = 1; n <= 10; n += 1 {
        println(factorial(n))
    }

    println("fib(10) is #{FIB_10}")
}
