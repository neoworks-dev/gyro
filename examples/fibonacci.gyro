// Recursion, loops and compile-time evaluation.

import { println } from "stdlib"

export fn fib(n: i32): i32 {
  if n <= 1 {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

// Iterative version, much faster for large n.
export fn fib_iter(n: i32): i32 {
  if n <= 1 {
    return n
  }

  var a: i32 = 0
  var b: i32 = 1
  for var i = 2; i <= n; i += 1 {
    var next = a + b
    a = b
    b = next
  }
  return b
}

fn factorial(n: i32): i32 {
  if n <= 1 {
    return 1
  }
  return n * factorial(n - 1)
}

// Evaluated during compilation; the binary contains 55, not a call.
// `@comptime` is one of the fixed decorator names the compiler knows, so
// there is nothing to import.
@comptime const FIB_10: i32 = fib(10)

fn main() {
  println("--- fibonacci (recursive) ---")
  for var i = 0; i <= 10; i += 1 {
    println(fib(i))
  }

  println("--- fibonacci (iterative) ---")
  // Ranges are half-open: 0..15 visits 0 through 14.
  for i in 0..15 {
    println(fib_iter(i))
  }

  println("--- factorials ---")
  for var n = 1; n <= 10; n += 1 {
    println(factorial(n))
  }

  println("fib(10) was folded to #{FIB_10} at compile time")
}
