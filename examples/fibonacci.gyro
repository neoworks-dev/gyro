
// examples/fibonacci.gyro
// Demonstrates: recursion, if/else, for loops, multiple functions.

// Recursive Fibonacci
fn fib(n: i32) -> i32 {
  if (n <= 1) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

// Iterative Fibonacci — much faster
fn fib_iter(n: i32) -> i32 {
  if (n <= 1) {
    return n;
  }
  let a: i32 = 0;
  let b: i32 = 1;
  for (let i: i32 = 2; i <= n; i += 1) {
    let tmp: i32 = a + b;
    a = b;
    b = tmp;
  }
  return b;
}

fn factorial(n: i32) -> i32 {
  if (n <= 1) {
    return 1;
  }
  return n * factorial(n - 1);
}

fn main() -> void {
  // Print first 10 Fibonacci numbers (recursive)
  print("--- Fibonacci (recursive) ---");
  for (let i: i32 = 0; i <= 10; i += 1) {
    print(fib(i));
  }

  // Print first 15 Fibonacci numbers (iterative)
  print("--- Fibonacci (iterative) ---");
  for (let i: i32 = 0; i <= 15; i += 1) {
    print(fib_iter(i));
  }

  // Factorials
  print("--- Factorials ---");
  for (let n: i32 = 1; n <= 10; n += 1) {
    print(factorial(n));
  }
}
