// Closures are anonymous functions, written with the same `fn` and the same
// `:` return marker as a declaration. What a closure captures is always
// listed explicitly, so escape is visible in the source.

import { println, spawn } from "@gyro/stdlib"

// A closure's type is the function type that already existed in the language.
fn apply(values: i32[], f: fn(i32): i32): i32[] {
  var out: i32[] = []
  for value in values {
    out = out.append(f(value))
  }
  return out
}

fn fold(values: i32[], start: i32, f: fn(i32, i32): i32): i32 {
  var total = start
  for value in values {
    total = f(total, value)
  }
  return total
}

fn main() {
  // Full form: annotated parameters, annotated result, block body.
  var double = fn(a: i32): i32 { return a * 2 }
  println(double(21))

  // Types come from the expected type at the call site, and a body that is
  // one expression needs neither braces nor `return`.
  var doubled = apply([1, 2, 3], fn(x) x * 2)
  var sum = fold([1, 2, 3, 4], 0, fn(acc, x) acc + x)
  println(sum)

  // No parameters and no result.
  var greet = fn() { println("hello") }
  greet()

  // Captures are explicit. `copy` duplicates the binding, `move` transfers
  // ownership into the closure. A bare name means copy.
  var factor: i32 = 3
  var scale = fn[copy factor](x: i32): i32 { return x * factor }
  println(scale(5))

  // Closures are how work reaches another thread, which is why `spawn` can
  // be a library function rather than a keyword.
  spawn(fn() {
    println("on another thread")
  })

  // Async closures await inside their body like any other async function.
  var later = async fn(): i32 { return 1 }
  println(doubled.len())
}
