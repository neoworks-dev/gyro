// Manual memory with a compiler-checked safety net.
//
// `alloc` returns a raw pointer, `free` releases it, and `defer` schedules
// the release at scope exit. The compiler tracks every allocation and warns
// when one can reach the end of its scope without being freed or returned.
//
// A plain `*Node` can never be null. Only `*Node?` can, and it cannot be
// dereferenced until it has been checked.

import { println } from "@gyro/stdlib"
import { alloc, free } from "@gyro/mem"

struct Node {
  value: i32
  next: *Node?      // nullable: the last node has no successor
}

// Freed on every path, including the early return.
fn sum_pair(a: i32, b: i32): i32 {
  var node = alloc<Node>()
  defer free(node)

  node.value = a + b
  if node.value < 0 {
    return 0
  }
  return node.value
}

// The allocation escapes through the return value, so ownership moves to the
// caller and no warning is reported here.
export fn make_node(value: i32): *Node {
  var node = alloc<Node>()
  node.value = value
  node.next = null
  return node
}

// Freeing a chain the compiler cannot see through: the loop is opaque to the
// escape analysis, so this is written out by hand.
export fn free_chain(head: *Node) {
  var current: *Node? = head
  while current != null {
    // `current` is narrowed to *Node inside the check, so the field access
    // needs no unwrapping.
    var next = current.next
    free(current)
    current = next
  }
}

// A closure captures explicitly, so what escapes into it is visible in the
// source. `move` hands ownership to the closure, which is what tells the leak
// analysis to stop tracking the allocation here.
export fn defer_release(value: i32): fn() {
  var node = alloc<Node>()
  node.value = value

  return fn[move node]() {
    free(node)
  }
}

fn main() {
  println(sum_pair(2, 3))

  var release = defer_release(7)
  defer release()

  var head = make_node(1)
  head.next = make_node(2)
  defer free_chain(head)

  var address = &head.value
  println(*address)

  // Overflow is a panic, not a wrap. Wrapping is spelled out where it is
  // wanted, as in a hash.
  var hash: u32 = 2166136261
  for byte in [104, 105] {
    hash = hash *% 16777619 +% byte
  }
  println(hash)
}
