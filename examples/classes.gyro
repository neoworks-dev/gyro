
// examples/classes.gyro
// Demonstrates: classes, methods, if/else, while loops, pattern matching.

// Simple stack implemented as a class
// (v0.1 codegen stubs out class methods — this shows the parse/AST pass)
class Stack {
  let size: i32;
  let top: i32;

  fn new(capacity: i32) -> Stack {
    Stack { size: capacity, top: 0 }
  }

  fn is_empty(&self) -> bool {
    return self.top == 0;
  }
}

// Arithmetic helpers
fn abs(x: i32) -> i32 {
  if (x < 0) {
    return x * -1;
  }
  return x;
}

fn min(a: i32, b: i32) -> i32 {
  if (a < b) { return a; }
  return b;
}

fn max(a: i32, b: i32) -> i32 {
  if (a > b) { return a; }
  return b;
}

fn is_prime(n: i32) -> bool {
  if (n < 2) { return false; }
  if (n == 2) { return true; }
  let i: i32 = 2;
  while (i * i <= n) {
    if (n % i == 0) { return false; }
    i += 1;
  }
  return true;
}

fn main() -> void {
  print("--- abs ---");
  print(abs(-42));    // 42
  print(abs(17));     // 17

  print("--- min / max ---");
  print(min(3, 7));   // 3
  print(max(3, 7));   // 7

  print("--- primes up to 30 ---");
  for (let n: i32 = 2; n <= 30; n += 1) {
    if (is_prime(n)) {
      print(n);
    }
  }

  print("--- match ---");
  let x: i32 = 2;
  match x {
    0 => print("zero"),
    1 => print("one"),
    2 => print("two"),
    _ => print("other"),
  }
}
