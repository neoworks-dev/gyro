// A window with a small interface in it: a toolbar of buttons and a meter,
// redrawn from scratch every frame.
//
// The interface is a tree of elements of different types behind one trait.
// Each frame builds the tree again, the way an immediate-mode UI does, and
// everything that frame needs beyond the elements themselves comes from one
// arena: the arrays holding the tree, the text of every caption and the C
// copies SDL reads. At the end of the frame `free_all` hands the whole
// arena back at once, so nothing is freed piece by piece and nothing leaks.
//
// The pixels are SDL's. Locking a streaming texture hands back an address
// and a pitch, and `slice_from_raw` turns those into a u32[] the elements
// paint into, bounds-checked like any other slice. Only the captions are
// drawn by SDL, with its built-in debug font.
//
// Clicking a button counts the click, and the meter fills with the total.
// Run with `--smoke` it stops after 120 frames, which is how it runs
// without a display under SDL_VIDEODRIVER=dummy.
//
//gyro:skip it opens a window, which a golden cannot hold

import { println, eprintln, Array } from "stdlib"
import { heap, format, Allocator, Arena } from "mem"
import { c_string, c_data, from_c } from "cstring"
import { slice_from_raw } from "unsafe"
import safe {
  SDL_Init, SDL_Quit, SDL_GetError, SDL_CreateWindow, SDL_DestroyWindow,
  SDL_CreateRenderer, SDL_DestroyRenderer, SDL_CreateTexture, SDL_DestroyTexture,
  SDL_LockTexture, SDL_UnlockTexture, SDL_RenderClear, SDL_RenderTexture,
  SDL_RenderDebugText, SDL_SetRenderDrawColor, SDL_RenderPresent, SDL_PollEvent,
  SDL_Delay, SDL_Event, SDL_Window, SDL_Renderer, SDL_Texture, SDL_INIT_VIDEO,
  SDL_EVENT_QUIT, SDL_EVENT_MOUSE_MOTION, SDL_EVENT_MOUSE_BUTTON_DOWN,
  SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING,
} from "pkg:sdl3/SDL3/SDL.h"

const WIDTH: i32 = 640
const HEIGHT: i32 = 360

// ---------------------------------------------------------------------
// Drawing

struct Rect {
  x: i32
  y: i32
  w: i32
  h: i32
}

fn Rect::contains(self, x: f32, y: f32): bool {
  var px = x as i32
  var py = y as i32
  return px >= self.x && px < self.x + self.w && py >= self.y && py < self.y + self.h
}

// A caption to draw over the pixels once they are on screen.
struct Text {
  x: i32
  y: i32
  text: string
}

// Where a frame is painted: the texture's pixels, one row every `stride`
// elements, and the captions collected on the way.
struct Canvas {
  pixels: u32[]
  stride: usize
  texts: Array<Text>
}

// fill paints a rectangle, clipped to the canvas.
fn Canvas::fill(*self, r: Rect, colour: u32) {
  var left = max(r.x, 0)
  var top = max(r.y, 0)
  var right = min(r.x + r.w, WIDTH)
  var bottom = min(r.y + r.h, HEIGHT)
  for var y = top; y < bottom; y += 1 {
    var row = y as usize * self.stride
    for var x = left; x < right; x += 1 {
      self.pixels[row + x as usize] = colour
    }
  }
}

fn Canvas::write(*self, x: i32, y: i32, text: string) {
  self.texts.push(Text{ x: x, y: y, text: text })
}

fn min(a: i32, b: i32): i32 {
  if a < b {
    return a
  }
  return b
}

fn max(a: i32, b: i32): i32 {
  if a > b {
    return a
  }
  return b
}

// What a frame knows about the mouse.
struct Mouse {
  x: f32
  y: f32
  clicked: bool
}

// ---------------------------------------------------------------------
// Elements

trait Element {
  // paint draws the element, taking the text of its captions from the
  // frame's allocator.
  fn paint(self, canvas: *Canvas, frame: Allocator, mouse: Mouse)

  // press reacts to a click at the mouse and reports whether it hit.
  fn press(*self, mouse: Mouse): bool
}

struct Button {
  rect: Rect
  label: string
  clicks: i32
}

impl Element for Button {
  fn paint(self, canvas: *Canvas, frame: Allocator, mouse: Mouse) {
    var colour: u32 = 0xff3a4a6b
    if self.rect.contains(mouse.x, mouse.y) {
      colour = 0xff5872a8
    }
    canvas.fill(self.rect, colour)
    canvas.write(self.rect.x + 10, self.rect.y + 12, format(frame, "#{self.label} (#{self.clicks})"))
  }

  fn press(*self, mouse: Mouse): bool {
    if !self.rect.contains(mouse.x, mouse.y) {
      return false
    }
    self.clicks += 1
    return true
  }
}

// A meter shows a level out of its capacity as a filled bar.
struct Meter {
  rect: Rect
  level: i32
  capacity: i32
}

impl Element for Meter {
  fn paint(self, canvas: *Canvas, frame: Allocator, mouse: Mouse) {
    canvas.fill(self.rect, 0xff20242c)
    var filled = self.rect.w * min(self.level, self.capacity) / self.capacity
    canvas.fill(Rect{ x: self.rect.x, y: self.rect.y, w: filled, h: self.rect.h }, 0xff4fb37a)
    canvas.write(self.rect.x, self.rect.y - 14, format(frame, "#{self.level} of #{self.capacity} clicks"))
  }

  fn press(*self, mouse: Mouse): bool {
    return false
  }
}

// A panel is the tree's inner node: a background behind its children,
// which may be any element, panels included.
struct Panel {
  rect: Rect
  colour: u32
  children: Array<dyn Element>
}

impl Element for Panel {
  fn paint(self, canvas: *Canvas, frame: Allocator, mouse: Mouse) {
    canvas.fill(self.rect, self.colour)
    for i in 0..self.children.len() {
      self.children.get(i).paint(canvas, frame, mouse)
    }
  }

  fn press(*self, mouse: Mouse): bool {
    if !self.rect.contains(mouse.x, mouse.y) {
      return false
    }
    for i in 0..self.children.len() {
      var child = self.children.get(i)
      if child.press(mouse) {
        return true
      }
    }
    return false
  }
}

// ---------------------------------------------------------------------
// SDL

// SDL reports what went wrong as a C string it owns, and the next call
// may overwrite it, so this copies it out.
safe fn failure(): string {
  return from_c(heap(), SDL_GetError())
}

safe fn open_window(title: string, width: i32, height: i32): *SDL_Window? {
  var bytes = c_string(heap(), title)
  defer bytes.free()
  return SDL_CreateWindow(c_data(bytes), width, height, 0)
}

// lock hands back the texture's pixels as a slice, or null when SDL
// cannot lock it. SDL says the memory holds `pitch` bytes a row for
// every row of the texture, which is the promise this function vouches for.
safe fn lock(texture: *SDL_Texture, stride: *usize): u32[]? {
  var address: anyptr? = null
  var pitch: i32 = 0
  if !SDL_LockTexture(texture, null, &address, &pitch) || address == null {
    return null
  }
  var memory = address
  *stride = pitch as usize / 4
  return slice_from_raw<u32>(memory, *stride * HEIGHT as usize)
}

// caption draws one string with SDL's debug font, through a C copy that
// lives in the frame's allocator.
safe fn caption(renderer: *SDL_Renderer, frame: Allocator, text: Text) {
  var bytes = c_string(frame, text.text)
  var _ = SDL_RenderDebugText(renderer, text.x as f32, text.y as f32, c_data(bytes))
}

// poll drains the event queue into what the frame needs: where the mouse
// is, whether it was clicked, and whether the window was asked to close.
// Every event begins with the same u32 tag, and the mouse fields are read
// only from the events whose tag says they are there, which is the promise
// this function vouches for.
safe fn poll(event: *SDL_Event, mouse: *Mouse): bool {
  var quit = false
  mouse.clicked = false
  while SDL_PollEvent(event) {
    if event.type == SDL_EVENT_QUIT as u32 {
      quit = true
    } elif event.type == SDL_EVENT_MOUSE_MOTION as u32 {
      mouse.x = event.motion.x
      mouse.y = event.motion.y
    } elif event.type == SDL_EVENT_MOUSE_BUTTON_DOWN as u32 {
      mouse.x = event.button.x
      mouse.y = event.button.y
      mouse.clicked = true
    }
  }
  return quit
}

// ---------------------------------------------------------------------

fn main(args: string[]) {
  var limit = 0
  if args.len() > 1 && args[1] == "--smoke" {
    limit = 120
  }

  if !SDL_Init(SDL_INIT_VIDEO) {
    eprintln("SDL_Init: #{failure()}")
    return
  }
  defer SDL_Quit()

  var window = open_window("gyro: elements", WIDTH, HEIGHT)
  if window == null {
    eprintln("SDL_CreateWindow: #{failure()}")
    return
  }
  defer SDL_DestroyWindow(window)

  var renderer = SDL_CreateRenderer(window, null)
  if renderer == null {
    eprintln("SDL_CreateRenderer: #{failure()}")
    return
  }
  defer SDL_DestroyRenderer(renderer)

  var texture = SDL_CreateTexture(
    renderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STREAMING, WIDTH, HEIGHT,
  )
  if texture == null {
    eprintln("SDL_CreateTexture: #{failure()}")
    return
  }
  defer SDL_DestroyTexture(texture)

  // The elements outlive every frame; the tree pointing at them does not.
  var open = Button{ rect: Rect{ x: 40, y: 40, w: 160, h: 36 }, label: "Open", clicks: 0 }
  var save = Button{ rect: Rect{ x: 220, y: 40, w: 160, h: 36 }, label: "Save", clicks: 0 }
  var close = Button{ rect: Rect{ x: 400, y: 40, w: 160, h: 36 }, label: "Close", clicks: 0 }
  var meter = Meter{ rect: Rect{ x: 40, y: 160, w: 520, h: 24 }, level: 0, capacity: 20 }

  var arena = Arena::new(heap(), 1 << 16)
  defer arena.free()

  var mouse = Mouse{ x: -1.0, y: -1.0, clicked: false }
  var event = SDL_Event{ type: 0 }
  var frames = 0

  while limit == 0 || frames < limit {
    if poll(&event, &mouse) {
      break
    }
    var frame = arena.allocator()

    var toolbar = Panel{
      rect: Rect{ x: 20, y: 20, w: 560, h: 76 },
      colour: 0xff2a2f3a,
      children: Array<dyn Element>::new(frame),
    }
    toolbar.children.push(&open as dyn Element)
    toolbar.children.push(&save as dyn Element)
    toolbar.children.push(&close as dyn Element)

    var root = Panel{
      rect: Rect{ x: 0, y: 0, w: WIDTH, h: HEIGHT },
      colour: 0xff14161b,
      children: Array<dyn Element>::new(frame),
    }
    root.children.push(&toolbar as dyn Element)
    root.children.push(&meter as dyn Element)

    if mouse.clicked {
      var _ = root.press(mouse)
      meter.level = open.clicks + save.clicks + close.clicks
    }

    var stride: usize = 0
    var canvas = Canvas{ pixels: [], stride: 0, texts: Array<Text>::new(frame) }
    var pixels = lock(texture, &stride)
    if pixels != null {
      canvas.pixels = pixels
      canvas.stride = stride
      root.paint(&canvas, frame, mouse)
      SDL_UnlockTexture(texture)
    }

    var _ = SDL_RenderClear(renderer)
    var _ = SDL_RenderTexture(renderer, texture, null, null)
    var _ = SDL_SetRenderDrawColor(renderer, 230, 232, 238, 255)
    for i in 0..canvas.texts.len() {
      caption(renderer, frame, canvas.texts.get(i))
    }
    var _ = SDL_RenderPresent(renderer)

    arena.free_all()
    SDL_Delay(16)
    frames += 1
  }

  println("#{frames} frames, #{meter.level} clicks")
}
