// Traits are how a type promises behaviour, and how a generic function says
// what it needs. Satisfaction is nominal: a type implements a trait only
// where an `impl` says so, never by accident.

import { println } from "@gyro/stdlib"

export trait Display {
  fn show(self): string
}

export trait Ord {
  // `Self` is the implementing type.
  fn compare(self, other: Self): i32
}

export struct Version {
  export major: i32
  export minor: i32
}

impl Display for Version {
  fn show(self): string {
    return "v#{self.major}.#{self.minor}"
  }
}

impl Ord for Version {
  fn compare(self, other: Version): i32 {
    if self.major != other.major {
      return self.major - other.major
    }
    return self.minor - other.minor
  }
}

// Inherent methods live in their own impl block, separate from trait impls.
impl Version {
  export fn new(major: i32, minor: i32): Version {
    return Version{ major: major, minor: minor }
  }
}

// A bound is what makes `>` legal here: the operator resolves to Ord.
export fn max<T: Ord>(a: T, b: T): T {
  if a > b {
    return a
  }
  return b
}

// Several bounds are an intersection, so they are joined with `&`.
export fn describe_max<T: Ord & Display>(a: T, b: T): string {
  return max(a, b).show()
}

// Operators reach traits through a fixed set: Ord for comparison, Eq for
// equality, Add and friends for arithmetic, Index for subscripting.
export struct Vector2 {
  export x: f64
  export y: f64
}

impl Add for Vector2 {
  fn add(self, other: Vector2): Vector2 {
    return Vector2{ x: self.x + other.x, y: self.y + other.y }
  }
}

fn main() {
  var old = Version::new(1, 4)
  var new = Version::new(1, 9)

  println(max(old, new).show())
  println(describe_max(old, new))

  var a = Vector2{ x: 1.0, y: 2.0 }
  var b = Vector2{ x: 3.0, y: 4.0 }
  var sum = a + b                    // calls Add::add
  println(sum.x)
}
