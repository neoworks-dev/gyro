// A match over an enum names the variants it left out. Open subjects —
// integers, strings, Error — are exempt.

import { Error } from "stdlib"

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Point,
}

fn covered(s: Shape): f64 {
    return match s {
        Shape::Circle(r): r
        Shape::Rect(w, h): w
        Shape::Point: 0.0
    }
}

fn missesTwo(s: Shape): f64 {
    return match s { //~ E0521 leaves Shape::Rect, Shape::Point uncovered
        Shape::Circle(r): r
    }
}

fn missesOne(s: Shape): f64 {
    return match s { //~ E0521 leaves Shape::Point uncovered
        Shape::Circle(r): r
        Shape::Rect(w, h): w
    }
}

// `_` and a plain binding both match everything left over, so either one
// closes a match on its own.
fn wildcardCloses(s: Shape): f64 {
    return match s {
        Shape::Point: 0.0
        _: 1.0
    }
}

fn bindingCloses(s: Shape): f64 {
    return match s {
        other: 1.0
    }
}

// A variant counts as covered only when its payload patterns bind rather
// than test: Circle(0.0) still leaves every other radius unmatched.
fn refutablePayloadDoesNotCover(s: Shape): f64 {
    return match s { //~ E0521 leaves Shape::Circle uncovered
        Shape::Circle(0.0): 1.0
        Shape::Rect(w, h): w
        Shape::Point: 0.0
    }
}

fn testThenBind(s: Shape): f64 {
    return match s {
        Shape::Circle(0.0): 1.0
        Shape::Circle(r): r
        Shape::Rect(w, h): w
        Shape::Point: 0.0
    }
}

// Only enums are enumerable.
fn integersAreOpen(n: i32): string {
    return match n {
        0: "zero"
    }
}

struct RangeError {
    value: i32
}

impl Error for RangeError {
    fn message(self): string {
        return "bad"
    }
}

fn errorsAreOpen(err: Error): i32 {
    return match err {
        RangeError(e): e.value
    }
}

// A type-test pattern needs an Error subject and a type that is one.
fn typeTest(err: Error): i32 {
    return match err {
        RangeError(e): e.value
        _: 0
    }
}

fn typeTestNeedsAnError(n: i32) {
    let x = match n {
        RangeError(e): 1 //~ needs an Error subject
        _: 0
    }
}

struct Quiet {
    value: i32
}

fn quietIsNotAnError(err: Error): i32 {
    return match err {
        Quiet(e): e.value //~ Quiet does not implement Error
        _: 0
    }
}

// A T | Error has two cases, and a match names both or ends in `_`.
fn bothCases(r: i32 | Error): i32 {
    return match r {
        i32(n): n
        Error(e): 0
    }
}

fn valueOnly(r: i32 | Error): i32 {
    return match r { //~ this match leaves Error(e) uncovered
        i32(n): n
    }
}

fn errorOnly(r: i32 | Error): i32 {
    return match r { //~ this match leaves i32(value) uncovered
        Error(e): 0
    }
}

fn wildcard(r: i32 | Error): i32 {
    return match r {
        i32(n): n
        _: 0
    }
}

fn otherType(r: i32 | Error): i32 {
    return match r {
        i32(n): n
        string(s): 0 //~ i32 | Error holds an Error or a i32, so a test for string can never match
        Error(e): 0
    }
}
