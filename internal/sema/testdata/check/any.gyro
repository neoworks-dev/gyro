import { Error } from "stdlib"

struct Point {
    x: i32
}

impl Error for Point {
    fn message(self): string {
        return "point"
    }
}

struct Plain {
    x: i32
}

fn wrapping(p: Plain, n: i32, s: string) {
    let a = n as any
    let b = s as any
    let c = p as any
    let d = a as any //~ E0509 an any cannot hold any
}

fn noImplicitWrap(n: i32) {
    let a: any = n //~ E0501 cannot use i32 as any in the declaration of a
    let b: any = n as any
}

fn hidingTypes(err: Error, maybe: i32?, e: Point) {
    let a = err as any   //~ E0509 an any cannot hold Error
    let b = maybe as any //~ E0509 an any cannot hold i32?
    let c = e as any
}

fn unwrapping(v: any) {
    let a = v as i32
    let b = v as Plain
    let c = v as any //~ E0509 an any cannot hold any
}

fn testing(v: any): string {
    return match v {
        i32(n): "int"
        Plain(p): "plain"
        string(s): "text"
        _: "other"
    }
}

// An any is an open subject: no exhaustiveness, and a partial match is
// legal because falling off the end panics.
fn openSubject(v: any): string {
    return match v {
        i32(n): "int"
        _: "other"
    }
}

fn badTests(v: any) {
    let a = match v {
        Error(e): "err" //~ E0512 an any never holds Error
        _: "other"
    }
    let b = match v {
        i32(n, m): "int" //~ E0512 a type test binds the whole value
        _: "other"
    }
}

// A type no path can spell is written out, both in an arm and after `as`.
fn structural(v: any, pair: (i32, string), xs: i32[], p: *Plain) {
    let a = pair as any
    let b = xs as any
    let c = p as any

    let text = match v {
        (i32, string)(both): "pair"
        i32[](view): "slice"
        i32[3](fixed): "array"
        *Plain(node): "pointer"
        _: "other"
    }
    let back = v as (i32, string)
}

// A type test needs a subject whose type is not already known.
fn wrongSubject(n: i32) {
    let text = match n {
        (i32, string)(both): "pair" //~ E0512 a type test on i32 needs an any or a T | Error subject
        _: "other"
    }
}

// The reference-shaped types cannot be wrapped: nothing could recover
// which type came back out.
fn references(ch: chan<i32>, f: fn(i32): i32) {
    let a = ch as any //~ E0509 an any cannot hold chan<i32>
    let b = f as any  //~ E0509 an any cannot hold fn(i32): i32
}
