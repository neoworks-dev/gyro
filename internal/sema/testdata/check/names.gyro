// Name resolution: lexical scoping, no universe scope, order-independent
// module scope.

import { println } from "stdlib"
import { open as fopen } from "fs"

fn undeclared() {
  var x = missing                //~ undeclared name missing
}

fn undeclaredType(p: Missing) {  //~ undeclared type Missing
}

// spawn and alloc are stdlib, not builtins: unimported use fails.
fn noUniverseScope() {
  spawn(fn() {})                 //~ undeclared name spawn
  var p = alloc()                //~ undeclared name alloc
}

fn importsBind() {
  println(1)
  var f = fopen("x")
}

// A module's declarations see each other regardless of order.
fn callsLater(): i32 {
  return declaredBelow()
}

fn declaredBelow(): i32 {
  return 1
}

fn shadowing() {
  var x = 1
  if true {
    var x = 2
    var y = x
  }
}

fn redeclared() {
  var x = 1
  var x = 2                      //~ already declared in this scope
}

fn duplicateParams(a: i32, a: i32) {  //~ already declared in this scope
}

// `var x = x` resolves the initializer before binding the name, so it
// reaches an outer x or nothing.
fn initializerResolvesFirst() {
  var x = x                      //~ undeclared name x
}

fn initializerSeesOuter() {
  var x = 1
  if true {
    var x = x
  }
}

fn exported() {
}

export { exported }
