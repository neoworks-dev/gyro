// A view put into a struct field or a container is judged where it goes in.
// A target the function was handed outlives the frame, so it cannot take the
// frame's storage; a local one takes on the origin of what it holds, and
// returning it is judged like returning the view.

import { Array, Map } from "stdlib"
import { Allocator, heap, keep } from "mem"

struct Registry {
  handlers: Array<fn(): i32>
  window: i32[]
}

fn Registry::add(*self, n: i32) {
  self.handlers.push(fn(): i32 { return n })      //~ E0630 this stores a closure that borrows this frame into self, which outlives it
                                                  //~^ help: copy it out first with keep(allocator, f) from mem, or write a closure that captures nothing
}

fn Registry::addKept(*self, a: Allocator, n: i32) {
  self.handlers.push(keep(a, fn(): i32 { return n }))
}

fn Registry::addPlain(*self) {
  self.handlers.push(fn(): i32 { return 7 })
}

fn Registry::look(*self) {
  var buf = [1, 2, 3]
  self.window = buf                               //~ E0630 this stores a view into storage that ends with this function into self, which outlives it
}

// A view the caller handed in is the caller's, and stays so.
fn Registry::watch(*self, xs: i32[]) {
  self.window = xs
}

fn fill(hs: Array<fn(): i32>, n: i32) {
  hs.push(fn(): i32 { return n })                 //~ E0630 this stores a closure that borrows this frame into hs, which outlives it
}

fn fillKept(a: Allocator, hs: Array<fn(): i32>, n: i32) {
  hs.push(keep(a, fn(): i32 { return n }))
}

fn setElement(hs: Array<fn(): i32>, n: i32) {
  hs.set(0, fn(): i32 { return n })               //~ E0630 this stores a closure that borrows this frame into hs, which outlives it
}

fn insertElement(table: Map<string, fn(): i32>, n: i32) {
  table.insert("k", fn(): i32 { return n })       //~ E0630 this stores a closure that borrows this frame into table, which outlives it
}

fn keepSlice(out: Array<i32[]>) {
  var buf = [1, 2, 3]
  out.push(buf)                                   //~ E0630 this stores a view into storage that ends with this function into out, which outlives it
}

fn keepParam(out: Array<i32[]>, xs: i32[]) {
  out.push(xs)
}

// A local container carries what it was given, and returning it says so.
fn localContainer(n: i32): Array<fn(): i32> {
  var hs = Array<fn(): i32>::new(heap())
  hs.push(fn(): i32 { return n })
  return hs                                       //~ E0610 this returns a closure that borrows this frame
}

fn localContainerKept(a: Allocator, n: i32): Array<fn(): i32> {
  var hs = Array<fn(): i32>::new(a)
  hs.push(keep(a, fn(): i32 { return n }))
  return hs
}

fn localContainerParam(xs: i32[]): Array<i32[]> !{ &xs } {
  var out = Array<i32[]>::new(heap())
  out.push(xs)
  return out
}

fn localContainerParamUnnamed(xs: i32[]): Array<i32[]> {
  var out = Array<i32[]>::new(heap())
  out.push(xs)
  return out                                      //~ E0609 this returns a view into xs, which the row does not name
}

// An assignment follows the value into a field.
fn assignField(n: i32): Registry {
  var r = Registry{ handlers: Array<fn(): i32>::new(heap()), window: [] }
  var buf = [1, 2, 3]
  r.window = buf
  return r                                        //~ E0610 this returns a view into storage that ends with this function
}

// A closure written in a loop body keeps its captures in one place of the
// frame, so pushing it into something declared outside the loop shares the
// record between every element.
fn loopPush(): i32 {
  var hs = Array<fn(): i32>::new(heap())
  for i in 0..3 {
    hs.push(fn(): i32 { return i })               //~ E0632 this stores a closure written in a loop body into hs, which is declared outside the loop
                                                  //~^ help: copy each one out with keep(allocator, f) from mem
  }
  var total = hs.get(0)()
  hs.free()
  return total
}

fn loopPushKept(a: Allocator): i32 {
  var hs = Array<fn(): i32>::new(heap())
  for i in 0..3 {
    hs.push(keep(a, fn(): i32 { return i }))
  }
  var total = hs.get(0)()
  hs.free()
  return total
}

// A container made inside the iteration dies with it.
fn loopLocal(): i32 {
  var total = 0
  for i in 0..3 {
    var hs = Array<fn(): i32>::new(heap())
    hs.push(fn(): i32 { return i })
    total += hs.get(0)()
    hs.free()
  }
  return total
}

fn loopSlice(): usize {
  var windows = Array<i32[]>::new(heap())
  for i in 0..3 {
    var buf = [1, 2, 3]
    windows.push(buf)                             //~ E0632 this stores a view of storage written in a loop body into windows, which is declared outside the loop
  }
  var n = windows.len()
  windows.free()
  return n
}

// A number pushed out of a view stores no view.
fn lengthsOnly(out: Array<usize>, s: string) {
  out.push(s.len())
}
