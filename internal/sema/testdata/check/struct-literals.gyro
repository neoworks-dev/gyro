// A struct literal sets every field, once, with the right type.

struct Point {
    x: i32
    y: i32
}

fn named(): Point {
    return Point{ x: 1, y: 2 }
}

fn positional(): Point {
    return Point{ 1, 2 }
}

fn badLiterals() {
    let a = Point{ x: 1 }             //~ misses the field y
    let b = Point{ x: 1, y: 2, z: 3 } //~ no field z
    let c = Point{ x: 1, x: 2, y: 3 } //~ set twice
    let d = Point{ 1 }                //~ has 2 fields, the literal provides 1
    let e = Point{ x: "one", y: 2 }   //~ cannot use string as i32
}

fn fieldAccess(p: Point): i32 {
    return p.x
}

fn badFieldAccess(p: Point) {
    let v = p.z         //~ no field or method z
    let w: string = p.x //~ cannot use i32 as string
}
