// A closure written in a loop body keeps its captures in one record in the
// frame, and pushing it without keep stores a pointer to that record, so
// every element of the container shares it. The analysis refuses the push;
// keep gives each element a record of its own.

import { println } from "stdlib"
import { Array } from "stdlib"
import { heap, keep } from "mem"

fn build(): Array<fn(): i32> {
  var fns = Array<fn(): i32>::new(heap())
  for i in 0..3 {
    fns.push(fn(): i32 { return i })    //~ E0632 this stores a closure written in a loop body into fns, which is declared outside the loop
                                        //~^ help: a loop body writes the closure's environment in the same place every time, so each element would see the last iteration's captures
                                        //~^^ help: copy each one out with keep(allocator, f) from mem
  }
  return fns
}

fn buildKept(): Array<fn(): i32> {
  var fns = Array<fn(): i32>::new(heap())
  for i in 0..3 {
    fns.push(keep(heap(), fn(): i32 { return i }))
  }
  return fns
}
