// A generic states its bounds, its body may use only what they provide, and
// a call with a type that does not implement a bound is reported at the call.

import { Ord, Eq } from "stdlib"

fn max<T: Ord>(a: T, b: T): T {
    if a.compare(b) > 0 {
        return a
    }
    return b
}

// Without the bound the body has nothing to call.
fn unbounded<T>(a: T, b: T): T {
    if a.compare(b) > 0 { //~ E0405 T has no method compare
        return a
    }
    return b
}

fn noFields<T>(a: T): i32 {
    return a.n //~ E0405 T has no field or method n
}

fn noOperators<T>(a: T, b: T): T {
    return a + b //~ E0527 T does not implement Add
}

fn noEquality<T>(a: T, b: T): bool {
    return a == b //~ E0527 T does not implement Eq
}

// A bound is also a promise to the callers of whatever it is passed to.
fn forwards<T: Ord>(a: T, b: T): T {
    return max(a, b)
}

fn forgetsTheBound<T: Eq>(a: T, b: T): T {
    return max(a, b) //~ E0527 T does not implement Ord
}

struct WithCompare {
    n: i32
}

impl Eq for WithCompare
impl Ord for WithCompare {
    fn compare(self, other: WithCompare): i32 {
        return 0
    }
}

struct NoCompare {
    n: i32
}

fn builtinCompare(): i32 {
    return max(3, 7)
}

fn userCompare(a: WithCompare, b: WithCompare): WithCompare {
    return max(a, b)
}

fn missingCompare(a: NoCompare, b: NoCompare) {
    var x = max(a, b) //~ E0527 NoCompare does not implement Ord
    //~^ help: impl Ord for NoCompare
}

fn first<T>(a: T, b: T): T !{ &a } {
    return a
}

fn none<T>(): T? {
    return null
}

fn inference(): i32 {
    var mixed = first(1, "two") //~ cannot use string as i32
    var uninferable = none()    //~ cannot infer T
    return first(1, 2)
}

fn zero<T>(v: T): T !{ &v } {
    return v
}

fn explicitArguments(): i64 {
    var a = zero<i32>("s")    //~ cannot use string as i32
    var b = zero<i32, i32>(1) //~ takes 1 type argument(s), got 2
    return zero<i64>(3)
}

fn plain(v: i32) {
}

fn plainTakesNoTypeArguments() {
    plain<i32>(1) //~ takes 0 type argument(s), got 1
}

// A generic is a template, not a value: it has no type until it is called.
fn genericsAreCalledNotReferenced() {
    var f = zero //~ must be called
}

struct Pair<T> {
    first: T
    second: T
}

fn Pair<T>::swap(*self) {
    var tmp = self.first
    self.first = self.second
    self.second = tmp
}

fn genericStructs() {
    var p = Pair<i32>{ 1, 2 }
    p.swap()
    var x: i32 = p.first
}

fn badGenericStructs(q: Pair<i32, bool>) { //~ takes 1 type argument(s), got 2
    var a = Pair<i32>{ 1, "two" }          //~ cannot use string as i32
    var b = Pair<i32>{ 1, 2 }
    var c: string = b.first //~ cannot use i32 as string
}

// A literal infers its argument from the fields.
fn literalInference(s: string): i32 {
    var words = Pair{ first: s, second: s }
    var numbers = Pair{ 1, 2 }
    return numbers.first
}

struct Box<T> {
    value: T
}

fn Box<T>::new(value: T): Box<T> {
    return Box{ value: value }
}

fn Box<T>::get(self): T !{ &self } {
    return self.value
}

// The owner's argument comes from the associated function's arguments.
fn ownerInference(): i32 {
    var b = Box::new(1)
    return b.get()
}

fn ownerInferenceIsChecked(): string {
    var b = Box::new(1)
    return b.get() //~ cannot use i32 as string
}

// A type's bounds are written on its parameters and its methods inherit
// them, so a method may call what the bound provides.
trait Speak {
    fn speak(self)
}

struct Holder<T: Speak> {
    value: T
}

fn Holder<T>::shout(self) {
    self.value.speak()
}

struct Silent {
    n: i32
}

struct Loud {
    n: i32
}

impl Speak for Loud {
    fn speak(self) {
    }
}

fn bounded(h: Holder<Loud>) {
    h.shout()
}

// Naming the type with an argument that does not meet the bound is the
// error, at the mention.
fn holderOfSilent(h: Holder<Silent>) { //~ E0527 Silent does not implement Speak
}

struct Plain<T> {
    value: T
}

fn Plain<T>::shout(self) {
    self.value.speak() //~ E0405 T has no method speak
}

// Instantiation is cached, so a recursive generic converges.
fn count<T>(v: T, n: i32): i32 {
    if n <= 0 {
        return 0
    }
    return count(v, n - 1) + 1
}

fn recursion(): i32 {
    return count("x", 3)
}

struct Tree<T> {
    value: T
    left: *Tree<T>?
}

fn selfReferential(root: Tree<i32>): i32 {
    if root.left != null {
    }
    return root.value
}
