// Concrete effects. A declared row is a complete statement of what the
// function does: a row without io promises no io, and a row holding only
// borrows promises the same. A function with no row is unconstrained in
// v1. Allocation is not an effect: a function allocates when it is handed
// an Allocator, and that shows in its parameters.

import { println, Array, runes, Print } from "stdlib"
import { heap } from "mem"

fn quiet(n: i32) !{} {
  println(n)             //~ E0611 println does io, which the row does not name
                         //~^ help: name it in the row: !{ io }
}

// Inference is module-internal: a same-module helper without a row
// contributes whatever its body does.
fn helper(n: i32) {
  println(n)
}

fn indirect(n: i32) !{} {
  helper(n)              //~ E0611 helper does io, which the row does not name
                         //~^ span: helper calls println, which does io
                         //~^^ help: name it in the row: !{ io }
}

// The effect can arrive any number of calls below the one the row is
// checked at. Neither `shape` nor its signature shows the println, so the
// frames under the error are the route inference walked to find it, each
// quoting the call it made: without them the reader is told their row is
// wrong and left to search for the reason.
fn emit(message: string) {
  println(message)
}

fn shape(message: string) {
  emit(message)
}

fn deep(message: string) !{} {
  shape(message)         //~ E0611 shape does io, which the row does not name
                         //~^ span: shape calls emit
                         //~^^ span: emit calls println, which does io
                         //~^^^ help: name it in the row: !{ io }
}

// A borrow-only row still promises no io.
fn fill(xs: Array<i32>, v: i32): i32[] !{ &xs } {
  println(v)             //~ E0611 println does io, which the row does not name
                         //~^ help: name it in the row: !{ io, &xs }
  return xs.slice()
}

// Pushing allocates and interpolating builds a Format, and neither is an
// effect: io for the print is the whole row.
fn describe(xs: Array<i32>, n: i32) !{ io } {
  xs.push(n)
  println("n = #{n}")
}

struct Logger {
  count: i32
}

fn Logger::log(*self, message: string) !{} {
  println(message)       //~ E0611 println does io, which the row does not name
}

// A generic body is judged per instantiation, where a call on the type
// parameter has a concrete callee to answer for it.
trait Speak {
  fn speak(self)
}

struct Shout {
  n: i32
}

impl Speak for Shout {
  fn speak(self) {
    println(self.n)
  }
}

fn callSpeak<T: Speak>(v: T) !{} {
  v.speak()              //~ E0611 speak does io, which the row does not name
}

fn trigger() {
  callSpeak(Shout{ n: 1 })
}

// A rowless generic callee is read through its instantiations, so it
// contributes what the instantiated body reaches.
fn relay<T: Speak>(v: T) {
  v.speak()
}

fn callsRelay() !{} {
  relay(Shout{ n: 2 })   //~ E0611 relay does io, which the row does not name
}

// The effect vocabulary is closed: io, and &name for a borrow. There is no
// alloc effect.
fn misspelled(n: i32) !{ ioo } {   //~ E0612 ioo is not an effect
                                   //~^ help: the only effect is io; a &name entry names a borrow source
  var doubled = n * 2
}

fn allocating(n: i32) !{ alloc } {   //~ E0612 alloc is not an effect
                                     //~^ help: the only effect is io; a &name entry names a borrow source
  var doubled = n * 2
}

// runes() and bytes() have no declaration to carry a row, so the built-in
// surface answers for itself, and it performs no io.
fn count(text: string): i32 !{} {
  var seen = 0
  for point in text.runes(heap()) {
    seen += 1
  }
  return seen
}

// A closure is held to the row it writes for itself. Calling one still
// contributes nothing to the caller: a row cannot travel with a function
// value until effect polymorphism.
fn closureRow() {
  var quiet = fn(n: i32) !{} {
    println(n)           //~ E0611 println does io, which the row does not name
  }
}

// The row that names what the body does checks clean.
fn loud(message: string) !{ io } {
  println("message: #{message}")
}
