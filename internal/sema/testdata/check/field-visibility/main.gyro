// A field is private unless it says otherwise, and a struct literal is
// only legal where every field is visible.

import { Config } from "./lib"

// `string` is a view, so handing a field back borrows the struct.
fn host(c: Config): string !{ &c } {
    return c.host
}

fn secret(c: Config): i32 {
    return c.secret //~ private to its module
}

fn literal(): Config {
    return Config{ host: "h", secret: 1 } //~ construct it with an associated function
}
