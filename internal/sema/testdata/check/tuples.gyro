import { println } from "stdlib"

fn access() {
    let pair = (200, "ok")
    let code: i32 = pair.0
    let text: string = pair.1
    let missing = pair.2 //~ no element 2
}

fn notATuple(x: i32) {
    let v = x.0 //~ needs a tuple
}

fn fallible(): (i32, error?) {
    return 0, null
}

fn twoValues(): (i32, bool) {
    return 0, true
}

fn destructuring() {
    let value, err = fallible()
    let v: i32 = value
    let a, b, c = twoValues() //~ has 2 elements, the declaration binds 3
}

fn destructuringNeedsATuple(x: i32) {
    let a, b = x //~ needs a tuple
}

fn assignability(ch: chan<(string, error?)>) {
    ch <- ("body", null)
}

fn badSend(ch: chan<(string, error?)>) {
    ch <- (1, null) //~ cannot use
}

// An element takes the type its position asks for, negation included.
fn negativeElement(): (i64, i64) {
    return (-1, 0)
}

fn negativeElementTooSmall(): (u8, i64) {
    return (-1, 0) //~ E0502 the literal -1 does not fit u8
}
