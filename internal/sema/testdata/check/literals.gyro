// Literals take their type from context, default to i32 and f64, and fold
// before they are checked against a width.

fn adaptToContext() {
    let h: u32 = 2166136261
    let b: u8[] = [104, 105]
    let f: f64 = 1
    let x: i8 = -128
}

fn defaultParameter(n: i64 = 4) {
}

fn mustFit() {
    let a: u8 = 300          //~ does not fit u8
    let b: i8 = -129         //~ does not fit i8
    let c: u8[] = [104, 300] //~ does not fit u8
    let d: i32 = 1.5         //~ a float literal cannot become i32
    let e: isize = -9223372036854775808
    let f: isize = 9223372036854775808 //~ does not fit isize
    let g: usize = -1                  //~ does not fit usize
}

fn constantsFold() {
    let ok: u8 = 200 + 55
    let over: u8 = 200 + 56 //~ does not fit u8
    let wide: u64 = 1 << 40
    let narrow: i32 = 1 << 40 //~ does not fit i32
    let zero = 1 / 0          //~ division by zero
}

// A shift whose count is a variable does not fold, so the context types
// the left operand directly and the operand itself is what must fit.
fn unfoldedOperands(n: u8, mask: u32) {
    let ok: u8 = 0xff >> n
    let over: u8 = 0x1ff >> n //~ does not fit u8
    let wide = mask & (0xffffffff >> n)
    let inverted = mask & ~0
}

fn want32(v: i32) {
}

fn want64(v: i64) {
}

fn wantFloat(v: f64) {
}

// An integer literal defaults to i32, a float literal to f64.
fn literalDefaults() {
    let x = 1
    want32(x)
    want64(x) //~ cannot use i32 as i64
    let f = 1.5
    wantFloat(f)
}

// The default is a type decision like any other, so the value has to fit
// it. Without a check the name would be an i32 holding what an i32 cannot.
fn defaultsMustFit() {
    let big = 3000000000            //~ does not fit i32
    let shifted = 1 << 40           //~ does not fit i32
    let pair = (1, 5000000000)      //~ does not fit i32
    let list = [1, 3000000000]      //~ does not fit i32
    let wrapped = 3000000000 as any //~ does not fit i32
    want32(3000000000)              //~ does not fit i32
    for i in 0..3000000000 {        //~ does not fit i32
    }

    // Annotating is how a wide literal is written.
    let wide: i64 = 3000000000
    want64(wide)
}

fn genericArg<T>(v: T): T {
    return v
}

// A generic parameter is inferred from the defaulted argument, so the
// literal is checked against i32 there too.
fn defaultsIntoGenerics() {
    let ok = genericArg(1)
    want32(ok)
    let over = genericArg(3000000000) //~ does not fit i32
}

fn typedValuesNeverConvert() {
    let a: i32 = 1
    let b: i64 = a //~ cannot use i32 as i64
    let c: u8 = 1
    let d: u16 = c //~ cannot use u8 as u16
    let e: f32 = 1.0
    let g: f64 = e //~ cannot use f32 as f64
}

fn otherLiterals() {
    let r: rune = 'a'
    let s: string = "hi"
    let b: bool = true
    let n: i32 = 'a' //~ cannot use rune as i32
}
