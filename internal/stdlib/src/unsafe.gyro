// unsafe. The operations the compiler cannot check, each an `unsafe fn`:
// calling one needs an unsafe fn or a safe fn around it (chapter 4.6).
//
// Gyro has no universe scope, so these had to come from some module, and
// naming it `unsafe` makes every file that uses them findable by its
// imports. A declaration with no body is a runtime or compiler intrinsic;
// one with a body is ordinary Gyro written over them.

// ---------------------------------------------------------------------------
// Pointers
// ---------------------------------------------------------------------------

// cast puts a type back on an address that forgot it. It is the program's
// claim that a T is what lives there, the same claim a C cast makes.
// Forgetting a type is `p as anyptr` and needs no claim.
export unsafe fn cast<T>(p: anyptr): *T !{}

// ptr_from_int makes a pointer from an integer, for an address the program
// did not get from an allocation: a device register, a page table. Nothing
// the borrow analysis can see says where it points, so it is treated as
// coming from outside the program, the way the result of a C function is.
export unsafe fn ptr_from_int<T>(address: usize): *T !{} {
    return cast<T>(address_to_pointer(address))
}

// ptr_to_int is the address a pointer holds, as an integer.
export unsafe fn ptr_to_int(p: anyptr): usize !{}

unsafe fn address_to_pointer(address: usize): anyptr !{}

// offset is the address `bytes` past base, which is how an arena says where
// each block it carves out of its buffer starts. Whether the result is
// still inside the object base pointed into is the caller's to know.
export unsafe fn offset(base: anyptr, bytes: usize): anyptr !{}

// copy_bytes copies `bytes` from one address to another. The ranges may
// overlap.
export unsafe fn copy_bytes(to: anyptr, from: anyptr, bytes: usize) !{}

// slice_from_raw views `len` values of T starting at p as a slice, which is
// how memory that arrives as an address and a length (a mapped buffer, an
// SDL surface) is written through. Nothing checks that the memory holds
// that many values or lives as long as the slice, so the result is treated
// as coming from outside the program, like ptr_from_int's.
export unsafe fn slice_from_raw<T>(p: anyptr, len: usize): T[] !{}

// A string is a header followed by its bytes in one block: a length of
// eight bytes, then the text (appendix E). Building one in a block an
// allocator gave out is three steps: ask how big the block must be, copy
// the bytes in after the header, and seal it with its length.
//
// text_size is the size of the block for `len` bytes.
export unsafe fn text_size(len: usize): usize !{} {
    return len + 8
}

// text_seal stamps the length on the block and answers it as a string. The
// block must hold at least text_size(len) bytes, and the string is the
// block itself, valid for as long as it is.
export unsafe fn text_seal(block: anyptr, len: usize): string !{}

// text_bytes views a string's bytes as a slice, without the copy `bytes`
// makes. A string is immutable and the slice is not, so nothing may write
// through it, and it is valid only as long as the string is.
export unsafe fn text_bytes(text: string): u8[] !{}

// ---------------------------------------------------------------------------
// The process heap
// ---------------------------------------------------------------------------

// The heap every allocator bottoms out in. These carry no row because they
// are the floor rather than the allocator: mem's heap() wraps them into
// one. A block is freed once, to the call that made it.
export unsafe fn raw_alloc(size: usize, align: usize): anyptr? !{}
export unsafe fn raw_free(pointer: anyptr) !{}
export unsafe fn raw_resize(pointer: anyptr, old_size: usize, size: usize, align: usize): anyptr? !{}

// ---------------------------------------------------------------------------
// Closures
// ---------------------------------------------------------------------------

// A closure's environment is a record in the frame that wrote it, and its
// first word is the record's size in bytes. env_of answers the address of a
// fn value's environment, null when it has none; with_env answers the same
// code over another. mem's keep and release are written over them.
export unsafe fn env_of<F>(f: F): anyptr? !{}
export unsafe fn with_env<F>(f: F, env: anyptr?): F !{}

// ---------------------------------------------------------------------------
// System calls
// ---------------------------------------------------------------------------

// syscallN asks the Linux kernel for call `number` with N arguments, each
// an integer, a bool or a pointer, and answers the kernel's raw result:
// zero or more on success, an error number negated on failure. Each
// argument keeps its own type, so a buffer goes in as the pointer it is.
// They are lowering's: each is one METALS syscall instruction.
export unsafe fn syscall0(number: usize): isize !{ io }
export unsafe fn syscall1<A>(number: usize, a: A): isize !{ io }
export unsafe fn syscall2<A, B>(number: usize, a: A, b: B): isize !{ io }
export unsafe fn syscall3<A, B, C>(number: usize, a: A, b: B, c: C): isize !{ io }
export unsafe fn syscall4<A, B, C, D>(number: usize, a: A, b: B, c: C, d: D): isize !{ io }
export unsafe fn syscall5<A, B, C, D, E>(number: usize, a: A, b: B, c: C, d: D, e: E): isize !{ io }
export unsafe fn syscall6<A, B, C, D, E, F>(number: usize, a: A, b: B, c: C, d: D, e: E, f: F): isize !{ io }
