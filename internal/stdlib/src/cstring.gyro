// cstring. C's text is a pointer to bytes that end at a NUL, and Gyro's is
// a length and its bytes, so a string cannot be handed to a C function as
// it is and a `char *` cannot be printed. These two functions are the
// whole crossing, written in Gyro over the unsafe module: nothing about
// them needs the runtime.
//
// A C header spells `const char *` as `*i8?`, a pointer that may be null.

import { Allocator } from "mem"
import { Array, from_utf8, bytes } from "stdlib"
import { cast, offset } from "unsafe"

// c_string copies text, and the NUL C wants after it, into an array from
// a. The array owns the bytes: c_data is the address to hand to C, and
// freeing the array ends it. A function that keeps the address past the
// call keeps a dangling one.
export fn c_string(a: Allocator, text: string): Array<u8> !{} {
  var out = Array<u8>::new(a)
  for byte in text.bytes(a) {
    out.push(byte)
  }
  out.push(0)
  return out
}

// c_data is the address of an array's first byte, as the `char *` C
// reads it as. It is unsafe because the address is good for as long as
// the array is, and nothing here says how long that is.
export unsafe fn c_data(bytes: Array<u8>): *i8 !{} {
  var view = bytes.slice()
  return cast<i8>(&view[0] as anyptr)
}

// from_c copies the bytes of a C string, up to its NUL, into a Gyro
// string made from a. A null pointer is the empty string, since a Gyro
// string is never absent. The bytes are the library's and it may reuse
// them on its next call, which is why this copies.
export unsafe fn from_c(a: Allocator, text: *i8?): string !{} {
  if text == null {
    return ""
  }
  var bytes = Array<u8>::new(a)
  var start = text as anyptr
  var at: usize = 0
  while true {
    var byte = *cast<u8>(offset(start, at))
    if byte == 0 {
      break
    }
    bytes.push(byte)
    at += 1
  }
  var out = from_utf8(a, bytes.slice())
  bytes.free()
  return out
}
