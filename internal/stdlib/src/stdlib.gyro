// stdlib. A declaration with no body is a runtime intrinsic; everything
// with a body is ordinary Gyro, compiled like any other module.

import { Allocator, Mode, heap, Format, alloc, free, size, panic, format } from "mem"
import { atomic_add, atomic_and, atomic_cas, atomic_fence, atomic_load, atomic_or, atomic_store, atomic_sub, atomic_swap, atomic_xor, cast, copy_bytes, futex_wait, futex_wake, offset, raw_alloc, slice_from_raw, syscall2, syscall3, text_bytes, text_seal, text_size } from "unsafe"
import { write as write_float } from "float"

export fn print<T: Print>(value: T) !{ io }
export fn println<T: Print>(value: T) !{ io }
export fn eprint<T: Print>(value: T) !{ io }
export fn eprintln<T: Print>(value: T) !{ io }

// The capabilities the language itself leans on. Each is an ordinary trait,
// and the compiler gives it a meaning by where it is declared: == and !=
// are Eq, the ordering operators are Ord, + - * / % and unary - are Add,
// Sub, Mul, Div, Rem and Neg, printing is Print, map keys are Eq and Hash,
// and for..in takes an Iterator. The numbers, strings, tuples and the
// rest of the built-in types implement them without any impl being written;
// a type a program declares implements one only by saying so, and
// `impl Eq for Point` with no block asks for the implementation built from
// its fields.

// Eq is ==. Two values are equal when the method says so.
export trait Eq {
    fn eq(self, other: Self): bool
}

// Hash folds a value to a number. Two values that are equal hash alike, so
// whoever writes an Eq by hand writes a Hash to match.
export trait Hash {
    fn hash(self): u64
}

// Print is how println and interpolation show a value. `to_string` is the
// hook that replaces the derived text; it is not for calling on a type
// parameter, since a number's text is made by the runtime and has nowhere
// to be allocated from.
export trait Print {
    fn to_string(self): string
}

// Ord is <, <=, > and >=. compare answers a negative number, zero or a
// positive one, and the operators are that answer against zero.
export trait Ord: Eq {
    fn compare(self, other: Self): i32
}

export trait Add {
    fn add(self, other: Self): Self
}

export trait Sub {
    fn sub(self, other: Self): Self
}

export trait Mul {
    fn mul(self, other: Self): Self
}

export trait Div {
    fn div(self, other: Self): Self
}

export trait Rem {
    fn rem(self, other: Self): Self
}

export trait Neg {
    fn neg(self): Self
}

// Iterator is what for..in walks: next hands back the following element and
// whether there was one.
export trait Iterator<T> {
    fn next(*self): (T, bool)
}

// Index is `value[i]`. at hands back the address of element i, which is
// what makes the index a place: `value[i] = x` writes through it and
// `&value[i]` is the address itself, as on an Array.
export trait Index<T> {
    fn at(*self, index: usize): *T
}

// A line is written piece by piece, so the output lock is held across
// all of them and two threads printing do not tear each other's lines.
// The lock is recursive: a to_string that prints takes it again.
fn lock_output() !{ io }
fn unlock_output() !{ io }

// ---------------------------------------------------------------------------
// Output
//
// Standard output is buffered: a print appends to a block and the block is
// written when it fills, when the program ends, when it panics or leaves
// through os::exit, before it waits on standard input, before it writes to
// standard error, and before a call into a C library, so that what a
// program prints appears in the order it printed it. On a terminal the
// buffer is also written at each newline, as C's stdio does. Standard error
// is written as it is printed, a call at a time.
//
// Printing a number writes its digits straight into the block, so printing
// allocates nothing. The leaves below are what lowering reaches for a
// scalar under print, println, eprint and eprintln: it widens the number,
// and says which stream and whether a newline follows.
// ---------------------------------------------------------------------------

struct Stream {
    fd: isize
    block: anyptr?
    len: usize
    capacity: usize
    line: bool
    started: bool
}

var stdout_stream = Stream{ fd: 1, block: null, len: 0, capacity: 32768, line: false, started: false }
var stderr_stream = Stream{ fd: 2, block: null, len: 0, capacity: 1024, line: false, started: false }

// set_flush_hook tells the C runtime what to call to write standard
// output out: when the program ends, when it panics, and before a call
// into a C library.
fn set_flush_hook(hook: code()) !{ io }

// stream_of picks the stream a leaf writes to.
safe fn stream_of(fd: i32): *Stream !{} {
    if fd == 2 {
        return &stderr_stream
    }
    return &stdout_stream
}

// write_raw writes every byte, going again after a short write or an
// interrupted call. A failure, a closed pipe among them, ends the write:
// there is nowhere to report it.
safe fn write_raw(fd: isize, from: anyptr, count: usize) !{ io } {
    var done: usize = 0
    while done < count {
        var put = syscall3(1, fd, offset(from, done), count - done)
        if put == -4 {
            continue
        }
        if put <= 0 {
            return
        }
        done += put as usize
    }
}

// base_of is the stream's block, once it has one.
safe fn base_of(s: *Stream): anyptr !{} {
    var block = s.block
    if block == null {
        panic("the output buffer was never made")
        return base_of(s)
    }
    return block
}

// begin makes the stream's block on first use, and for standard output
// finds out whether it is a terminal and registers the flush with the
// runtime.
safe fn begin(s: *Stream) !{ io } {
    if s.started {
        return
    }
    s.started = true
    var block = raw_alloc(s.capacity, 16)
    if block == null {
        panic("the output buffer could not be allocated")
        return
    }
    s.block = block
    if s.fd == 1 {
        // A terminal answers TCGETS, which writes a termios of 60 bytes.
        s.line = syscall3(16, 1, 21505, block) == 0
        set_flush_hook(&flush_output)
    }
}

safe fn flush_stream(s: *Stream) !{ io } {
    if s.len > 0 {
        var count = s.len
        s.len = 0
        write_raw(s.fd, base_of(s), count)
    }
}

// flush_output writes out what standard output holds.
export safe fn flush_output() !{ io } {
    lock_output()
    flush_stream(&stdout_stream)
    unlock_output()
}

// room leaves space for `need` more bytes in the block, which is at most
// its capacity, and answers where they go.
safe fn room(s: *Stream, need: usize): anyptr !{ io } {
    begin(s)
    if s.len + need > s.capacity {
        flush_stream(s)
    }
    return offset(base_of(s), s.len)
}

// settle ends a print: a terminal and standard error see it at once,
// and standard error is ordered after everything standard output holds.
safe fn settle(s: *Stream, newline: bool) !{ io } {
    if newline {
        *cast<u8>(room(s, 1)) = 10
        s.len += 1
    }
    if s.fd == 2 || (s.line && newline) {
        flush_stream(s)
    }
}

// open_stream takes the lock and orders standard error after standard
// output.
safe fn open_stream(fd: i32): *Stream !{ io } {
    lock_output()
    var s = stream_of(fd)
    if fd == 2 {
        flush_stream(&stdout_stream)
    }
    return s
}

safe fn put_text(text: string, fd: i32, newline: bool) !{ io } {
    var s = open_stream(fd)
    var bytes = text_bytes(text)
    var count = bytes.len()
    begin(s)
    if count > 0 {
        if s.len + count > s.capacity {
            flush_stream(s)
        }
        if count > s.capacity {
            write_raw(s.fd, &bytes[0] as anyptr, count)
        } else {
            copy_bytes(offset(base_of(s), s.len), &bytes[0] as anyptr, count)
            s.len += count
        }
        if s.line && !newline {
            for byte in bytes {
                if byte == 10 {
                    flush_stream(s)
                    break
                }
            }
        }
    }
    settle(s, newline)
    unlock_output()
}

// put_digits writes n in decimal ending just before `end`.
safe fn put_digits(at: anyptr, end: usize, n: u64) !{} {
    var place = end
    var rest = n
    while rest > 0 || place == end {
        place -= 1
        *cast<u8>(offset(at, place)) = 48 + (rest % 10) as u8
        rest /= 10
    }
}

safe fn put_uint(v: u64, fd: i32, newline: bool) !{ io } {
    var s = open_stream(fd)
    var at = room(s, 24)
    var count: usize = 1
    var rest = v
    while rest >= 10 {
        rest /= 10
        count += 1
    }
    put_digits(at, count, v)
    s.len += count
    settle(s, newline)
    unlock_output()
}

// put_int writes the magnitude of a negative number as one less than it
// is, plus one, so that the most negative value has a magnitude to write.
safe fn put_int(v: i64, fd: i32, newline: bool) !{ io } {
    if v >= 0 {
        put_uint(v as u64, fd, newline)
        return
    }
    var magnitude = ((0 - (v + 1)) as u64) + 1
    var s = open_stream(fd)
    var at = room(s, 24)
    *cast<u8>(at) = 45
    var count: usize = 1
    var rest = magnitude
    while rest >= 10 {
        rest /= 10
        count += 1
    }
    put_digits(at, count + 1, magnitude)
    s.len += count + 1
    settle(s, newline)
    unlock_output()
}

safe fn put_bool(v: bool, fd: i32, newline: bool) !{ io } {
    if v {
        put_text("true", fd, newline)
        return
    }
    put_text("false", fd, newline)
}

safe fn put_rune(v: rune, fd: i32, newline: bool) !{ io } {
    var s = open_stream(fd)
    var at = room(s, 4)
    var point = v as u32
    if point > 1114111 || (point >= 55296 && point <= 57343) {
        point = 65533
    }
    var count: usize = 4
    if point < 128 {
        count = 1
        *cast<u8>(at) = point as u8
    } elif point < 2048 {
        count = 2
        *cast<u8>(at) = (192 | (point >> 6)) as u8
        *cast<u8>(offset(at, 1)) = (128 | (point & 63)) as u8
    } elif point < 65536 {
        count = 3
        *cast<u8>(at) = (224 | (point >> 12)) as u8
        *cast<u8>(offset(at, 1)) = (128 | ((point >> 6) & 63)) as u8
        *cast<u8>(offset(at, 2)) = (128 | (point & 63)) as u8
    } else {
        *cast<u8>(at) = (240 | (point >> 18)) as u8
        *cast<u8>(offset(at, 1)) = (128 | ((point >> 12) & 63)) as u8
        *cast<u8>(offset(at, 2)) = (128 | ((point >> 6) & 63)) as u8
        *cast<u8>(offset(at, 3)) = (128 | (point & 63)) as u8
    }
    s.len += count
    settle(s, newline)
    unlock_output()
}

safe fn put_float(v: f64, fd: i32, newline: bool) !{ io } {
    var s = open_stream(fd)
    var at = room(s, 48)
    s.len += write_float(v, at)
    settle(s, newline)
    unlock_output()
}

fn stream_print(message: Format) !{ io } {
    lock_output()
    for i in 0..message.len() {
        print(message.piece(i))
    }
    unlock_output()
}

fn stream_println(message: Format) !{ io } {
    lock_output()
    for i in 0..message.len() {
        print(message.piece(i))
    }
    println("")
    unlock_output()
}

fn stream_eprint(message: Format) !{ io } {
    lock_output()
    for i in 0..message.len() {
        eprint(message.piece(i))
    }
    unlock_output()
}

fn stream_eprintln(message: Format) !{ io } {
    lock_output()
    for i in 0..message.len() {
        eprint(message.piece(i))
    }
    eprintln("")
    unlock_output()
}

// Array<T> owns its elements, in contrast to the borrowed view T[]. It is
// made with an allocator and records it: every block it owns, its header
// and its buffer, comes from that allocator, push grows the buffer through
// it, and free hands the buffer back to it. Nothing else names an
// allocator, so an array cannot be freed to one it did not come from.
//
// An Array is a handle: a pointer to a header, so a copy of the value is
// the same array, and a method that takes `*self` changes what every copy
// sees. The header stays allocated after free, which is how a second free
// or a use after free is caught rather than read through.
struct ArrayHead<T> {
    // The buffer, or while there is none the header itself, which a view of
    // no elements may start at.
    data: anyptr
    count: usize
    capacity: usize
    // The capacity with_capacity asked for, used at the first growth.
    hint: usize
    freed: bool
    // Where every block this array owns comes from.
    alloc: Allocator
}

export struct Array<T> {
    head: *ArrayHead<T>
}

export safe fn Array<T>::new(a: Allocator): Array<T> !{ &a } {
    var head = alloc<ArrayHead<T>>(a)
    head.data = head as anyptr
    head.alloc = a
    return Array<T>{ head: head }
}

export safe fn Array<T>::with_capacity(a: Allocator, capacity: usize): Array<T> !{ &a } {
    var out = Array<T>::new(a)
    out.head.hint = capacity
    return out
}

// The accessors below are written flat, with the element reached by one
// comparison and one address computation: a call that did more would be
// paid on every element of every loop. The byte offset is a wrapping
// product because the comparison has already kept the index inside a buffer
// that exists, and a checked multiply is a slower instruction.

// out_of_range is the abort for an index past the end, kept out of line so
// that the accessors carry only the comparison.
fn out_of_range(index: usize, count: usize) !{} {
    panic(format(heap(), "index #{index} out of range for length #{count}"))
}

// array_grow makes room for one more element: eight, or what with_capacity
// asked for, and then twice what there is.
safe fn array_grow<T>(head: *ArrayHead<T>) !{} {
    var grown = head.capacity * 2
    if head.capacity == 0 {
        grown = 8
        if head.hint > 8 {
            grown = head.hint
        }
    }
    var old: anyptr? = null
    if head.capacity > 0 {
        old = head.data
    }
    var block = head.alloc.proc(head.alloc.data, Mode::Resize, grown * size<T>(), 16, old, head.capacity * size<T>())
    if block == null {
        panic(format(heap(), "allocation of #{grown * size<T>()} bytes failed"))
    }
    head.data = block
    head.capacity = grown
}

export safe fn Array<T>::push(*self, value: T) !{} {
    var head = self.head
    if head.freed {
        panic("use after free of an Array")
    }
    var at = head.count
    if at == head.capacity {
        array_grow(head)
    }
    *cast<T>(offset(head.data, at *% size<T>())) = value
    head.count = at +% 1
}

// pop on an empty array answers a zeroed element and false: Gyro has no
// value to put there, so the element is read out of a block the allocator
// zero-filled.
export safe fn Array<T>::pop(*self): (T, bool) !{} {
    var head = self.head
    if head.freed {
        panic("use after free of an Array")
    }
    if head.count == 0 {
        var blank = alloc<T>(head.alloc)
        var out = *blank
        free(head.alloc, blank)
        return (out, false)
    }
    head.count -= 1
    return (*cast<T>(offset(head.data, head.count *% size<T>())), true)
}

export safe fn Array<T>::get(self, index: usize): T !{} {
    var head = self.head
    if head.freed {
        panic("use after free of an Array")
    }
    var count = head.count
    if index >= count {
        out_of_range(index, count)
    }
    return *cast<T>(offset(head.data, index *% size<T>()))
}

export safe fn Array<T>::set(*self, index: usize, value: T) !{} {
    var head = self.head
    if head.freed {
        panic("use after free of an Array")
    }
    var count = head.count
    if index >= count {
        out_of_range(index, count)
    }
    *cast<T>(offset(head.data, index *% size<T>())) = value
}

// The element's own address, bounds-checked. `xs[i]` lowers through it,
// which is what makes an index a place rather than a copy — `get` hands
// back a value and mutating that mutates nothing. The address is into
// the array's buffer, so `push` may move it, exactly as in C.
export safe fn Array<T>::at(self, index: usize): *T !{} {
    var head = self.head
    if head.freed {
        panic("use after free of an Array")
    }
    var count = head.count
    if index >= count {
        out_of_range(index, count)
    }
    return cast<T>(offset(head.data, index *% size<T>()))
}

export safe fn Array<T>::len(self): usize !{} {
    var head = self.head
    if head.freed {
        panic("use after free of an Array")
    }
    return head.count
}

export safe fn Array<T>::slice(self): T[] !{ &self } {
    var head = self.head
    if head.freed {
        panic("use after free of an Array")
    }
    return slice_from_raw<T>(head.data, head.count)
}

export safe fn Array<T>::free(*self) !{} {
    var head = self.head
    if head.freed {
        panic("double free of an Array")
    }
    head.freed = true
    if head.capacity > 0 {
        head.alloc.proc(head.alloc.data, Mode::Free, 0, 0, head.data, head.capacity * size<T>())
    }
    head.data = head as anyptr
}

export fn Array<T>::is_empty(self): bool !{} {
    return self.len() == 0
}

// from_utf8 reads a byte slice as text, and `bytes` is the other
// direction. Both copy into a block from the allocator they are handed, so
// each result owns what it holds, which is why neither carries a borrow
// row. runes decodes into code points, which are wider than the bytes
// they come from.
//
// The block is asked for a byte more than it holds, as every block of
// bytes here is, so that a view of it never points one past its end.
export safe fn from_utf8(a: Allocator, bytes: u8[]): string !{ &a } {
    var block = a.proc(a.data, Mode::Alloc, text_size(bytes.len() + 1), 16, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{text_size(bytes.len() + 1)} bytes failed"))
    }
    if bytes.len() > 0 {
        copy_bytes(offset(block, text_size(0)), &bytes[0] as anyptr, bytes.len())
    }
    return text_seal(block, bytes.len())
}

export safe fn string::bytes(self, a: Allocator): u8[] !{ &a } {
    var view = view_bytes(self)
    var block = a.proc(a.data, Mode::Alloc, view.len() + 1, 16, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{view.len() + 1} bytes failed"))
    }
    if view.len() > 0 {
        copy_bytes(block, &view[0] as anyptr, view.len())
    }
    return slice_from_raw<u8>(block, view.len())
}

// continuation is true for a byte of the form 10xxxxxx.
fn continuation(byte: u8): bool {
    return (byte & 192) == 128
}

// runes decodes UTF-8, and an invalid sequence yields U+FFFD and consumes
// one byte: a stray continuation byte, a lead byte missing its followers,
// an overlong form, a surrogate, or a value past U+10FFFF.
export safe fn string::runes(self, a: Allocator): rune[] !{ &a } {
    var view = view_bytes(self)
    var block = a.proc(a.data, Mode::Alloc, view.len() * 4 + 4, 16, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{view.len() * 4 + 4} bytes failed"))
    }
    var count: usize = 0
    var i: usize = 0
    while i < view.len() {
        var lead = view[i] as u32
        var point: u32 = 65533
        var size: usize = 1
        if lead < 128 {
            point = lead
        } elif (lead & 224) == 192 && i + 1 < view.len() && continuation(view[i + 1]) {
            var got = ((lead & 31) << 6) | ((view[i + 1] as u32) & 63)
            if got >= 128 {
                point = got
                size = 2
            }
        } elif (lead & 240) == 224 && i + 2 < view.len() && continuation(view[i + 1]) && continuation(view[i + 2]) {
            var got = ((lead & 15) << 12) | (((view[i + 1] as u32) & 63) << 6) | ((view[i + 2] as u32) & 63)
            if got >= 2048 && (got < 55296 || got > 57343) {
                point = got
                size = 3
            }
        } elif (lead & 248) == 240 && i + 3 < view.len() && continuation(view[i + 1]) && continuation(view[i + 2]) && continuation(view[i + 3]) {
            var got = ((lead & 7) << 18) | (((view[i + 1] as u32) & 63) << 12) | (((view[i + 2] as u32) & 63) << 6) | ((view[i + 3] as u32) & 63)
            if got >= 65536 && got <= 1114111 {
                point = got
                size = 4
            }
        }
        *cast<rune>(offset(block, count * 4)) = point as rune
        count += 1
        i += size
    }
    return slice_from_raw<rune>(block, count)
}

// String owns its bytes, in contrast to the borrowed view `string`. It is
// the builder: append to it, then read it back with `text()`.
//
// Everything below this line is ordinary Gyro. The only things the
// runtime supplies are Array<T>, from_utf8 and the `bytes` and `runes`
// methods on string; the builder and the text helpers are written in the
// language they serve.
//
// A String records the allocator it was made with, beside the one its
// bytes record, so appending can copy the text it reads from the same one.
export struct String {
    bytes: Array<u8>
    alloc: Allocator
}

export fn String::new(a: Allocator): String !{ &a } {
    return String{ bytes: Array<u8>::new(a), alloc: a }
}

export fn String::with_capacity(a: Allocator, capacity: usize): String !{ &a } {
    return String{ bytes: Array<u8>::with_capacity(a, capacity), alloc: a }
}

export fn String::of(a: Allocator, text: string): String !{ &a } {
    var out = String::new(a)
    out.push(text)
    return out
}

export fn String::push(*self, text: string) !{} {
    for byte in text.bytes(self.alloc) {
        self.bytes.push(byte)
    }
}

// push_rune encodes one code point as UTF-8. The four cases are the four
// lengths; a surrogate or an out-of-range value becomes U+FFFD, matching
// what runes() produces for an invalid sequence.
export fn String::push_rune(*self, value: rune) !{} {
    var point = value as u32
    if point > 1114111 || (point >= 55296 && point <= 57343) {
        point = 65533
    }

    if point < 128 {
        self.bytes.push(point as u8)
        return
    }
    if point < 2048 {
        self.bytes.push((192 | (point >> 6)) as u8)
        self.bytes.push((128 | (point & 63)) as u8)
        return
    }
    if point < 65536 {
        self.bytes.push((224 | (point >> 12)) as u8)
        self.bytes.push((128 | ((point >> 6) & 63)) as u8)
        self.bytes.push((128 | (point & 63)) as u8)
        return
    }
    self.bytes.push((240 | (point >> 18)) as u8)
    self.bytes.push((128 | ((point >> 12) & 63)) as u8)
    self.bytes.push((128 | ((point >> 6) & 63)) as u8)
    self.bytes.push((128 | (point & 63)) as u8)
}

export fn String::len(self): usize !{} {
    return self.bytes.len()
}

export fn String::text(self, a: Allocator): string !{ &a } {
    return from_utf8(a, self.bytes.slice())
}

// to_string is what printing calls on its own behalf, where no allocator
// was chosen, so the text comes from the process heap.
export fn String::to_string(self): string !{} {
    return self.text(heap())
}

export fn String::free(*self) !{} {
    self.bytes.free()
}

// ---------------------------------------------------------------------------
// Text
//
// These extend the built-in `string`, so they are spelled the way the
// compiler's own surface is: `line.trim()`, not `trim(line)`. An
// extension is an ordinary name — it must be imported to be callable,
// which is what keeps it out of universe scope.
// ---------------------------------------------------------------------------

// slice_at reports whether needle sits at `at` in haystack.
fn slice_at(haystack: u8[], needle: u8[], at: usize): bool {
    if at + needle.len() > haystack.len() {
        return false
    }
    for var i: usize = 0; i < needle.len(); i += 1 {
        if haystack[at + i] != needle[i] {
            return false
        }
    }
    return true
}

// view_bytes is a string's bytes as a slice, without the copy `bytes`
// makes. The view borrows the string, which is immutable, so the
// predicates below read through it and allocate nothing. It is private: a
// caller that wants bytes it can write to asks `bytes` for a copy.
safe fn view_bytes(text: string): u8[] !{} {
    return text_bytes(text)
}

export fn string::starts_with(self, prefix: string): bool !{} {
    return slice_at(view_bytes(self), view_bytes(prefix), 0)
}

export fn string::ends_with(self, suffix: string): bool !{} {
    var body = view_bytes(self)
    var tail = view_bytes(suffix)
    if tail.len() > body.len() {
        return false
    }
    return slice_at(body, tail, body.len() - tail.len())
}

// index_of returns the byte offset of the first match, or null.
export fn string::index_of(self, needle: string): usize? !{} {
    var body = view_bytes(self)
    var want = view_bytes(needle)
    if want.len() > body.len() {
        return null
    }
    for var at: usize = 0; at + want.len() <= body.len(); at += 1 {
        if slice_at(body, want, at) {
            return at
        }
    }
    return null
}

export fn string::contains(self, needle: string): bool !{} {
    return self.index_of(needle) != null
}

// substring takes the half-open byte range [from, to). It does not
// validate that the ends fall on rune boundaries.
export fn string::substring(self, a: Allocator, from: usize, to: usize): string !{ &a } {
    var body = self.bytes(a)
    var out = String::new(a)
    var stop = to
    if stop > body.len() {
        stop = body.len()
    }
    for var i = from; i < stop; i += 1 {
        out.bytes.push(body[i])
    }
    var result = out.text(a)
    out.free()
    return result
}

fn is_space(byte: u8): bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13
}

export fn string::trim(self, a: Allocator): string !{ &a } {
    var body = self.bytes(a)
    var start: usize = 0
    while start < body.len() && is_space(body[start]) {
        start += 1
    }
    var stop = body.len()
    while stop > start && is_space(body[stop - 1]) {
        stop -= 1
    }
    return self.substring(a, start, stop)
}

// split cuts on every occurrence of sep. An empty sep would not advance,
// so it yields the whole text unsplit.
export fn string::split(self, a: Allocator, sep: string): Array<string> !{ &a } {
    var parts = Array<string>::new(a)
    if sep.len() == 0 {
        parts.push(self.substring(a, 0, self.len()))
        return parts
    }

    var body = self.bytes(a)
    var want = sep.bytes(a)
    var start: usize = 0
    var at: usize = 0
    while at + want.len() <= body.len() {
        if slice_at(body, want, at) {
            parts.push(self.substring(a, start, at))
            at += want.len()
            start = at
            continue
        }
        at += 1
    }
    parts.push(self.substring(a, start, body.len()))
    return parts
}

// join stays a function: its receiver would be the slice, not a string,
// and `string[]` is not a type an extension can name.
export fn join(a: Allocator, parts: string[], sep: string): string !{ &a } {
    var out = String::new(a)
    var first = true
    for part in parts {
        if !first {
            out.push(sep)
        }
        out.push(part)
        first = false
    }
    var result = out.text(a)
    out.free()
    return result
}

export fn string::repeat(self, a: Allocator, times: i32): string !{ &a } {
    var out = String::new(a)
    for i in 0..times {
        out.push(self)
    }
    var result = out.text(a)
    out.free()
    return result
}

// ---------------------------------------------------------------------------
// Map
//
// A hash map in ordinary Gyro over Array<T>; the runtime supplies only
// the buffer. Chaining rather than open addressing: Gyro has no zero
// values, so an empty probe slot would need a fabricated key to occupy
// it, while an empty bucket needs nothing.
// ---------------------------------------------------------------------------

// Map<K, V> hashes with the same derived hash() that == uses, so any key
// that compares can be stored, and two keys that compare equal land in
// one bucket. An optional V is allowed: optionals do not nest, so get()
// answers null both for a miss and for a stored null, and contains() is
// what separates the two.
//
// A Map records the allocator it was made with, as an Array does, and
// every bucket and every grown table comes from it.
export struct Map<K: Eq & Hash, V> {
    buckets: Array<Array<(K, V)>>
    count: usize
    alloc: Allocator
}

// bucket_index folds a hash onto a bucket count. The count is never zero:
// new() starts with eight buckets and grow() only doubles.
fn bucket_index(hash: u64, buckets: usize): usize {
    return (hash % (buckets as u64)) as usize
}

fn empty_buckets<K, V>(a: Allocator, count: usize): Array<Array<(K, V)>> {
    var buckets = Array<Array<(K, V)>>::with_capacity(a, count)
    for i in 0..count {
        buckets.push(Array<(K, V)>::new(a))
    }
    return buckets
}

export fn Map<K, V>::new(a: Allocator): Map<K, V> !{ &a } {
    return Map<K, V>{ buckets: empty_buckets<K, V>(a, 8), count: 0, alloc: a }
}

fn Map<K, V>::bucket_of(self, key: K): Array<(K, V)> {
    return self.buckets.get(bucket_index(key.hash(), self.buckets.len()))
}

// grow doubles the bucket count and redistributes every entry. Insertion
// order within a bucket is not part of the contract; the walk order here
// is still deterministic, so every tier agrees byte for byte.
fn Map<K, V>::grow(*self) {
    var wider = empty_buckets<K, V>(self.alloc, self.buckets.len() * 2)
    for i in 0..self.buckets.len() {
        var bucket = self.buckets.get(i)
        for at in 0..bucket.len() {
            var entry = bucket.get(at)
            var home = wider.get(bucket_index(entry.0.hash(), wider.len()))
            home.push(entry)
        }
        bucket.free()
    }
    self.buckets.free()
    self.buckets = wider
}

// insert adds the pair, replacing the value (and the stored key) when an
// equal key is already present.
export fn Map<K, V>::insert(*self, key: K, value: V) !{} {
    var bucket = self.bucket_of(key)
    for i in 0..bucket.len() {
        if bucket.get(i).0 == key {
            bucket.set(i, (key, value))
            return
        }
    }
    if self.count >= self.buckets.len() * 2 {
        self.grow()
        bucket = self.bucket_of(key)
    }
    bucket.push((key, value))
    self.count += 1
}

export fn Map<K, V>::get(self, key: K): V? !{} {
    var bucket = self.bucket_of(key)
    for i in 0..bucket.len() {
        var entry = bucket.get(i)
        if entry.0 == key {
            return entry.1
        }
    }
    return null
}

export fn Map<K, V>::contains(self, key: K): bool !{} {
    var bucket = self.bucket_of(key)
    for i in 0..bucket.len() {
        if bucket.get(i).0 == key {
            return true
        }
    }
    return false
}

// remove takes the entry out by swapping the last one into its place,
// and reports whether the key was present.
export fn Map<K, V>::remove(*self, key: K): bool !{} {
    var bucket = self.bucket_of(key)
    for i in 0..bucket.len() {
        if bucket.get(i).0 == key {
            bucket.set(i, bucket.get(bucket.len() - 1))
            var _, _ = bucket.pop()
            self.count -= 1
            return true
        }
    }
    return false
}

export fn Map<K, V>::len(self): usize !{} {
    return self.count
}

export fn Map<K, V>::is_empty(self): bool !{} {
    return self.count == 0
}

// keys snapshots the keys into a fresh array, from the map's allocator,
// that the caller frees. The order
// follows the buckets: deterministic, but not insertion order.
export fn Map<K, V>::keys(self): Array<K> !{} {
    var out = Array<K>::with_capacity(self.alloc, self.count)
    for i in 0..self.buckets.len() {
        var bucket = self.buckets.get(i)
        for at in 0..bucket.len() {
            out.push(bucket.get(at).0)
        }
    }
    return out
}

export fn Map<K, V>::free(*self) !{} {
    for i in 0..self.buckets.len() {
        self.buckets.get(i).free()
    }
    self.buckets.free()
    self.count = 0
}

// A lock over one u32: 0 is free, 1 is held, and 2 is held with a thread
// asleep on it. Only the last unlock that finds a 2 pays for a system call,
// so a lock nobody waits for is two atomic instructions.
safe fn lock_word(word: *u32) !{} {
    var seen = atomic_cas(word, 0, 1)
    if seen == 0 {
        return
    }
    if seen != 2 {
        seen = atomic_swap(word, 2)
    }
    while seen != 0 {
        futex_wait(word, 2)
        seen = atomic_swap(word, 2)
    }
}

safe fn unlock_word(word: *u32) !{} {
    if atomic_sub(word, 1) != 1 {
        atomic_store(word, 0)
        futex_wake(word, 1)
    }
}

// Mutex<T> owns the value it guards; lock() returns the guard directly.
// There is no poisoning: a panic aborts the whole process, so no thread
// ever observes a lock its holder abandoned.
//
// A Mutex is a handle, as an Array is: a pointer to the lock and the value,
// so a copy is the same mutex, which is how a closure carries one to
// another thread.
//
// The epoch counts acquisitions and releases, so it is odd while the lock
// is held. A guard remembers the epoch its lock made, and is good for
// exactly as long as the mutex still has it: after unlock the guard is
// stale, and every use of it says so.
struct MutexHead<T> {
    word: u32
    epoch: u64
    value: T
}

export struct Mutex<T> {
    head: *MutexHead<T>
}

export safe fn Mutex<T>::new(value: T): Mutex<T> !{} {
    var head = alloc<MutexHead<T>>(heap())
    head.value = value
    return Mutex<T>{ head: head }
}

export safe fn Mutex<T>::lock(*self): MutexGuard<T> !{} {
    var head = self.head
    lock_word(&head.word)
    head.epoch = head.epoch + 1
    return MutexGuard<T>{ head: head, epoch: head.epoch }
}

export struct MutexGuard<T> {
    head: *MutexHead<T>
    epoch: u64
}

export safe fn MutexGuard<T>::get(self): T !{} {
    if self.head.epoch != self.epoch {
        panic("the guard was already unlocked")
    }
    return self.head.value
}

export safe fn MutexGuard<T>::set(*self, value: T) !{} {
    if self.head.epoch != self.epoch {
        panic("the guard was already unlocked")
    }
    self.head.value = value
}

// Release is explicit until a drop-based design is settled; pair lock()
// with `defer guard.unlock()`.
export safe fn MutexGuard<T>::unlock(*self) !{} {
    if self.head.epoch != self.epoch {
        panic("the guard was already unlocked")
    }
    self.head.epoch = self.epoch + 1
    unlock_word(&self.head.word)
}

// Atomic<T> is a cell that threads reach at the same moment without a lock.
// T is an integer of 8 to 64 bits, a bool or a pointer. Every operation is
// seen by every thread in one order and nothing moves across it, so there is
// no ordering to choose.
//
// The cell is the value, stored where the Atomic is: a thread shares one the
// way it shares any memory, by pointer, and the race warning
// ([chapter 13.1](ch13-01-threads.md)) leaves a pointer to an Atomic alone.
// Copying an Atomic copies the number it holds at that moment, not the
// cell.
export struct Atomic<T: Eq> {
    value: T
}

export fn Atomic<T>::new(value: T): Atomic<T> !{} {
    return Atomic<T>{ value: value }
}

export safe fn Atomic<T>::load(*self): T !{} {
    return atomic_load(&self.value)
}

export safe fn Atomic<T>::store(*self, value: T) !{} {
    atomic_store(&self.value, value)
}

// swap stores value and answers what the cell held.
export safe fn Atomic<T>::swap(*self, value: T): T !{} {
    return atomic_swap(&self.value, value)
}

// compare_and_swap stores desired when the cell holds expected, and answers
// whether it did.
export safe fn Atomic<T>::compare_and_swap(*self, expected: T, desired: T): bool !{} {
    return atomic_cas(&self.value, expected, desired) == expected
}

// The fetch operations store the result of the arithmetic and answer what the
// cell held before. They wrap, and they are for integers.
export safe fn Atomic<T>::fetch_add(*self, value: T): T !{} {
    return atomic_add(&self.value, value)
}

export safe fn Atomic<T>::fetch_sub(*self, value: T): T !{} {
    return atomic_sub(&self.value, value)
}

export safe fn Atomic<T>::fetch_and(*self, value: T): T !{} {
    return atomic_and(&self.value, value)
}

export safe fn Atomic<T>::fetch_or(*self, value: T): T !{} {
    return atomic_or(&self.value, value)
}

export safe fn Atomic<T>::fetch_xor(*self, value: T): T !{} {
    return atomic_xor(&self.value, value)
}

// fence keeps every atomic operation before it from being seen after any
// operation following it.
export safe fn fence() !{} {
    atomic_fence()
}

// ---------------------------------------------------------------------------
// Channels
// ---------------------------------------------------------------------------

// A chan<T> is an address of one of these, and its operations are the
// functions below, which lowering calls for `<-`, `close`, `for..in` and
// `select`. A channel holds the bytes of its elements and no more: the
// element's size is all it knows of T, and lowering passes each element as
// the address of a cell in the caller's frame.
//
// A buffered channel is a ring of `capacity` elements. Capacity 0 is a true
// rendezvous: the sender puts its element in the one slot and waits until a
// receiver has taken that very one, which the two tickets say.
//
// The lock is a futex word and the two conditions are counters threads
// sleep on: a thread that must wait for the other side reads the counter
// under the lock, lets go of the lock and sleeps until the counter has moved
// from what it read, so a wake-up between the two is not lost. A condition
// also counts the threads asleep on it, so that signalling one nobody waits
// on costs no system call.
struct Cond {
    // seq moves each time the condition is signalled; a sleeper sleeps while
    // it is what it read.
    seq: u32
    waiters: u32
}

struct Chan {
    lock: u32
    // senders and receivers are the conditions: signalled when room is made
    // and when an element arrives.
    senders: Cond
    receivers: Cond
    buffer: anyptr
    elem: usize
    capacity: usize
    count: usize
    head: usize
    closed: bool
    // The rendezvous slot: whether it holds an element, how many receivers
    // are asleep waiting for one, and the tickets of the last element put
    // in and of the last one taken out.
    full: bool
    waiting: usize
    placed: i64
    taken: i64
}

// cond_wait and cond_notify are called with the channel's lock held, which
// is what makes the plain reads and writes of `waiters` safe; only the
// sequence word is shared with the sleepers.
safe fn cond_wait(condition: *Cond, lock: *u32) !{} {
    condition.waiters += 1
    var seen = atomic_load(&condition.seq)
    unlock_word(lock)
    futex_wait(&condition.seq, seen)
    lock_word(lock)
    condition.waiters -= 1
}

// cond_notify moves the sequence word if anyone is asleep on the condition
// and answers how many to wake, 0 if nobody. The wake-up itself is the
// caller's, once it has let go of the lock, through cond_wake: a thread woken
// while the lock is still held only goes back to sleep on it.
safe fn cond_notify(condition: *Cond, count: u32): u32 !{} {
    if condition.waiters == 0 {
        return 0
    }
    var _ = atomic_add(&condition.seq, 1)
    return count
}

safe fn cond_wake(condition: *Cond, count: u32) !{} {
    if count > 0 {
        futex_wake(&condition.seq, count)
    }
}

// One and every are how many threads a notification wakes.
const ONE: u32 = 1
const EVERY: u32 = 2147483647

// chan_new makes a channel of `capacity` elements of `elem` bytes each.
safe fn chan_new(capacity: usize, elem: usize): anyptr !{} {
    var block = raw_alloc(size<Chan>(), 16)
    if block == null {
        panic("allocation of a channel failed")
    }
    var ch = cast<Chan>(block)
    ch.elem = elem
    ch.capacity = capacity
    var slots = capacity
    if slots == 0 {
        slots = 1
    }
    var buffer = raw_alloc(slots * elem, 16)
    if buffer == null {
        panic("allocation of a channel failed")
    }
    ch.buffer = buffer
    return block
}

// chan_put and chan_take move an element between the caller's cell and the
// ring, with the lock held.
safe fn chan_put(ch: *Chan, value: anyptr) !{} {
    // head and count are each below the capacity, so one subtraction wraps.
    var at = ch.head +% ch.count
    if at >= ch.capacity {
        at -= ch.capacity
    }
    copy_bytes(offset(ch.buffer, at *% ch.elem), value, ch.elem)
    ch.count += 1
}

safe fn chan_take(ch: *Chan, out: anyptr) !{} {
    var at = ch.head
    copy_bytes(out, offset(ch.buffer, at *% ch.elem), ch.elem)
    at += 1
    if at == ch.capacity {
        at = 0
    }
    ch.head = at
    ch.count -= 1
}

safe fn chan_send(raw: anyptr, value: anyptr) !{} {
    var ch = cast<Chan>(raw)
    lock_word(&ch.lock)
    if ch.capacity > 0 {
        while ch.count == ch.capacity && !ch.closed {
            cond_wait(&ch.senders, &ch.lock)
        }
        if ch.closed {
            unlock_word(&ch.lock)
            panic("send on a closed channel")
        }
        chan_put(ch, value)
        var wake = cond_notify(&ch.receivers, ONE)
        unlock_word(&ch.lock)
        cond_wake(&ch.receivers, wake)
        return
    }

    while ch.full && !ch.closed {
        cond_wait(&ch.senders, &ch.lock)
    }
    if ch.closed {
        unlock_word(&ch.lock)
        panic("send on a closed channel")
    }
    copy_bytes(ch.buffer, value, ch.elem)
    ch.full = true
    ch.placed += 1
    var ticket = ch.placed
    var wake = cond_notify(&ch.receivers, EVERY)
    if wake > 0 {
        // The receivers have to be able to take the lock to answer.
        unlock_word(&ch.lock)
        cond_wake(&ch.receivers, wake)
        lock_word(&ch.lock)
    }
    while ch.taken < ticket && !ch.closed {
        cond_wait(&ch.senders, &ch.lock)
    }
    if ch.taken < ticket {
        unlock_word(&ch.lock)
        panic("send on a closed channel")
    }
    unlock_word(&ch.lock)
}

// chan_recv waits for an element and writes it to `out`, answering true.
// When the channel is closed and drained it answers false and leaves `out`
// as the caller zeroed it.
safe fn chan_recv(raw: anyptr, out: anyptr): bool !{} {
    var ch = cast<Chan>(raw)
    lock_word(&ch.lock)
    if ch.capacity > 0 {
        while ch.count == 0 && !ch.closed {
            cond_wait(&ch.receivers, &ch.lock)
        }
        if ch.count == 0 {
            unlock_word(&ch.lock)
            return false
        }
        chan_take(ch, out)
        var wake = cond_notify(&ch.senders, ONE)
        unlock_word(&ch.lock)
        cond_wake(&ch.senders, wake)
        return true
    }

    ch.waiting += 1
    while !ch.full && !ch.closed {
        cond_wait(&ch.receivers, &ch.lock)
    }
    ch.waiting -= 1
    if !ch.full {
        unlock_word(&ch.lock)
        return false
    }
    copy_bytes(out, ch.buffer, ch.elem)
    ch.full = false
    ch.taken += 1
    var wake = cond_notify(&ch.senders, EVERY)
    unlock_word(&ch.lock)
    cond_wake(&ch.senders, wake)
    return true
}

safe fn chan_close(raw: anyptr) !{} {
    var ch = cast<Chan>(raw)
    lock_word(&ch.lock)
    if ch.closed {
        unlock_word(&ch.lock)
        panic("close of a closed channel")
    }
    ch.closed = true
    var wakeSenders = cond_notify(&ch.senders, EVERY)
    var wakeReceivers = cond_notify(&ch.receivers, EVERY)
    unlock_word(&ch.lock)
    cond_wake(&ch.senders, wakeSenders)
    cond_wake(&ch.receivers, wakeReceivers)
}

// chan_try_send sends if it can without waiting, and answers whether it
// did. An unbuffered channel can only be sent to while a receiver is
// asleep waiting and the slot is free.
safe fn chan_try_send(raw: anyptr, value: anyptr): bool !{} {
    var ch = cast<Chan>(raw)
    lock_word(&ch.lock)
    if ch.closed {
        unlock_word(&ch.lock)
        panic("send on a closed channel")
    }
    if ch.capacity > 0 {
        if ch.count == ch.capacity {
            unlock_word(&ch.lock)
            return false
        }
        chan_put(ch, value)
        var wake = cond_notify(&ch.receivers, ONE)
        unlock_word(&ch.lock)
        cond_wake(&ch.receivers, wake)
        return true
    }
    if ch.waiting == 0 || ch.full {
        unlock_word(&ch.lock)
        return false
    }
    copy_bytes(ch.buffer, value, ch.elem)
    ch.full = true
    ch.placed += 1
    var wake = cond_notify(&ch.receivers, EVERY)
    unlock_word(&ch.lock)
    cond_wake(&ch.receivers, wake)
    return true
}

// chan_try_recv receives if it can without waiting. It answers true when
// it wrote an element, and also when the channel is closed and drained,
// which a select takes as a receive that happens: the cell stays as the
// caller zeroed it.
safe fn chan_try_recv(raw: anyptr, out: anyptr): bool !{} {
    var ch = cast<Chan>(raw)
    lock_word(&ch.lock)
    if ch.capacity > 0 {
        if ch.count > 0 {
            chan_take(ch, out)
            var wake = cond_notify(&ch.senders, ONE)
            unlock_word(&ch.lock)
            cond_wake(&ch.senders, wake)
            return true
        }
        var fired = ch.closed
        unlock_word(&ch.lock)
        return fired
    }
    if ch.full {
        copy_bytes(out, ch.buffer, ch.elem)
        ch.full = false
        ch.taken += 1
        var wake = cond_notify(&ch.senders, EVERY)
        unlock_word(&ch.lock)
        cond_wake(&ch.senders, wake)
        return true
    }
    var fired = ch.closed
    unlock_word(&ch.lock)
    return fired
}

// select_pause is what a select with nothing ready does before it looks
// again: it sleeps a moment.
safe fn select_pause() !{ io } {
    var span: i64[2] = [0, 200000]
    var _ = syscall2(35, &span[0], 0)
}
