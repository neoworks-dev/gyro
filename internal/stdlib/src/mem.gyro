// mem. A declaration with no body is a runtime intrinsic; everything with
// a body is ordinary Gyro over the allocator a function is handed.
//
// The model is chapter 4.5: an allocator is a procedure and a data
// pointer, an ordinary value, and a function allocates exactly when it is
// handed one as a parameter.
//
// The raw memory underneath is the unsafe module's. The functions here that
// use it are safe fns: each vouches that what it hands out is a block of the
// size and alignment asked for, or null, and that nothing else gets through.

import { shortest } from "float"
import { atomic_load, atomic_store, cast, copy_bytes, env_of, futex_wait, futex_wake, offset, raw_alloc, raw_free, raw_resize, text_bytes, text_seal, text_size, thread_local, with_env } from "unsafe"

// Mode is what an allocator is asked for. The procedure takes
// (data, mode, size, align, old, old_size) and answers a block or null.
export enum Mode {
    Alloc,
    Free,
    FreeAll,
    Resize,
}

export struct Allocator {
    export proc: code(anyptr?, Mode, usize, usize, anyptr?, usize): anyptr?
    export data: anyptr?
}

// size and align answer what C's sizeof and _Alignof would for T.
export fn size<T>(): usize !{}
export fn align<T>(): usize !{}

// panic aborts the process with the message, the way an index out of
// range does.
export fn panic(message: string) !{}

// alloc answers one zero-filled T from a, and panics with the size when a
// cannot supply it.
export safe fn alloc<T>(a: Allocator): *T !{ &a } {
    var block = a.proc(a.data, Mode::Alloc, size<T>(), align<T>(), null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{size<T>()} bytes failed"))
    }
    return cast<T>(block)
}

// A call to panic ends the block for the checker, so `if p == null {
// panic(...) }` narrows p below it, the way a return would.

// free returns a block to the allocator that gave it out.
export fn free<T>(a: Allocator, pointer: *T) !{} {
    a.proc(a.data, Mode::Free, 0, 0, pointer as anyptr, size<T>())
}

// ---------------------------------------------------------------------------
// The heap
// ---------------------------------------------------------------------------

safe fn heap_proc(data: anyptr?, mode: Mode, size: usize, align: usize, old: anyptr?, old_size: usize): anyptr? !{} {
    match mode {
        Mode::Alloc: {
            return raw_alloc(size, align)
        }
        Mode::Free: {
            if old != null {
                raw_free(old)
            }
            return null
        }
        Mode::FreeAll: {
            return null
        }
        Mode::Resize: {
            if old == null {
                return raw_alloc(size, align)
            }
            return raw_resize(old, old_size, size, align)
        }
    }
}

export fn heap(): Allocator !{} {
    return Allocator{ proc: &heap_proc, data: null }
}

// ---------------------------------------------------------------------------
// Arena: one buffer, handed out front to back, released all at once
// ---------------------------------------------------------------------------

export struct Arena {
    parent: Allocator
    base: anyptr
    capacity: usize
    used: usize
}

// new takes the buffer from a, and remembers a so that free can give it
// back to the same allocator. An arena inside an arena is an ordinary
// thing to build. Sixteen is the largest alignment a block of any type
// needs, so every block carved out of the buffer can be aligned within it.
export fn Arena::new(a: Allocator, capacity: usize): Arena !{ &a } {
    var block = a.proc(a.data, Mode::Alloc, capacity, 16, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{capacity} bytes failed"))
    }
    return Arena{ parent: a, base: block, capacity: capacity, used: 0 }
}

// take carves the next block out of the buffer, aligned, zeroed, or
// answers null when the arena is full. It does not grow.
safe fn Arena::take(*self, size: usize, align: usize): anyptr? !{} {
    var start = self.used
    if align > 1 {
        var over = start % align
        if over != 0 {
            start += align - over
        }
    }
    var width = size
    if width == 0 {
        width = 1
    }
    if start + width > self.capacity {
        return null
    }
    var block = offset(self.base, start)
    for i in 0..width {
        var byte = cast<u8>(offset(block, i))
        *byte = 0
    }
    self.used = start + width
    return block
}

safe fn arena_proc(data: anyptr?, mode: Mode, size: usize, align: usize, old: anyptr?, old_size: usize): anyptr? !{} {
    if data == null {
        return null
    }
    var arena = cast<Arena>(data)
    match mode {
        Mode::Alloc: {
            return arena.take(size, align)
        }
        Mode::Free: {
            return null
        }
        Mode::FreeAll: {
            arena.used = 0
            return null
        }
        Mode::Resize: {
            var block = arena.take(size, align)
            if block == null || old == null {
                return block
            }
            var keep = old_size
            if size < keep {
                keep = size
            }
            copy_bytes(block, old, keep)
            return block
        }
    }
}

// allocator is the value to hand to whatever should allocate from the
// arena. It points at the arena, so
// the arena has to stay where it is while the value is in use.
export fn Arena::allocator(*self): Allocator !{ &self } {
    return Allocator{ proc: &arena_proc, data: &self as anyptr }
}

// free_all resets the arena: every block it handed out is gone at once.
export fn Arena::free_all(*self) !{} {
    self.used = 0
}

// free returns the buffer to the allocator new took it from.
export fn Arena::free(*self) !{} {
    self.parent.proc(self.parent.data, Mode::Free, 0, 0, self.base, self.capacity)
}

// Format is what a string literal containing #{} is: its pieces, the
// literal text and the values in the holes, each wrapped as an any. It is
// built in the caller's frame and borrows what it names, which is why
// sema lets it be passed as an argument and nothing else.
//
// The printers take one like any other value and stream it, by calling the
// stream_ functions in stdlib; format below builds it into an allocator.
// It lives here rather than in stdlib because stdlib imports Allocator from
// mem, and format needs both.
export struct Format {
    pieces: any[]
}

export fn Format::len(self): usize !{} {
    return self.pieces.len()
}

// piece is the value a hole held, or a literal segment as a string.
export fn Format::piece(self, index: usize): any !{ &self } {
    return self.pieces[index]
}

// text shows a piece the way println would.
export fn Format::text(self, index: usize): string !{} {
    return show(self.pieces[index])
}

// show renders an any the way println shows it. The compiler supplies it,
// since only lowering knows which types the program ever wrapped.
fn show(piece: any): string !{}

// ---------------------------------------------------------------------------
// Formatting into an allocator
// ---------------------------------------------------------------------------

// text_write copies a string into a block of text_size bytes, at a byte
// offset into the text.
safe fn text_write(block: anyptr, at: usize, text: string) !{} {
    var bytes = text_bytes(text)
    if bytes.len() > 0 {
        copy_bytes(offset(block, text_size(0) + at), &bytes[0] as anyptr, bytes.len())
    }
}

// block_for answers a block holding a string of `to` bytes, grown from one
// of `from` bytes when there is one.
safe fn block_for(a: Allocator, old: anyptr?, from: usize, to: usize): anyptr !{} {
    if old == null {
        var fresh = a.proc(a.data, Mode::Alloc, text_size(to), 8, null, 0)
        if fresh == null {
            panic("format: the allocator is out of memory")
        }
        return fresh
    }
    var grown = a.proc(a.data, Mode::Resize, text_size(to), 8, old, text_size(from))
    if grown == null {
        panic("format: the allocator is out of memory")
    }
    return grown
}

// format shows each piece of a Format the way println would and joins them
// into a string whose bytes come from `a`. The block doubles as the text
// grows, since the length is not known until the last piece is shown.
export safe fn format(a: Allocator, value: Format): string !{ &a } {
    var capacity: usize = 64
    var block = block_for(a, null, 0, capacity)
    var used: usize = 0
    for i in 0..value.len() {
        var text = value.text(i)
        var needed = used + text.len()
        if needed > capacity {
            var wider = capacity * 2
            while wider < needed {
                wider *= 2
            }
            block = block_for(a, block, capacity, wider)
            capacity = wider
        }
        text_write(block, used, text)
        used = needed
    }
    return text_seal(block, used)
}

// ---------------------------------------------------------------------------
// The leaves of rendering, comparing and hashing
//
// Lowering reaches these for the scalar at the bottom of a value: it widens
// the number to the type each takes, so every width shares one body, and
// calls them under the name of the width it started from. Nothing here is
// for a program to call but quote; the rest are plain functions only because
// lowering finds them by name. They live here because mem is loaded
// whenever anything is shown, and they build their text from the heap
// without an Array, which mem cannot import.
// ---------------------------------------------------------------------------

// heap_text is a block from the heap for a string of `len` bytes.
safe fn heap_text(len: usize): anyptr !{} {
    var a = heap()
    var block = a.proc(a.data, Mode::Alloc, text_size(len + 1), 8, null, 0)
    if block == null {
        panic("allocation of a string failed")
    }
    return block
}

safe fn put_byte(block: anyptr, at: usize, byte: u8) !{} {
    *cast<u8>(offset(block, text_size(0) + at)) = byte
}

// digit_count is how many decimal digits n takes.
fn digit_count(n: u64): usize !{} {
    var count: usize = 1
    var rest = n
    while rest >= 10 {
        rest /= 10
        count += 1
    }
    return count
}

// put_digits writes n in decimal ending just before `end`.
safe fn put_digits(block: anyptr, end: usize, n: u64) !{} {
    var at = end
    var rest = n
    while rest > 0 || at == end {
        at -= 1
        put_byte(block, at, 48 + (rest % 10) as u8)
        rest /= 10
    }
}

safe fn str_uint(v: u64): string !{} {
    var count = digit_count(v)
    var block = heap_text(count)
    put_digits(block, count, v)
    return text_seal(block, count)
}

// str_int writes the magnitude of a negative number as one less than it
// is, plus one, so that the most negative value has a magnitude to write.
safe fn str_int(v: i64): string !{} {
    if v >= 0 {
        return str_uint(v as u64)
    }
    var magnitude = ((0 - (v + 1)) as u64) + 1
    var count = digit_count(magnitude)
    var block = heap_text(count + 1)
    put_byte(block, 0, 45)
    put_digits(block, count + 1, magnitude)
    return text_seal(block, count + 1)
}

fn str_bool(v: bool): string !{} {
    if v {
        return "true"
    }
    return "false"
}

// str_rune encodes the code point as UTF-8; a surrogate or a value past
// U+10FFFF is U+FFFD.
safe fn str_rune(v: rune): string !{} {
    var point = v as u32
    if point > 1114111 || (point >= 55296 && point <= 57343) {
        point = 65533
    }
    var count: usize = 4
    if point < 128 {
        count = 1
    } elif point < 2048 {
        count = 2
    } elif point < 65536 {
        count = 3
    }
    var block = heap_text(count)
    if count == 1 {
        put_byte(block, 0, point as u8)
    } elif count == 2 {
        put_byte(block, 0, (192 | (point >> 6)) as u8)
        put_byte(block, 1, (128 | (point & 63)) as u8)
    } elif count == 3 {
        put_byte(block, 0, (224 | (point >> 12)) as u8)
        put_byte(block, 1, (128 | ((point >> 6) & 63)) as u8)
        put_byte(block, 2, (128 | (point & 63)) as u8)
    } else {
        put_byte(block, 0, (240 | (point >> 18)) as u8)
        put_byte(block, 1, (128 | ((point >> 12) & 63)) as u8)
        put_byte(block, 2, (128 | ((point >> 6) & 63)) as u8)
        put_byte(block, 3, (128 | (point & 63)) as u8)
    }
    return text_seal(block, count)
}

fn str_float(v: f64): string !{} {
    return shortest(v)
}

// hex_digit is the lowercase digit for a value below sixteen.
fn hex_digit(value: u8): u8 {
    if value < 10 {
        return 48 + value
    }
    return 87 + value
}

// quoted_width is how many bytes a byte takes once quoted: two for an
// escape with a letter, four for \xNN, one for itself.
fn quoted_width(byte: u8): usize {
    if byte == 34 || byte == 92 || byte == 10 || byte == 13 || byte == 9 {
        return 2
    }
    if byte < 32 || byte == 127 {
        return 4
    }
    return 1
}

// quote is the text between double quotes, the way `println` shows a
// string inside a composite: a quote, a backslash, a newline, a return and
// a tab are escaped with a backslash, any other control byte is \xNN, and
// everything else, UTF-8 included, passes through. The block comes from a.
export safe fn quote(a: Allocator, text: string): string !{ &a } {
    var bytes = text_bytes(text)
    var width: usize = 2
    for byte in bytes {
        width += quoted_width(byte)
    }
    var block = a.proc(a.data, Mode::Alloc, text_size(width + 1), 8, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{width} bytes failed"))
    }
    var at: usize = 0
    put_byte(block, at, 34)
    at += 1
    for byte in bytes {
        var kind = quoted_width(byte)
        if kind == 1 {
            put_byte(block, at, byte)
        } else {
            put_byte(block, at, 92)
            if kind == 4 {
                put_byte(block, at + 1, 120)
                put_byte(block, at + 2, hex_digit(byte >> 4))
                put_byte(block, at + 3, hex_digit(byte & 15))
            } elif byte == 10 {
                put_byte(block, at + 1, 110)
            } elif byte == 13 {
                put_byte(block, at + 1, 114)
            } elif byte == 9 {
                put_byte(block, at + 1, 116)
            } else {
                put_byte(block, at + 1, byte)
            }
        }
        at += kind
    }
    put_byte(block, at, 34)
    return text_seal(block, width)
}

// str_str is a string shown inside a composite, which quotes it.
fn str_str(v: string): string !{} {
    return quote(heap(), v)
}

// compare_text orders strings bytewise: the shorter loses when it is a
// prefix of the longer one.
safe fn compare_text(a: string, b: string): i32 !{} {
    var left = text_bytes(a)
    var right = text_bytes(b)
    var shared = left.len()
    if right.len() < shared {
        shared = right.len()
    }
    for var i: usize = 0; i < shared; i += 1 {
        if left[i] < right[i] {
            return -1
        }
        if left[i] > right[i] {
            return 1
        }
    }
    if left.len() < right.len() {
        return -1
    }
    if left.len() > right.len() {
        return 1
    }
    return 0
}

// hash_word is the splitmix64 finalizer: an avalanche over one word, so
// small integers do not land in neighbouring buckets.
fn hash_word(x: u64): u64 !{} {
    var h = x
    h = h ^ (h >> 30)
    h = h *% 0xbf58476d1ce4e5b9
    h = h ^ (h >> 27)
    h = h *% 0x94d049bb133111eb
    h = h ^ (h >> 31)
    return h
}

// hash_float hashes the bits of the number, with the two zeros folded
// together because they are equal.
safe fn hash_float(v: f64): u64 !{} {
    var held = v
    if held == 0.0 {
        held = 0.0
    }
    return hash_word(*cast<u64>(&held as anyptr))
}

// hash_text is FNV-1a over the bytes.
safe fn hash_text(v: string): u64 !{} {
    var h: u64 = 0xcbf29ce484222325
    for byte in text_bytes(v) {
        h = (h ^ (byte as u64)) *% 0x100000001b3
    }
    return h
}

// ---------------------------------------------------------------------------
// Closures that outlive their frame
// ---------------------------------------------------------------------------

// A closure's environment is a record in the frame that wrote it, and its
// first word is the record's size in bytes; env_of and with_env, from
// unsafe, read and replace it.

// keep copies a closure's environment out of the frame into a, for a
// closure that has to live longer than the function that wrote it. A closure
// with no environment is returned as it is, and nothing is allocated.
export safe fn keep<F>(a: Allocator, f: F): F !{ &a } {
    var env = env_of(f)
    if env == null {
        // Rebuilt rather than returned as it is: returning the parameter
        // would read, to the borrow analysis, as a view of it.
        return with_env(f, null)
    }
    var size = *cast<usize>(env)
    var block = a.proc(a.data, Mode::Alloc, size, 8, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{size} bytes failed"))
    }
    copy_bytes(block, env, size)
    return with_env(f, block)
}

// release gives back the environment keep copied into a. It takes only a
// closure keep returned, and the allocator it was kept in.
export safe fn release<F>(a: Allocator, f: F) !{} {
    var env = env_of(f)
    if env == null {
        return
    }
    a.proc(a.data, Mode::Free, 0, 0, env, *cast<usize>(env))
}

// ---------------------------------------------------------------------------
// Threads
// ---------------------------------------------------------------------------

// start_thread runs entry(data) on a new thread, which ends when entry
// returns. It is the METALS thread.start, and entry has to be a declared
// function, written `&name`. The runtime owns the thread; what data points
// at is the caller's to keep alive until entry is done with it.
fn start_thread(entry: code(anyptr), data: anyptr) !{ io }

// end_thread ends the calling thread: thread.exit.
fn end_thread() !{ io }

// set_abort_hook tells the C runtime what to call after it has printed a
// panic. The hook returns when the panic is the program's to end, and does
// not return when it ended a thread instead.
fn set_abort_hook(hook: code()) !{ io }

// What is true of a thread and not of the program.
struct ThreadState {
    // worker is set on a thread spawn or an async call started. A panic on
    // one ends that thread and not the process.
    worker: bool
    // future is the future an async call started this thread to fulfil.
    future: anyptr?
}

safe fn thread_state(): *ThreadState !{} {
    return thread_local<ThreadState>()
}

// abort_hook is what a panic does on a worker: it fulfils the future the
// thread was computing, so whoever awaits it is not left waiting, and ends
// the thread. On the main thread it does nothing, and the process ends.
safe fn abort_hook() !{ io } {
    var state = thread_state()
    if !state.worker {
        return
    }
    var fut = state.future
    if fut != null {
        state.future = null
        future_complete(fut)
    }
    end_thread()
}

struct Job {
    a: Allocator
    body: fn()
}

safe fn run(data: anyptr) !{ io } {
    thread_state().worker = true
    var job = cast<Job>(data)
    var body = job.body
    body()
    release(job.a, body)
    free(job.a, job)
}

// spawn starts a thread. The closure carries the arguments across; join by
// receiving on a channel the closure captures. The thread outlives the
// function that started it, so the closure is kept in a first and the thread
// releases it when it is done. The row covers starting the thread and stands
// in for the task's own effects, which no row can carry until effect
// polymorphism reaches function values.
export fn spawn(a: Allocator, body: fn()) !{ io } {
    set_abort_hook(&abort_hook)
    var job = alloc<Job>(a)
    job.a = a
    job.body = keep(a, body)
    start_thread(&run, job as anyptr)
}

// ---------------------------------------------------------------------------
// Futures
// ---------------------------------------------------------------------------

// An async call starts a thread and hands back a future, which lowering
// builds out of the functions below: future_new makes the cell, the thread
// runs future_enter, stores its result where future_result says and ends
// with future_leave, and await is future_wait. The result is raw bytes of a
// size lowering knows, copied out when the future is awaited.
struct Future {
    // done is a futex word: 0 until the result is there, then 1.
    done: u32
    size: usize
    result: anyptr?
}

safe fn future_new(bytes: usize): anyptr !{ io } {
    set_abort_hook(&abort_hook)
    // Nothing frees a future, as nothing frees a mutex: the cell is raw
    // memory so that the leak analysis does not take it for a mistake.
    var block = raw_alloc(size<Future>(), 16)
    if block == null {
        panic("allocation of a future failed")
    }
    var fut = cast<Future>(block)
    fut.size = bytes
    if bytes > 0 {
        var cell = raw_alloc(bytes, 16)
        if cell == null {
            panic(format(heap(), "allocation of #{bytes} bytes failed"))
        }
        fut.result = cell
    }
    return block
}

// future_enter marks the calling thread as the one computing fut.
safe fn future_enter(fut: anyptr) !{} {
    var state = thread_state()
    state.worker = true
    state.future = fut
}

safe fn future_result(fut: anyptr): anyptr !{} {
    var result = cast<Future>(fut).result
    if result == null {
        panic("an async call without a result has none to store")
        return fut
    }
    return result
}

// future_complete wakes everyone waiting for fut.
safe fn future_complete(fut: anyptr) !{} {
    var cell = cast<Future>(fut)
    atomic_store(&cell.done, 1)
    futex_wake(&cell.done, 2147483647)
}

// future_leave is the end of the thread's work on fut.
safe fn future_leave(fut: anyptr) !{} {
    thread_state().future = null
    future_complete(fut)
}

// future_wait waits for fut and copies its result into out, which is null
// for an async call that has none.
safe fn future_wait(fut: anyptr, out: anyptr?) !{} {
    var cell = cast<Future>(fut)
    while atomic_load(&cell.done) == 0 {
        futex_wait(&cell.done, 0)
    }
    var result = cell.result
    var dest = out
    if result != null && dest != null {
        copy_bytes(dest, result, cell.size)
    }
}
