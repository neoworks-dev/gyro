// mem. A declaration with no body is a runtime intrinsic; everything with
// a body is ordinary Gyro over the allocator a function is handed.
//
// The model is chapter 4.5: an allocator is a procedure and a data
// pointer, an ordinary value, and a function allocates exactly when it is
// handed one as a parameter.
//
// The raw memory underneath is the unsafe module's. The functions here that
// use it are safe fns: each vouches that what it hands out is a block of the
// size and alignment asked for, or null, and that nothing else gets through.

import { cast, copy_bytes, env_of, offset, raw_alloc, raw_free, raw_resize, with_env } from "unsafe"

// Mode is what an allocator is asked for. The procedure takes
// (data, mode, size, align, old, old_size) and answers a block or null.
export enum Mode {
    Alloc,
    Free,
    FreeAll,
    Resize,
}

export struct Allocator {
    export proc: code(anyptr?, Mode, usize, usize, anyptr?, usize): anyptr?
    export data: anyptr?
}

// size and align answer what C's sizeof and _Alignof would for T.
export fn size<T>(): usize !{}
export fn align<T>(): usize !{}

// panic aborts the process with the message, the way an index out of
// range does.
export fn panic(message: string) !{}

// alloc answers one zero-filled T from a, and panics with the size when a
// cannot supply it.
export safe fn alloc<T>(a: Allocator): *T !{ &a } {
    var block = a.proc(a.data, Mode::Alloc, size<T>(), align<T>(), null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{size<T>()} bytes failed"))
    }
    return cast<T>(block)
}

// A call to panic ends the block for the checker, so `if p == null {
// panic(...) }` narrows p below it, the way a return would.

// free returns a block to the allocator that gave it out.
export fn free<T>(a: Allocator, pointer: *T) !{} {
    a.proc(a.data, Mode::Free, 0, 0, pointer as anyptr, size<T>())
}

// ---------------------------------------------------------------------------
// The heap
// ---------------------------------------------------------------------------

safe fn heap_proc(data: anyptr?, mode: Mode, size: usize, align: usize, old: anyptr?, old_size: usize): anyptr? !{} {
    match mode {
        Mode::Alloc: {
            return raw_alloc(size, align)
        }
        Mode::Free: {
            if old != null {
                raw_free(old)
            }
            return null
        }
        Mode::FreeAll: {
            return null
        }
        Mode::Resize: {
            if old == null {
                return raw_alloc(size, align)
            }
            return raw_resize(old, old_size, size, align)
        }
    }
}

export fn heap(): Allocator !{} {
    return Allocator{ proc: &heap_proc, data: null }
}

// ---------------------------------------------------------------------------
// Arena: one buffer, handed out front to back, released all at once
// ---------------------------------------------------------------------------

export struct Arena {
    parent: Allocator
    base: anyptr
    capacity: usize
    used: usize
}

// new takes the buffer from a, and remembers a so that free can give it
// back to the same allocator. An arena inside an arena is an ordinary
// thing to build. Sixteen is the largest alignment a block of any type
// needs, so every block carved out of the buffer can be aligned within it.
export fn Arena::new(a: Allocator, capacity: usize): Arena !{ &a } {
    var block = a.proc(a.data, Mode::Alloc, capacity, 16, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{capacity} bytes failed"))
    }
    return Arena{ parent: a, base: block, capacity: capacity, used: 0 }
}

// take carves the next block out of the buffer, aligned, zeroed, or
// answers null when the arena is full. It does not grow.
safe fn Arena::take(*self, size: usize, align: usize): anyptr? !{} {
    var start = self.used
    if align > 1 {
        var over = start % align
        if over != 0 {
            start += align - over
        }
    }
    var width = size
    if width == 0 {
        width = 1
    }
    if start + width > self.capacity {
        return null
    }
    var block = offset(self.base, start)
    for i in 0..width {
        var byte = cast<u8>(offset(block, i))
        *byte = 0
    }
    self.used = start + width
    return block
}

safe fn arena_proc(data: anyptr?, mode: Mode, size: usize, align: usize, old: anyptr?, old_size: usize): anyptr? !{} {
    if data == null {
        return null
    }
    var arena = cast<Arena>(data)
    match mode {
        Mode::Alloc: {
            return arena.take(size, align)
        }
        Mode::Free: {
            return null
        }
        Mode::FreeAll: {
            arena.used = 0
            return null
        }
        Mode::Resize: {
            var block = arena.take(size, align)
            if block == null || old == null {
                return block
            }
            var keep = old_size
            if size < keep {
                keep = size
            }
            copy_bytes(block, old, keep)
            return block
        }
    }
}

// allocator is the value to hand to whatever should allocate from the
// arena. It points at the arena, so
// the arena has to stay where it is while the value is in use.
export fn Arena::allocator(*self): Allocator !{ &self } {
    return Allocator{ proc: &arena_proc, data: &self as anyptr }
}

// free_all resets the arena: every block it handed out is gone at once.
export fn Arena::free_all(*self) !{} {
    self.used = 0
}

// free returns the buffer to the allocator new took it from.
export fn Arena::free(*self) !{} {
    self.parent.proc(self.parent.data, Mode::Free, 0, 0, self.base, self.capacity)
}

// Format is what a string literal containing #{} is: its pieces, the
// literal text and the values in the holes, each wrapped as an any. It is
// built in the caller's frame and borrows what it names, which is why
// sema lets it be passed as an argument and nothing else.
//
// The printers take one like any other value and stream it, by calling the
// stream_ functions in stdlib; format below builds it into an allocator.
// It lives here rather than in stdlib because stdlib imports Allocator from
// mem, and format needs both.
export struct Format {
    pieces: any[]
}

export fn Format::len(self): usize !{} {
    return self.pieces.len()
}

// piece is the value a hole held, or a literal segment as a string.
export fn Format::piece(self, index: usize): any !{ &self } {
    return self.pieces[index]
}

// text shows a piece the way println would.
export fn Format::text(self, index: usize): string !{} {
    return show(self.pieces[index])
}

// show renders an any the way println shows it. The compiler supplies it,
// since only lowering knows which types the program ever wrapped.
fn show(piece: any): string !{}

// ---------------------------------------------------------------------------
// Formatting into an allocator
// ---------------------------------------------------------------------------

// A string is a header followed by its bytes in one block, and the runtime
// owns that layout: text_size says how big the block for a given length is,
// text_write copies a string in at a byte offset, and text_seal stamps the
// length on and answers the block as a string.
fn text_size(len: usize): usize !{}
fn text_write(block: anyptr, at: usize, text: string) !{}
fn text_seal(block: anyptr, len: usize): string !{}

// block_for answers a block holding a string of `to` bytes, grown from one
// of `from` bytes when there is one.
fn block_for(a: Allocator, old: anyptr?, from: usize, to: usize): anyptr !{} {
    if old == null {
        var fresh = a.proc(a.data, Mode::Alloc, text_size(to), 8, null, 0)
        if fresh == null {
            panic("format: the allocator is out of memory")
        }
        return fresh
    }
    var grown = a.proc(a.data, Mode::Resize, text_size(to), 8, old, text_size(from))
    if grown == null {
        panic("format: the allocator is out of memory")
    }
    return grown
}

// format shows each piece of a Format the way println would and joins them
// into a string whose bytes come from `a`. The block doubles as the text
// grows, since the length is not known until the last piece is shown.
export fn format(a: Allocator, value: Format): string !{ &a } {
    var capacity: usize = 64
    var block = block_for(a, null, 0, capacity)
    var used: usize = 0
    for i in 0..value.len() {
        var text = value.text(i)
        var needed = used + text.len()
        if needed > capacity {
            var wider = capacity * 2
            while wider < needed {
                wider *= 2
            }
            block = block_for(a, block, capacity, wider)
            capacity = wider
        }
        text_write(block, used, text)
        used = needed
    }
    return text_seal(block, used)
}

// ---------------------------------------------------------------------------
// Closures that outlive their frame
// ---------------------------------------------------------------------------

// A closure's environment is a record in the frame that wrote it, and its
// first word is the record's size in bytes; env_of and with_env, from
// unsafe, read and replace it.

// keep copies a closure's environment out of the frame into a, for a
// closure that has to live longer than the function that wrote it. A closure
// with no environment is returned as it is, and nothing is allocated.
export safe fn keep<F>(a: Allocator, f: F): F !{ &a } {
    var env = env_of(f)
    if env == null {
        // Rebuilt rather than returned as it is: returning the parameter
        // would read, to the borrow analysis, as a view of it.
        return with_env(f, null)
    }
    var size = *cast<usize>(env)
    var block = a.proc(a.data, Mode::Alloc, size, 8, null, 0)
    if block == null {
        panic(format(heap(), "allocation of #{size} bytes failed"))
    }
    copy_bytes(block, env, size)
    return with_env(f, block)
}

// release gives back the environment keep copied into a. It takes only a
// closure keep returned, and the allocator it was kept in.
export safe fn release<F>(a: Allocator, f: F) !{} {
    var env = env_of(f)
    if env == null {
        return
    }
    a.proc(a.data, Mode::Free, 0, 0, env, *cast<usize>(env))
}

// ---------------------------------------------------------------------------
// Threads
// ---------------------------------------------------------------------------

// start_thread runs entry(data) on a new thread. The runtime owns the thread; what
// data points at is the caller's to keep alive until entry is done with it.
fn start_thread(entry: code(anyptr?), data: anyptr?) !{ io }

struct Job {
    a: Allocator
    body: fn()
}

safe fn run(data: anyptr?) !{ io } {
    if data == null {
        return
    }
    var job = cast<Job>(data)
    var body = job.body
    body()
    release(job.a, body)
    free(job.a, job)
}

// spawn starts a thread. The closure carries the arguments across; join by
// receiving on a channel the closure captures. The thread outlives the
// function that started it, so the closure is kept in a first and the thread
// releases it when it is done. The row covers starting the thread and stands
// in for the task's own effects, which no row can carry until effect
// polymorphism reaches function values.
export fn spawn(a: Allocator, body: fn()) !{ io } {
    var job = alloc<Job>(a)
    job.a = a
    job.body = keep(a, body)
    start_thread(&run, job as anyptr)
}
