// fmt — printf-style formatting over a heterogeneous pack.
//
// Everything here is ordinary Gyro: `args: ...any` is a slice, so the
// format string is walked at runtime and the next argument is taken by
// index, exactly the way C's printf reads its own arguments. What each
// verb may print comes from `match`, which is the only way to get a
// concrete type back out of an `any`.

import { Array, from_utf8, bytes, print, eprintln } from "stdlib"
import { Allocator, heap, format } from "mem"

// The verbs:
//
//	%v  the value's own representation, whatever it holds
//	%s  text — a string, or any other value's representation
//	%d  a signed or unsigned integer, in decimal
//	%x  an integer in lowercase hex, %X in uppercase
//	%c  an integer as a code point, or a rune
//	%b  a bool
//	%%  a literal percent
//
// Between the % and the verb: an optional `-` to left-align, an optional
// `0` to pad with zeros instead of spaces, and an optional decimal width.
// `%-4d`, `%02x` and `%8s` all mean what they do in C.
//
// The text is built in blocks from `a`, and the result is a block from it.
export fn sprintf(a: Allocator, format: string, args: ...any): string !{ &a } {
  var out = Array<u8>::new(a)
  var body = format.bytes(a)
  var next: usize = 0

  var i: usize = 0
  while i < body.len() {
    if body[i] != percent {
      out.push(body[i])
      i += 1
      continue
    }

    var spec, after = read_spec(body, i + 1)
    i = after
    if spec.verb == percent {
      out.push(percent)
      continue
    }
    if next >= args.len() {
      push_text(a, out, "%!(MISSING)")
      continue
    }
    push_text(a, out, pad(a, render(a, args[next], spec.verb), spec))
    next += 1
  }

  var text = from_utf8(a, out.slice())
  out.free()
  return text
}

export fn printf(format: string, args: ...any) !{ io } {
  print(sprintf(heap(), format, args...))
}

export fn eprintf(format: string, args: ...any) !{ io } {
  eprintln(sprintf(heap(), format, args...))
}

// The byte values the format language spells out, named once so the
// parsing below reads as what it is.
const percent: u8 = 37
const minus: u8 = 45
const zero_digit: u8 = 48
const nine_digit: u8 = 57
const space: u8 = 32

fn push_text(a: Allocator, out: Array<u8>, text: string) !{} {
  for byte in text.bytes(a) {
    out.push(byte)
  }
}

// ---------------------------------------------------------------------------
// The specification between % and the verb
// ---------------------------------------------------------------------------

struct Spec {
  verb: u8
  width: usize
  zero: bool
  left: bool
}

// read_spec parses the flags and width, returning the spec and the offset
// just past the verb. An unterminated spec ends as a `%` verb, which
// prints itself.
fn read_spec(body: u8[], from: usize): (Spec, usize) {
  var spec = Spec{ verb: percent, width: 0, zero: false, left: false }
  var i = from

  while i < body.len() && (body[i] == minus || body[i] == zero_digit) {
    if body[i] == minus {
      spec.left = true
    } else {
      spec.zero = true
    }
    i += 1
  }
  while i < body.len() && body[i] >= zero_digit && body[i] <= nine_digit {
    spec.width = spec.width * 10 + ((body[i] - zero_digit) as usize)
    i += 1
  }

  if i >= body.len() {
    return (spec, i)
  }
  spec.verb = body[i]
  return (spec, i + 1)
}

// pad widens a rendered value to the spec's width. It returns its
// argument unchanged when nothing has to be added, which is why the row
// says the result may view it.
fn pad(a: Allocator, text: string, spec: Spec): string !{ &text } {
  var width = text.len()
  if width >= spec.width {
    return text
  }

  var filler = zero_digit
  if !spec.zero || spec.left {
    filler = space
  }

  var out = Array<u8>::new(a)
  if spec.left {
    push_text(a, out, text)
  }
  for i in 0..((spec.width - width) as i32) {
    out.push(filler)
  }
  if !spec.left {
    push_text(a, out, text)
  }

  var result = from_utf8(a, out.slice())
  out.free()
  return result
}

// ---------------------------------------------------------------------------
// Rendering one argument
// ---------------------------------------------------------------------------

// render prints one value under one verb. A verb that does not fit what
// the any holds falls back to the value's own representation rather than
// panicking: a format string is data, and a mismatch in it should not
// take the program down.
fn render(a: Allocator, value: any, verb: u8): string !{} {
  if verb == 120 || verb == 88 {
    var n, ok = as_unsigned(value)
    if ok {
      return hex(a, n, verb == 88)
    }
    return format(heap(), "#{value}")
  }
  if verb == 99 {
    var n, ok = as_unsigned(value)
    if ok {
      return format(heap(), "#{(n as u32) as rune}")
    }
    return format(heap(), "#{value}")
  }
  return format(heap(), "#{value}")
}

// as_unsigned reads an integer of any width out of an any, as the bit
// pattern hex and code-point formatting both want. A negative value comes
// back in two's complement, masked to its own width — so `%x` of an i32
// -1 is ffffffff, the way C prints it, not the 64-bit form.
fn as_unsigned(value: any): (u64, bool) {
  return match value {
    u8(n): (n as u64, true)
    u16(n): (n as u64, true)
    u32(n): (n as u64, true)
    u64(n): (n, true)
    usize(n): (n as u64, true)
    i8(n): (widen(n as i64) & 255, true)
    i16(n): (widen(n as i64) & 65535, true)
    i32(n): (widen(n as i64) & 4294967295, true)
    i64(n): (widen(n), true)
    rune(n): ((n as u32) as u64, true)
    _: (0, false)
  }
}

// widen reinterprets a signed value as its two's-complement bits. `as`
// panics on a negative-to-unsigned conversion, so the sign is folded in
// by arithmetic instead.
fn widen(value: i64): u64 {
  if value >= 0 {
    return value as u64
  }
  return 18446744073709551615 - ((-(value + 1)) as u64)
}

fn hex(a: Allocator, value: u64, upper: bool): string !{} {
  if value == 0 {
    return "0"
  }

  // The digits come out least significant first, so they are collected
  // and then walked backwards.
  var digits = Array<u8>::new(a)
  var n = value
  while n > 0 {
    digits.push(hex_digit((n & 15) as u8, upper))
    n = n >> 4
  }

  var out = Array<u8>::new(a)
  for var i = digits.len(); i > 0; i -= 1 {
    out.push(digits.get(i - 1))
  }
  digits.free()

  var text = from_utf8(a, out.slice())
  out.free()
  return text
}

fn hex_digit(value: u8, upper: bool): u8 {
  if value < 10 {
    return zero_digit + value
  }
  if upper {
    return 55 + value
  }
  return 87 + value
}
