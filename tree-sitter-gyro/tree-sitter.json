{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gyro",
      "camelcase": "Gyro",
      "title": "Gyro",
      "scope": "source.gyro",
      "path": ".",
      "file-types": [
        "gyro"
      ],
      "injection-regex": "^gyro$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Gyro grammar for tree-sitter",
    "authors": [
      {
        "name": "Moritz Utcke"
      }
    ],
    "links": {
      "repository": "https://github.com/gyro-lang/gyro"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
